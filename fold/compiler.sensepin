fn fresh(fnames: bytes, arity: bytes, sname: map bytes i64, sfld: map bytes i64, nstruct: i64, rets: bytes) -> prog
  let slots: map bytes i64 = map()
  let blocks: list block = list()
  let bmap = note_bytes("", 0, "\n")
  return spawn("", "", 0, badd(bnew(), "\n"), "", bnew(), bnew(), "", bmap, "", fnames, arity, slots, "", 0, 0, 0, 0, 0, 0, 0, 0, bnew(), blocks, "", bnew(), sname, sfld, nstruct, "", 0, rets)
end

fn enter_fn(p: prog, name: bytes, slots: map bytes i64) -> prog
  let nparams = seek_named(p.cold.arity, name)
  if nparams < 0
    fail "missing fn"
  end
  let is_main = eqb(name, "main")
  let unwind = "u" ++ p.cold.seen
  let blocks: list block = list()
  return spawn(p.cold.code, p.cold.pool, p.cold.nconst, p.cold.strs, p.cold.funcs, p.jumps, p.cold.marks, p.cold.imap, p.cold.bmap, p.cold.smap, p.cold.fnames, p.cold.arity, slots, unwind, p.cold.main_off, p.cold.main_slots, p.cold.saw_main, 1, p.count, nparams, is_main, p.cold.seen, as_buf(p), blocks, unwind, p.cold.pbuf, p.cold.sname, p.cold.sfld, p.cold.nstruct, p.cold.building, p.cold.nfield, p.cold.rets)
end

fn close_fn(p: prog) -> prog
  if len(p.cold.blocks) != 0
    fail "unclosed block"
  end
  let cur = p
  if p.cold.is_main != 0
    set cur = take_code(cur, byte(0))
  end
  let marks = note(cur.cold.marks, cur.count, cur.cold.unwind)
  set cur = take_code(cur, byte(29))
  if cur.cold.is_main != 0
    set cur = take_code(cur, byte(2))
  end
  if cur.cold.is_main == 0
    set cur = take_code(cur, byte(32))
  end
  let nlocals = len(cur.cold.slots)
  let funcs = cur.cold.funcs ++ q8(cur.cold.start) ++ q8(cur.cold.nparams) ++ q8(nlocals)
  let main_off = cur.cold.main_off
  let main_slots = cur.cold.main_slots
  let saw = cur.cold.saw_main
  if cur.cold.is_main != 0
    set main_off = cur.cold.start
    set main_slots = nlocals
    set saw = 1
  end
  return spawn(p.cold.code, p.cold.pool, p.cold.nconst, p.cold.strs, funcs, p.jumps, marks, p.cold.imap, p.cold.bmap, p.cold.smap, p.cold.fnames, p.cold.arity, p.cold.slots, p.cold.unwind, main_off, main_slots, saw, 0, p.cold.start, p.cold.nparams, p.cold.is_main, cur.cold.seen + 1 else fail "math", as_buf(cur), cur.cold.blocks, cur.cold.failto, cur.cold.pbuf, cur.cold.sname, cur.cold.sfld, cur.cold.nstruct, cur.cold.building, cur.cold.nfield, cur.cold.rets)
end

fn as_buf(p: prog) -> buf
  return buf(p.cold.parts, p.part, p.fills, p.count)
end

fn cold_parts(h: cold, parts: list bytes) -> cold
  return cold(h.code, h.pool, h.nconst, h.strs, h.funcs, h.marks, h.imap, h.bmap, h.smap, h.fnames, h.arity, h.slots, h.unwind, h.main_off, h.main_slots, h.saw_main, h.live, h.start, h.nparams, h.is_main, h.seen, parts, h.blocks, h.failto, h.pbuf, h.sname, h.sfld, h.nstruct, h.building, h.nfield, h.rets)
end

fn tack(p: prog, jumps: buf, extra: bytes) -> prog
  if len(extra) == 0
    return prog(p.part, p.fills, p.count, jumps, p.cold)
  end
  let part = p.part ++ extra
  let fills = p.fills + 1 else fail "math"
  let count = p.count + len(extra) else fail "math"
  if fills >= 64
    let parts = push(p.cold.parts, part)
    let held = cold_parts(p.cold, parts)
    return prog("", 0, count, jumps, held)
  end
  return prog(part, fills, count, jumps, p.cold)
end

fn take_code(p: prog, extra: bytes) -> prog
  if len(extra) == 0
    return p
  end
  return tack(p, p.jumps, extra)
end

fn finish_code(p: prog) -> prog
  return with_code(p, bfinish(as_buf(p)))
end

fn emit_iffail(p: prog) -> prog
  let slot = p.count + 1 else fail "math"
  let jumps = note(p.jumps, slot, p.cold.failto)
  return tack(p, jumps, byte(11) ++ byte(0) ++ byte(0) ++ byte(0) ++ byte(0))
end

fn emit_pop_slot(p: prog, slot: i64) -> prog
  return take_code(p, byte(6) ++ u16(slot))
end

fn emit_push_slot(p: prog, slot: i64) -> prog
  return take_code(p, byte(7) ++ u16(slot))
end

fn intern_i64(p: prog, n: i64) -> prog
  if seek_i64(p.cold.imap, n) >= 0
    return p
  end
  let rec = pool_rec(0, n, 0, 0)
  let pbuf = bpush(p.cold.pbuf, rec)
  let imap = p.cold.imap ++ q8(n) ++ q8(p.cold.nconst)
  return with_pool_i(p, pbuf, p.cold.nconst + 1 else fail "math", imap)
end

fn push_i64(p: prog, n: i64) -> prog
  let q = intern_i64(p, n)
  let idx = seek_i64(q.cold.imap, n)
  if idx < 0
    fail "const"
  end
  return take_code(q, byte(5) ++ u16(idx))
end

fn intern_bytes(p: prog, data: bytes) -> prog
  if seek_named(p.cold.smap, data) >= 0
    return p
  end
  let off = seek_named(p.cold.bmap, data)
  let strs = p.cold.strs
  let bmap = p.cold.bmap
  if off < 0
    set off = p.cold.strs.count
    set strs = badd(p.cold.strs, data)
    set bmap = note_bytes(p.cold.bmap, off, data)
  end
  let rec = pool_rec(257, off, len(data), 0)
  let pbuf = bpush(p.cold.pbuf, rec)
  let smap = note_bytes(p.cold.smap, p.cold.nconst, data)
  return with_pool_b(p, pbuf, p.cold.nconst + 1 else fail "math", strs, bmap, smap)
end

fn push_bytes(p: prog, data: bytes) -> prog
  let q = intern_bytes(p, data)
  let idx = seek_named(q.cold.smap, data)
  if idx < 0
    fail "const"
  end
  return take_code(q, byte(5) ++ u16(idx))
end

fn slot_index(raw: i64) -> i64
  if raw >= 1024
    let kind = raw / 1024 else fail "math"
    return raw - kind * 1024 else fail "math"
  end
  return raw
end

fn slot_kind(raw: i64) -> i64
  if raw >= 1024
    return raw / 1024 else fail "math"
  end
  return 1
end

fn pack_slot(index: i64, kind: i64) -> i64
  let scaled = kind * 1024 else fail "math"
  return index + scaled else fail "math"
end

fn push_local(p: prog, name: bytes) -> prog
  if has(p.cold.slots, name) == 0
    fail "unknown name"
  end
  let raw = get(p.cold.slots, name) else fail "unknown name"
  let slot = slot_index(raw)
  return take_code(p, byte(7) ++ u16(slot))
end

fn do_dec(cur: parsed) -> parsed
  return parsed(take_code(cur.prog, byte(34)), cur.pos, 2)
end

fn emit_add(p: prog) -> prog
  return emit_iffail(take_code(p, byte(13)))
end

fn emit_cat(p: prog) -> prog
  return take_code(p, byte(19))
end

fn id_text(n: i64) -> bytes
  if n == 0
    return "0"
  end
  let out = ""
  let v = n
  while v > 0
    let q = v / 10 else fail "math"
    let r = v - q * 10 else fail "math"
    set out = byte(48 + r else fail "math") ++ out
    set v = q
  end
  return out
end

fn with_row(p: prog, sname: map bytes i64, sfld: map bytes i64, nstruct: i64, building: bytes, nfield: i64, live: i64) -> prog
  return spawn(p.cold.code, p.cold.pool, p.cold.nconst, p.cold.strs, p.cold.funcs, p.jumps, p.cold.marks, p.cold.imap, p.cold.bmap, p.cold.smap, p.cold.fnames, p.cold.arity, p.cold.slots, p.cold.unwind, p.cold.main_off, p.cold.main_slots, p.cold.saw_main, live, p.cold.start, p.cold.nparams, p.cold.is_main, p.cold.seen, as_buf(p), p.cold.blocks, p.cold.failto, p.cold.pbuf, sname, sfld, nstruct, building, nfield, p.cold.rets)
end

fn with_fns(p: prog, fnames: bytes, arity: bytes, rets: bytes) -> prog
  return spawn(p.cold.code, p.cold.pool, p.cold.nconst, p.cold.strs, p.cold.funcs, p.jumps, p.cold.marks, p.cold.imap, p.cold.bmap, p.cold.smap, fnames, arity, p.cold.slots, p.cold.unwind, p.cold.main_off, p.cold.main_slots, p.cold.saw_main, p.cold.live, p.cold.start, p.cold.nparams, p.cold.is_main, p.cold.seen, as_buf(p), p.cold.blocks, p.cold.failto, p.cold.pbuf, p.cold.sname, p.cold.sfld, p.cold.nstruct, p.cold.building, p.cold.nfield, rets)
end

fn read_type(p: prog, toks: toks, pos: i64) -> parsed
  if pos >= toks.count
    fail "type"
  end
  if tok_kind(toks, pos) != 1
    fail "type"
  end
  let name = tok_text(toks, pos)
  if eqb(name, "i64")
    return parsed(p, pos + 1 else fail "math", 1)
  end
  if eqb(name, "bytes")
    return parsed(p, pos + 1 else fail "math", 2)
  end
  if eqb(name, "list")
    let inner = read_type(p, toks, pos + 1 else fail "math")
    let k = 1000 + inner.kind else fail "math"
    return parsed(p, inner.pos, k)
  end
  if eqb(name, "map")
    let key = read_type(p, toks, pos + 1 else fail "math")
    let val = read_type(p, toks, key.pos)
    let scaled = key.kind * 1000 else fail "math"
    let body = 2000 + scaled else fail "math"
    let k = body + val.kind else fail "math"
    return parsed(p, val.pos, k)
  end
  if has(p.cold.sname, name) == 0
    fail "type"
  end
  let packed = get(p.cold.sname, name) else fail "type"
  return parsed(p, pos + 1 else fail "math", slot_index(packed))
end

fn note_field(p: prog, toks: toks) -> prog
  if toks.count < 3
    fail "expected a field name"
  end
  if tok_kind(toks, 0) != 1
    fail "expected a field name"
  end
  if tok_kind(toks, 1) != 9
    fail "expected :"
  end
  let name = tok_text(toks, 0)
  let typed = read_type(p, toks, 2)
  if typed.pos != toks.count
    fail "extra tokens"
  end
  let slash = id_text(p.cold.nstruct) ++ "/" ++ name
  if has(p.cold.sfld, slash)
    fail "duplicate field"
  end
  let dot = id_text(p.cold.nstruct) ++ "." ++ id_text(p.cold.nfield)
  let sfld = put(p.cold.sfld, slash, pack_slot(p.cold.nfield, typed.kind))
  set sfld = put(sfld, dot, typed.kind)
  return with_row(p, p.cold.sname, sfld, p.cold.nstruct, p.cold.building, p.cold.nfield + 1 else fail "math", p.cold.live)
end

fn leading_is(text: bytes, word: bytes) -> i64
  let i = 0
  let n = len(text)
  let go = 1
  while go
    if i >= n
      set go = 0
    else
      let c = at_or(text, i)
      if c == 32
        set i = i + 1 else fail "math"
      else
        if c == 9
          set i = i + 1 else fail "math"
        else
          set go = 0
        end
      end
    end
  end
  let w = len(word)
  let endat = i + w else fail "math"
  if endat > n
    return 0
  end
  if eq_span(text, i, word, 0, w) == 0
    return 0
  end
  if endat < n
    if is_ident(at_or(text, endat))
      return 0
    end
  end
  return 1
end

fn leading_word(text: bytes) -> bytes
  let i = 0
  let n = len(text)
  let go = 1
  while go
    if i >= n
      set go = 0
    else
      let c = at_or(text, i)
      if c == 32
        set i = i + 1 else fail "math"
      else
        if c == 9
          set i = i + 1 else fail "math"
        else
          set go = 0
        end
      end
    end
  end
  if i >= n
    return ""
  end
  if is_letter(at_or(text, i)) == 0
    return ""
  end
  let got = read_ident(text, i)
  return got.tok.text
end

fn scan_structs(p: prog, text: bytes) -> prog
  let cur = p
  let mode = 0
  for line in lines(text)
    let take = 0
    if mode == 2
      set take = 1
    else
      if leading_is(line.text, "struct")
        set take = 1
      end
    end
    if take != 0
        let toks = lex(line.text)
        if toks.count != 0
          if mode == 2
            if eqb(tok_text(toks, 0), "end")
              if toks.count != 1
                fail "extra tokens"
              end
              if cur.cold.nfield == 0
                fail "struct needs a field"
              end
              let packed = pack_slot(cur.cold.nstruct, cur.cold.nfield)
              let sname = put(cur.cold.sname, cur.cold.building, packed)
              let nxt = cur.cold.nstruct + 1 else fail "math"
              set cur = with_row(cur, sname, cur.cold.sfld, nxt, "", 0, 0)
              set mode = 0
            else
              set cur = note_field(cur, toks)
            end
          else
            if eqb(tok_text(toks, 0), "struct")
              if toks.count != 2
                fail "expected a struct name"
              end
              if tok_kind(toks, 1) != 1
                fail "expected a struct name"
              end
              let name = tok_text(toks, 1)
              if has(cur.cold.sname, name)
                fail "duplicate struct"
              end
              set cur = with_row(cur, cur.cold.sname, cur.cold.sfld, cur.cold.nstruct, name, 0, 0)
              set mode = 2
            end
          end
        end
    end
  end
  if mode != 0
    fail "expected end"
  end
  return cur
end

fn arrow_type(p: prog, toks: toks) -> i64
  let i = 0
  let n = toks.count
  while i < n
    if tok_kind(toks, i) == 10
      let typed = read_type(p, toks, i + 1 else fail "math")
      return typed.kind
    end
    set i = i + 1 else fail "math"
  end
  return 0
end

fn scan_fns(p: prog, text: bytes) -> prog
  let fnames = p.cold.fnames
  let arity = p.cold.arity
  let rets = p.cold.rets
  let count = 0
  for line in lines(text)
    if leading_is(line.text, "fn")
      let toks = lex(line.text)
      if toks.count > 0
        if eqb(tok_text(toks, 0), "fn")
          if toks.count < 2
            fail "expected a name"
          end
          let name = tok_text(toks, 1)
          if eqb(name, "main")
            if toks.count != 2
              fail "main takes no parameters"
            end
          end
          if seek_named(fnames, name) >= 0
            fail "duplicate function"
          end
          let slots = bind_params(p, toks)
          set fnames = note_bytes(fnames, count, name)
          set arity = note_bytes(arity, len(slots), name)
          set rets = note_bytes(rets, arrow_type(p, toks), name)
          set count = count + 1 else fail "math"
        end
      end
    end
  end
  if count == 0
    fail "missing fn"
  end
  return with_fns(p, fnames, arity, rets)
end

fn take_fields(cur: parsed, toks: toks) -> parsed
  let out = cur
  while tok_is(toks, out.pos, 19)
    if tok_is(toks, out.pos + 1 else fail "math", 1) == 0
      fail "field"
    end
    let field = tok_text(toks, out.pos + 1 else fail "math")
    if out.kind == 3
      if eqb(field, "text")
        set out = parsed(take_code(out.prog, byte(28)), out.pos + 2 else fail "math", 2)
      else
        if eqb(field, "n")
          set out = parsed(take_code(out.prog, byte(27)), out.pos + 2 else fail "math", 1)
        else
          fail "field"
        end
      end
    else
      if out.kind < 7
        fail "field"
      end
      if out.kind >= 1000
        fail "field"
      end
      let key = id_text(out.kind) ++ "/" ++ field
      if has(out.prog.cold.sfld, key) == 0
        fail "field"
      end
      let packed = get(out.prog.cold.sfld, key) else fail "field"
      let coded = take_code(out.prog, byte(51) ++ u16(slot_index(packed)))
      set out = parsed(coded, out.pos + 2 else fail "math", slot_kind(packed))
    end
  end
  return out
end

fn parse_atom(p: prog, toks: toks, pos: i64) -> parsed
  if pos >= toks.count
    fail "expected expression"
  end
  let kind = tok_kind(toks, pos)
  if kind == 2
    let nxt = push_i64(p, tok_num(toks, pos))
    return parsed(nxt, pos + 1 else fail "math", 1)
  end
  if kind == 3
    let nxt2 = push_bytes(p, tok_text(toks, pos))
    return parsed(nxt2, pos + 1 else fail "math", 2)
  end
  if kind == 6
    let inner = parse_expr(p, toks, pos + 1 else fail "math")
    if tok_is(toks, inner.pos, 7) == 0
      fail "expected )"
    end
    return take_fields(parsed(inner.prog, inner.pos + 1 else fail "math", inner.kind), toks)
  end
  if kind == 1
    if eqb(tok_text(toks, pos), "fail")
      return parse_fail_expr(p, toks, pos)
    end
    if eqb(tok_text(toks, pos), "reason")
      return parsed(take_code(p, byte(29)), pos + 1 else fail "math", 2)
    end
    if tok_is(toks, pos + 1 else fail "math", 6)
      return take_fields(parse_call(p, toks, pos), toks)
    end
    let nxt3 = push_local(p, tok_text(toks, pos))
    let raw = get(p.cold.slots, tok_text(toks, pos)) else fail "unknown name"
    let sk = slot_kind(raw)
    return take_fields(parsed(nxt3, pos + 1 else fail "math", sk), toks)
  end
  if kind == 11
    let inner = parse_atom(p, toks, pos + 1 else fail "math")
    if inner.kind != 1
      fail "type"
    end
    let negated = emit_iffail(take_code(inner.prog, byte(17)))
    return parsed(negated, inner.pos, 1)
  end
  fail "bad expression"
  return parsed(p, pos, 0)
end

fn parse_argc(p: prog, toks: toks, pos: i64) -> parsed
  if tok_is(toks, pos + 1 else fail "math", 6) == 0
    fail "expected ("
  end
  if tok_is(toks, pos + 2 else fail "math", 7) == 0
    fail "arity"
  end
  return parsed(take_code(p, byte(21)), pos + 3 else fail "math", 1)
end

fn parse_one(p: prog, toks: toks, pos: i64, want: i64, op: i64, outk: i64) -> parsed
  if tok_is(toks, pos + 1 else fail "math", 6) == 0
    fail "expected ("
  end
  let cur = parse_expr(p, toks, pos + 2 else fail "math")
  if cur.kind != want
    fail "type"
  end
  if tok_is(toks, cur.pos, 7) == 0
    fail "expected )"
  end
  let done = emit_iffail(take_code(cur.prog, byte(op)))
  return parsed(done, cur.pos + 1 else fail "math", outk)
end

fn parse_arg(p: prog, toks: toks, pos: i64) -> parsed
  return parse_one(p, toks, pos, 1, 22, 2)
end

fn parse_i64_call(p: prog, toks: toks, pos: i64) -> parsed
  return parse_one(p, toks, pos, 2, 20, 1)
end

fn parse_len(p: prog, toks: toks, pos: i64) -> parsed
  if tok_is(toks, pos + 1 else fail "math", 6) == 0
    fail "expected ("
  end
  let cur = parse_expr(p, toks, pos + 2 else fail "math")
  if tok_is(toks, cur.pos, 7) == 0
    fail "expected )"
  end
  let op = 0
  if cur.kind == 2
    set op = 25
  end
  if cur.kind >= 1000
    if cur.kind < 2000
      set op = 49
    end
  end
  if cur.kind >= 2000
    set op = 56
  end
  if op == 0
    fail "type"
  end
  let done = emit_iffail(take_code(cur.prog, byte(op)))
  return parsed(done, cur.pos + 1 else fail "math", 1)
end

fn parse_open(p: prog, toks: toks, pos: i64) -> parsed
  if tok_is(toks, pos + 1 else fail "math", 6) == 0
    fail "expected ("
  end
  let a1 = parse_expr(p, toks, pos + 2 else fail "math")
  if a1.kind != 2
    fail "type"
  end
  if tok_is(toks, a1.pos, 8) == 0
    fail "expected ,"
  end
  let a2 = parse_expr(a1.prog, toks, a1.pos + 1 else fail "math")
  if a2.kind != 1
    fail "type"
  end
  if tok_is(toks, a2.pos, 8) == 0
    fail "expected ,"
  end
  let a3 = parse_expr(a2.prog, toks, a2.pos + 1 else fail "math")
  if a3.kind != 2
    fail "type"
  end
  if tok_is(toks, a3.pos, 8) == 0
    fail "expected ,"
  end
  let a4 = parse_expr(a3.prog, toks, a3.pos + 1 else fail "math")
  if a4.kind != 2
    fail "type"
  end
  if tok_is(toks, a4.pos, 8) == 0
    fail "expected ,"
  end
  let a5 = parse_expr(a4.prog, toks, a4.pos + 1 else fail "math")
  if a5.kind != 2
    fail "type"
  end
  if tok_is(toks, a5.pos, 7) == 0
    fail "expected )"
  end
  let done = emit_iffail(take_code(a5.prog, byte(23)))
  return parsed(done, a5.pos + 1 else fail "math", 2)
end

fn parse_call(p: prog, toks: toks, pos: i64) -> parsed
  let name = tok_text(toks, pos)
  if eqb(name, "argc")
    return parse_argc(p, toks, pos)
  end
  if eqb(name, "arg")
    return parse_arg(p, toks, pos)
  end
  if eqb(name, "open")
    return parse_open(p, toks, pos)
  end
  if eqb(name, "i64")
    return parse_i64_call(p, toks, pos)
  end
  if eqb(name, "len")
    return parse_len(p, toks, pos)
  end
  if eqb(name, "before")
    return parse_pair(p, toks, pos, 35, 2)
  end
  if eqb(name, "after")
    return parse_pair(p, toks, pos, 36, 2)
  end
  if eqb(name, "holds")
    return parse_pair(p, toks, pos, 37, 1)
  end
  if eqb(name, "byte")
    return parse_one(p, toks, pos, 1, 3, 2)
  end
  if eqb(name, "at")
    return parse_at(p, toks, pos)
  end
  if eqb(name, "set_byte")
    return parse_set_byte(p, toks, pos)
  end
  if eqb(name, "save")
    return parse_save(p, toks, pos)
  end
  if eqb(name, "list")
    return parse_list(p, toks, pos)
  end
  if eqb(name, "map")
    return parse_map_lit(p, toks, pos)
  end
  if eqb(name, "push")
    return parse_push(p, toks, pos)
  end
  if eqb(name, "put")
    return parse_put(p, toks, pos)
  end
  if eqb(name, "get")
    return parse_get(p, toks, pos)
  end
  if eqb(name, "has")
    return parse_has(p, toks, pos)
  end
  if has(p.cold.sname, name)
    return parse_struct_call(p, toks, pos, name)
  end
  if seek_named(p.cold.fnames, name) < 0
    fail "unknown function"
  end
  let want = seek_named(p.cold.arity, name)
  if want < 0
    fail "arity"
  end
  let i = pos + 2 else fail "math"
  let code = ""
  let pcur = p
  let got = 0
  let mode = 1
  if tok_is(toks, i, 7)
    set i = i + 1 else fail "math"
    set mode = 2
  end
  while mode == 1
    let k = tok_kind(toks, i)
    let took = 0
    if k == 2
      let num = tok_num(toks, i)
      set pcur = intern_i64(pcur, num)
      let ix = seek_i64(pcur.cold.imap, num)
      if ix < 0
        fail "const"
      end
      set code = code ++ byte(5) ++ u16(ix)
      set i = i + 1 else fail "math"
      set got = got + 1 else fail "math"
      set took = 1
    end
    if k == 3
      let lit = tok_text(toks, i)
      set pcur = intern_bytes(pcur, lit)
      let sx = seek_named(pcur.cold.smap, lit)
      if sx < 0
        fail "const"
      end
      set code = code ++ byte(5) ++ u16(sx)
      set i = i + 1 else fail "math"
      set got = got + 1 else fail "math"
      set took = 1
    end
    if k == 1
      let nxt = i + 1 else fail "math"
      if tok_is(toks, nxt, 6)
        set mode = 0
      else
        if tok_is(toks, nxt, 19)
          set mode = 0
        else
          let nm = tok_text(toks, i)
          if eqb(nm, "fail")
            set mode = 0
          else
            if eqb(nm, "reason")
              set mode = 0
            else
              if has(pcur.cold.slots, nm) == 0
                fail "unknown name"
              end
              let raws = get(pcur.cold.slots, nm) else fail "unknown name"
              set code = code ++ byte(7) ++ u16(slot_index(raws))
              set i = i + 1 else fail "math"
              set got = got + 1 else fail "math"
              set took = 1
            end
          end
        end
      end
    end
    if took
      if tok_is(toks, i, 8)
        set i = i + 1 else fail "math"
      else
        if tok_is(toks, i, 7)
          set i = i + 1 else fail "math"
          set mode = 2
        else
          set mode = 0
        end
      end
    else
      if mode == 1
        set mode = 0
      end
    end
  end
  let cur = parsed(p, i, 1)
  if mode != 2
    set code = ""
    set pcur = p
    set i = pos + 2 else fail "math"
    set got = 0
    if tok_is(toks, i, 7)
      set i = i + 1 else fail "math"
    else
      set cur = parse_expr(p, toks, i)
      set got = 1
      set i = cur.pos
      while tok_is(toks, i, 8)
        set cur = parse_expr(cur.prog, toks, i + 1 else fail "math")
        set got = got + 1 else fail "math"
        set i = cur.pos
      end
      if tok_is(toks, i, 7) == 0
        fail "expected )"
      end
      set i = i + 1 else fail "math"
    end
  end
  if got != want
    fail "arity"
  end
  let idx = seek_named(p.cold.fnames, name)
  if idx < 0
    fail "unknown function"
  end
  let base = cur.prog
  if mode == 2
    set base = pcur
  end
  let called = take_code(base, code ++ byte(30) ++ u16(idx))
  let failed = emit_iffail(called)
  let rk = 1
  let rkfound = seek_named(p.cold.rets, name)
  if rkfound >= 0
    set rk = rkfound
  end
  if rk == 0
    set rk = 1
  end
  return parsed(failed, i, rk)
end

fn parse_pair(p: prog, toks: toks, pos: i64, op: i64, outk: i64) -> parsed
  if tok_is(toks, pos + 1 else fail "math", 6) == 0
    fail "expected ("
  end
  let a1 = parse_expr(p, toks, pos + 2 else fail "math")
  if a1.kind != 2
    fail "type"
  end
  if tok_is(toks, a1.pos, 8) == 0
    fail "expected ,"
  end
  let a2 = parse_expr(a1.prog, toks, a1.pos + 1 else fail "math")
  if a2.kind != 2
    fail "type"
  end
  if tok_is(toks, a2.pos, 7) == 0
    fail "expected )"
  end
  let done = emit_iffail(take_code(a2.prog, byte(op)))
  return parsed(done, a2.pos + 1 else fail "math", outk)
end

fn product_op(toks: toks, pos: i64) -> i64
  if tok_is(toks, pos, 21)
    return 15
  end
  if tok_is(toks, pos, 20)
    return 16
  end
  return 0
end

fn parse_product(p: prog, toks: toks, pos: i64) -> parsed
  let cur = parse_atom(p, toks, pos)
  let op = product_op(toks, cur.pos)
  while op != 0
    if cur.kind != 1
      fail "type"
    end
    let right = parse_atom(cur.prog, toks, cur.pos + 1 else fail "math")
    if right.kind != 1
      fail "type"
    end
    let done = emit_iffail(take_code(right.prog, byte(op)))
    set cur = parsed(done, right.pos, 1)
    set op = product_op(toks, cur.pos)
  end
  return cur
end

fn sum_op(toks: toks, pos: i64) -> i64
  if tok_is(toks, pos, 4)
    return 13
  end
  if tok_is(toks, pos, 11)
    return 14
  end
  return 0
end

fn parse_list(p: prog, toks: toks, pos: i64) -> parsed
  if tok_is(toks, pos + 1 else fail "math", 6) == 0
    fail "expected ("
  end
  let i = pos + 2 else fail "math"
  if tok_is(toks, i, 7)
    let done = take_code(p, byte(46) ++ u16(0))
    return parsed(done, i + 1 else fail "math", 0)
  end
  let cur = parse_expr(p, toks, i)
  if cur.kind == 0
    fail "type"
  end
  let elem = cur.kind
  let count = 1
  while tok_is(toks, cur.pos, 8)
    set cur = parse_expr(cur.prog, toks, cur.pos + 1 else fail "math")
    if cur.kind != elem
      fail "type"
    end
    set count = count + 1 else fail "math"
  end
  if tok_is(toks, cur.pos, 7) == 0
    fail "expected )"
  end
  let built = take_code(cur.prog, byte(46) ++ u16(count))
  let kind = 1000 + elem else fail "math"
  return parsed(built, cur.pos + 1 else fail "math", kind)
end

fn parse_map_lit(p: prog, toks: toks, pos: i64) -> parsed
  if tok_is(toks, pos + 1 else fail "math", 6) == 0
    fail "expected ("
  end
  let i = pos + 2 else fail "math"
  if tok_is(toks, i, 7)
    let done = take_code(p, byte(52) ++ u16(0))
    return parsed(done, i + 1 else fail "math", 0)
  end
  let key = parse_expr(p, toks, i)
  if key.kind == 0
    fail "type"
  end
  if tok_is(toks, key.pos, 8) == 0
    fail "expected ,"
  end
  let val = parse_expr(key.prog, toks, key.pos + 1 else fail "math")
  if val.kind == 0
    fail "type"
  end
  let kk = key.kind
  let vk = val.kind
  let cur = val
  let pairs = 1
  while tok_is(toks, cur.pos, 8)
    let nk = parse_expr(cur.prog, toks, cur.pos + 1 else fail "math")
    if nk.kind != kk
      fail "type"
    end
    if tok_is(toks, nk.pos, 8) == 0
      fail "expected ,"
    end
    set cur = parse_expr(nk.prog, toks, nk.pos + 1 else fail "math")
    if cur.kind != vk
      fail "type"
    end
    set pairs = pairs + 1 else fail "math"
  end
  if tok_is(toks, cur.pos, 7) == 0
    fail "expected )"
  end
  let built = take_code(cur.prog, byte(52) ++ u16(pairs))
  let scaled = kk * 1000 else fail "math"
  let body = 2000 + scaled else fail "math"
  let kind = body + vk else fail "math"
  return parsed(built, cur.pos + 1 else fail "math", kind)
end

fn parse_push(p: prog, toks: toks, pos: i64) -> parsed
  if tok_is(toks, pos + 1 else fail "math", 6) == 0
    fail "expected ("
  end
  let a1 = parse_expr(p, toks, pos + 2 else fail "math")
  if a1.kind < 1000
    fail "type"
  end
  if a1.kind >= 2000
    fail "type"
  end
  if tok_is(toks, a1.pos, 8) == 0
    fail "expected ,"
  end
  let a2 = parse_expr(a1.prog, toks, a1.pos + 1 else fail "math")
  let elem = a1.kind - 1000 else fail "math"
  if a2.kind != elem
    fail "type"
  end
  if tok_is(toks, a2.pos, 7) == 0
    fail "expected )"
  end
  let done = take_code(a2.prog, byte(47))
  return parsed(done, a2.pos + 1 else fail "math", a1.kind)
end

fn parse_put(p: prog, toks: toks, pos: i64) -> parsed
  if tok_is(toks, pos + 1 else fail "math", 6) == 0
    fail "expected ("
  end
  let a1 = parse_expr(p, toks, pos + 2 else fail "math")
  if a1.kind < 2000
    fail "type"
  end
  if tok_is(toks, a1.pos, 8) == 0
    fail "expected ,"
  end
  let a2 = parse_expr(a1.prog, toks, a1.pos + 1 else fail "math")
  let span = a1.kind - 2000 else fail "math"
  let kk = span / 1000 else fail "math"
  let scaled = kk * 1000 else fail "math"
  let vk = span - scaled else fail "math"
  if a2.kind != kk
    fail "type"
  end
  if tok_is(toks, a2.pos, 8) == 0
    fail "expected ,"
  end
  let a3 = parse_expr(a2.prog, toks, a2.pos + 1 else fail "math")
  if a3.kind != vk
    fail "type"
  end
  if tok_is(toks, a3.pos, 7) == 0
    fail "expected )"
  end
  let done = take_code(a3.prog, byte(53))
  return parsed(done, a3.pos + 1 else fail "math", a1.kind)
end

fn parse_get(p: prog, toks: toks, pos: i64) -> parsed
  if tok_is(toks, pos + 1 else fail "math", 6) == 0
    fail "expected ("
  end
  let a1 = parse_expr(p, toks, pos + 2 else fail "math")
  if a1.kind < 2000
    fail "type"
  end
  if tok_is(toks, a1.pos, 8) == 0
    fail "expected ,"
  end
  let a2 = parse_expr(a1.prog, toks, a1.pos + 1 else fail "math")
  let span = a1.kind - 2000 else fail "math"
  let kk = span / 1000 else fail "math"
  if a2.kind != kk
    fail "type"
  end
  if tok_is(toks, a2.pos, 7) == 0
    fail "expected )"
  end
  let scaled = kk * 1000 else fail "math"
  let vk = span - scaled else fail "math"
  let done = emit_iffail(take_code(a2.prog, byte(54)))
  return parsed(done, a2.pos + 1 else fail "math", vk)
end

fn parse_has(p: prog, toks: toks, pos: i64) -> parsed
  if tok_is(toks, pos + 1 else fail "math", 6) == 0
    fail "expected ("
  end
  let a1 = parse_expr(p, toks, pos + 2 else fail "math")
  if a1.kind < 2000
    fail "type"
  end
  if tok_is(toks, a1.pos, 8) == 0
    fail "expected ,"
  end
  let a2 = parse_expr(a1.prog, toks, a1.pos + 1 else fail "math")
  let span = a1.kind - 2000 else fail "math"
  let kk = span / 1000 else fail "math"
  if a2.kind != kk
    fail "type"
  end
  if tok_is(toks, a2.pos, 7) == 0
    fail "expected )"
  end
  let done = take_code(a2.prog, byte(55))
  return parsed(done, a2.pos + 1 else fail "math", 1)
end

fn parse_struct_call(p: prog, toks: toks, pos: i64, name: bytes) -> parsed
  let packed = get(p.cold.sname, name) else fail "type"
  let id = slot_index(packed)
  let nfields = slot_kind(packed)
  if tok_is(toks, pos + 1 else fail "math", 6) == 0
    fail "expected ("
  end
  let cur = parsed(p, pos + 2 else fail "math", 0)
  let got = 0
  if tok_is(toks, cur.pos, 7) == 0
    set cur = parse_expr(p, toks, cur.pos)
    set got = 1
    let want = get(p.cold.sfld, id_text(id) ++ "." ++ id_text(0)) else fail "field"
    if cur.kind != want
      fail "type"
    end
    while tok_is(toks, cur.pos, 8)
      set cur = parse_expr(cur.prog, toks, cur.pos + 1 else fail "math")
      let need = get(p.cold.sfld, id_text(id) ++ "." ++ id_text(got)) else fail "field"
      if cur.kind != need
        fail "type"
      end
      set got = got + 1 else fail "math"
    end
  end
  if tok_is(toks, cur.pos, 7) == 0
    fail "expected )"
  end
  if got != nfields
    fail "arity"
  end
  let built = take_code(cur.prog, byte(50) ++ u16(nfields))
  return parsed(built, cur.pos + 1 else fail "math", id)
end

fn parse_at(p: prog, toks: toks, pos: i64) -> parsed
  if tok_is(toks, pos + 1 else fail "math", 6) == 0
    fail "expected ("
  end
  let a1 = parse_expr(p, toks, pos + 2 else fail "math")
  let op = 0
  let outk = 1
  if a1.kind == 2
    set op = 24
  end
  if a1.kind >= 1000
    if a1.kind < 2000
      set op = 48
      set outk = a1.kind - 1000 else fail "math"
    end
  end
  if op == 0
    fail "type"
  end
  if tok_is(toks, a1.pos, 8) == 0
    fail "expected ,"
  end
  let a2 = parse_expr(a1.prog, toks, a1.pos + 1 else fail "math")
  if a2.kind != 1
    fail "type"
  end
  if tok_is(toks, a2.pos, 7) == 0
    fail "expected )"
  end
  let done = emit_iffail(take_code(a2.prog, byte(op)))
  return parsed(done, a2.pos + 1 else fail "math", outk)
end

fn parse_set_byte(p: prog, toks: toks, pos: i64) -> parsed
  if tok_is(toks, pos + 1 else fail "math", 6) == 0
    fail "expected ("
  end
  let a1 = parse_expr(p, toks, pos + 2 else fail "math")
  if a1.kind != 2
    fail "type"
  end
  if tok_is(toks, a1.pos, 8) == 0
    fail "expected ,"
  end
  let a2 = parse_expr(a1.prog, toks, a1.pos + 1 else fail "math")
  if a2.kind != 1
    fail "type"
  end
  if tok_is(toks, a2.pos, 8) == 0
    fail "expected ,"
  end
  let a3 = parse_expr(a2.prog, toks, a2.pos + 1 else fail "math")
  if a3.kind != 1
    fail "type"
  end
  if tok_is(toks, a3.pos, 7) == 0
    fail "expected )"
  end
  let done = emit_iffail(take_code(a3.prog, byte(10)))
  return parsed(done, a3.pos + 1 else fail "math", 2)
end

fn parse_save(p: prog, toks: toks, pos: i64) -> parsed
  if tok_is(toks, pos + 1 else fail "math", 6) == 0
    fail "expected ("
  end
  let a1 = parse_expr(p, toks, pos + 2 else fail "math")
  if a1.kind != 2
    fail "type"
  end
  if tok_is(toks, a1.pos, 8) == 0
    fail "expected ,"
  end
  let a2 = parse_expr(a1.prog, toks, a1.pos + 1 else fail "math")
  if a2.kind != 2
    fail "type"
  end
  if tok_is(toks, a2.pos, 7) == 0
    fail "expected )"
  end
  let done = emit_iffail(take_code(a2.prog, byte(4)))
  return parsed(done, a2.pos + 1 else fail "math", 1)
end

fn parse_sum(p: prog, toks: toks, pos: i64) -> parsed
  let cur = parse_product(p, toks, pos)
  let op = sum_op(toks, cur.pos)
  while op != 0
    if cur.kind != 1
      fail "type"
    end
    let right = parse_product(cur.prog, toks, cur.pos + 1 else fail "math")
    if right.kind != 1
      fail "type"
    end
    let added = emit_iffail(take_code(right.prog, byte(op)))
    set cur = parsed(added, right.pos, 1)
    set op = sum_op(toks, cur.pos)
  end
  return cur
end


fn emit_return(p: prog, toks: toks) -> prog
  let cur = parse_expr(p, toks, 1)
  if cur.pos != toks.count
    fail "extra tokens"
  end
  return take_code(cur.prog, byte(31))
end

fn emit_write(p: prog, toks: toks) -> prog
  let cur = parse_expr(p, toks, 1)
  if cur.pos != toks.count
    fail "extra tokens"
  end
  let outp = cur
  if cur.kind == 1
    set outp = do_dec(cur)
  end
  return take_code(outp.prog, byte(1))
end

fn bind_params(p: prog, toks: toks) -> map bytes i64
  let slots: map bytes i64 = map()
  let i = 0
  let n = toks.count
  let slot = 0
  while i < n
    if tok_kind(toks, i) == 9
      let name = tok_text(toks, i - 1 else fail "math")
      let typed = read_type(p, toks, i + 1 else fail "math")
      set slots = put(slots, name, pack_slot(slot, typed.kind))
      set slot = slot + 1 else fail "math"
      set i = typed.pos - 1 else fail "math"
    end
    set i = i + 1 else fail "math"
  end
  return slots
end

