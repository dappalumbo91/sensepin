fn eqb(left: bytes, right: bytes) -> i64
  let n = len(left)
  if n != len(right)
    return 0
  end
  let i = 0
  let same = 1
  while i < n
    if at(left, i) != at(right, i)
      set same = 0
    end
    set i = i + 1 else fail "math"
  end
  return same
end

fn at_or(text: bytes, i: i64) -> i64
  if i < 0
    return -1
  end
  if i >= len(text)
    return -1
  end
  return at(text, i) else fail "byte"
end

fn is_letter(c: i64) -> i64
  if c >= 65
    if c <= 90
      return 1
    end
  end
  if c >= 97
    if c <= 122
      return 1
    end
  end
  return 0
end

fn is_digit(c: i64) -> i64
  if c >= 48
    if c <= 57
      return 1
    end
  end
  return 0
end

fn is_ident(c: i64) -> i64
  if is_letter(c)
    return 1
  end
  if is_digit(c)
    return 1
  end
  if c == 95
    return 1
  end
  return 0
end

fn read_ident(text: bytes, i: i64) -> step
  let j = i
  let n = len(text)
  let raw = ""
  let go = 1
  while go
    if j >= n
      set go = 0
    else
      let c = at_or(text, j)
      if is_ident(c)
        set raw = raw ++ byte(c)
        set j = j + 1 else fail "math"
      else
        set go = 0
      end
    end
  end
  return step(tok(1, 0, raw), j)
end

fn read_number(text: bytes, i: i64) -> step
  let j = i
  let n = len(text)
  let raw = ""
  let go = 1
  while go
    if j >= n
      set go = 0
    else
      let c = at_or(text, j)
      if is_digit(c)
        set raw = raw ++ byte(c)
        set j = j + 1 else fail "math"
      else
        set go = 0
      end
    end
  end
  let num = i64(raw) else fail "bad integer"
  return step(tok(2, num, raw), j)
end

fn read_string(text: bytes, i: i64) -> step
  let j = i + 1 else fail "math"
  let raw = ""
  let n = len(text)
  let closed = 0
  let go = 1
  while go
    if j >= n
      set go = 0
    else
      let c = at_or(text, j)
      if c == 34
        set j = j + 1 else fail "math"
        set closed = 1
        set go = 0
      else
        if c == 92
          let e = at_or(text, j + 1)
          let ch = 0
          if e == 110
            set ch = 10
          end
          if e == 92
            set ch = 92
          end
          if e == 34
            set ch = 34
          end
          if ch == 0
            fail "bad escape"
          end
          set raw = raw ++ byte(ch)
          set j = j + 2 else fail "math"
        else
          set raw = raw ++ byte(c)
          set j = j + 1 else fail "math"
        end
      end
    end
  end
  if closed == 0
    fail "unterminated string"
  end
  return step(tok(3, 0, raw), j)
end

fn lex(text: bytes) -> list tok
  let toks: list tok = list()
  let i = 0
  let n = len(text)
  while i < n
    let c = at_or(text, i)
    if c == 32
      set i = i + 1 else fail "math"
    else
      if c == 9
        set i = i + 1 else fail "math"
      else
        if c == 13
          set i = i + 1 else fail "math"
        else
          if c == 35
            set i = n
          else
            if c == 34
              let got = read_string(text, i)
              set toks = push(toks, got.tok)
              set i = got.pos
            else
              if is_letter(c)
                let got = read_ident(text, i)
                set toks = push(toks, got.tok)
                set i = got.pos
              else
                if c == 95
                  let got = read_ident(text, i)
                  set toks = push(toks, got.tok)
                  set i = got.pos
                else
                  if is_digit(c)
                    let got = read_number(text, i)
                    set toks = push(toks, got.tok)
                    set i = got.pos
                  else
                    if c == 43
                      if at_or(text, i + 1) == 43
                        set toks = push(toks, tok(5, 0, ""))
                        set i = i + 2 else fail "math"
                      else
                        set toks = push(toks, tok(4, 0, ""))
                        set i = i + 1 else fail "math"
                      end
                    else
                      if c == 45
                        if at_or(text, i + 1) == 62
                          set toks = push(toks, tok(10, 0, ""))
                          set i = i + 2 else fail "math"
                        else
                          set toks = push(toks, tok(11, 0, ""))
                          set i = i + 1 else fail "math"
                        end
                      else
                        if c == 40
                          set toks = push(toks, tok(6, 0, ""))
                          set i = i + 1 else fail "math"
                        else
                          if c == 41
                            set toks = push(toks, tok(7, 0, ""))
                            set i = i + 1 else fail "math"
                          else
                            if c == 44
                              set toks = push(toks, tok(8, 0, ""))
                              set i = i + 1 else fail "math"
                            else
                              if c == 58
                                set toks = push(toks, tok(9, 0, ""))
                                set i = i + 1 else fail "math"
                              else
                                if c == 61
                                  if at_or(text, i + 1) == 61
                                    set toks = push(toks, tok(13, 0, ""))
                                    set i = i + 2 else fail "math"
                                  else
                                    set toks = push(toks, tok(12, 0, ""))
                                    set i = i + 1 else fail "math"
                                  end
                                else
                                  if c == 33
                                    if at_or(text, i + 1) != 61
                                      fail "bad character"
                                    end
                                    set toks = push(toks, tok(14, 0, ""))
                                    set i = i + 2 else fail "math"
                                  else
                                    if c == 60
                                      if at_or(text, i + 1) == 61
                                        set toks = push(toks, tok(17, 0, ""))
                                        set i = i + 2 else fail "math"
                                      else
                                        set toks = push(toks, tok(15, 0, ""))
                                        set i = i + 1 else fail "math"
                                      end
                                    else
                                      if c == 62
                                        if at_or(text, i + 1) == 61
                                          set toks = push(toks, tok(18, 0, ""))
                                          set i = i + 2 else fail "math"
                                        else
                                          set toks = push(toks, tok(16, 0, ""))
                                          set i = i + 1 else fail "math"
                                        end
                                      else
                                        if c == 46
                                          set toks = push(toks, tok(19, 0, ""))
                                          set i = i + 1 else fail "math"
                                        else
                                          if c == 47
                                            set toks = push(toks, tok(20, 0, ""))
                                            set i = i + 1 else fail "math"
                                          else
                                            if c == 42
                                              set toks = push(toks, tok(21, 0, ""))
                                              set i = i + 1 else fail "math"
                                            else
                                              fail "bad character"
                                            end
                                          end
                                        end
                                      end
                                    end
                                  end
                                end
                              end
                            end
                          end
                        end
                      end
                    end
                  end
                end
              end
            end
          end
        end
      end
    end
  end
  return toks
end

fn tok_is(toks: list tok, pos: i64, kind: i64) -> i64
  if pos < 0
    return 0
  end
  if pos >= len(toks)
    return 0
  end
  if at(toks, pos).kind == kind
    return 1
  end
  return 0
end

fn spawn(code: bytes, pool: bytes, nconst: i64, strs: bytes, funcs: bytes, jumps: list fixup, marks: map bytes i64, imap: map i64 i64, bmap: map bytes i64, smap: map bytes i64, fnames: map bytes i64, arity: map bytes i64, slots: map bytes i64, unwind: bytes, main_off: i64, main_slots: i64, saw_main: i64, live: i64, start: i64, nparams: i64, is_main: i64, seen: i64, cbuf: buf, blocks: list block, failto: bytes, pbuf: buf) -> prog
  return prog(code, pool, nconst, strs, funcs, jumps, marks, imap, bmap, smap, fnames, arity, slots, unwind, main_off, main_slots, saw_main, live, start, nparams, is_main, seen, cbuf, blocks, failto, pbuf)
end

fn with_code(p: prog, code: bytes) -> prog
  return spawn(code, p.pool, p.nconst, p.strs, p.funcs, p.jumps, p.marks, p.imap, p.bmap, p.smap, p.fnames, p.arity, p.slots, p.unwind, p.main_off, p.main_slots, p.saw_main, p.live, p.start, p.nparams, p.is_main, p.seen, p.cbuf, p.blocks, p.failto, p.pbuf)
end

fn with_cbuf(p: prog, cbuf: buf) -> prog
  return spawn(p.code, p.pool, p.nconst, p.strs, p.funcs, p.jumps, p.marks, p.imap, p.bmap, p.smap, p.fnames, p.arity, p.slots, p.unwind, p.main_off, p.main_slots, p.saw_main, p.live, p.start, p.nparams, p.is_main, p.seen, cbuf, p.blocks, p.failto, p.pbuf)
end

fn with_jumps(p: prog, jumps: list fixup) -> prog
  return spawn(p.code, p.pool, p.nconst, p.strs, p.funcs, jumps, p.marks, p.imap, p.bmap, p.smap, p.fnames, p.arity, p.slots, p.unwind, p.main_off, p.main_slots, p.saw_main, p.live, p.start, p.nparams, p.is_main, p.seen, p.cbuf, p.blocks, p.failto, p.pbuf)
end

fn with_code_jumps(p: prog, code: bytes, jumps: list fixup) -> prog
  return spawn(code, p.pool, p.nconst, p.strs, p.funcs, jumps, p.marks, p.imap, p.bmap, p.smap, p.fnames, p.arity, p.slots, p.unwind, p.main_off, p.main_slots, p.saw_main, p.live, p.start, p.nparams, p.is_main, p.seen, p.cbuf, p.blocks, p.failto, p.pbuf)
end

fn with_pool_i(p: prog, pbuf: buf, nconst: i64, imap: map i64 i64) -> prog
  return spawn(p.code, p.pool, nconst, p.strs, p.funcs, p.jumps, p.marks, imap, p.bmap, p.smap, p.fnames, p.arity, p.slots, p.unwind, p.main_off, p.main_slots, p.saw_main, p.live, p.start, p.nparams, p.is_main, p.seen, p.cbuf, p.blocks, p.failto, pbuf)
end

fn with_pool_b(p: prog, pbuf: buf, nconst: i64, strs: bytes, bmap: map bytes i64, smap: map bytes i64) -> prog
  return spawn(p.code, p.pool, nconst, strs, p.funcs, p.jumps, p.marks, p.imap, bmap, smap, p.fnames, p.arity, p.slots, p.unwind, p.main_off, p.main_slots, p.saw_main, p.live, p.start, p.nparams, p.is_main, p.seen, p.cbuf, p.blocks, p.failto, pbuf)
end


fn fresh(fnames: map bytes i64, arity: map bytes i64) -> prog
  let jumps: list fixup = list()
  let marks: map bytes i64 = map()
  let imap: map i64 i64 = map()
  let bmap: map bytes i64 = map()
  let smap: map bytes i64 = map()
  let slots: map bytes i64 = map()
  let blocks: list block = list()
  set bmap = put(bmap, "\n", 0)
  return spawn("", "", 0, "\n", "", jumps, marks, imap, bmap, smap, fnames, arity, slots, "", 0, 0, 0, 0, 0, 0, 0, 0, bnew(), blocks, "", bnew())
end

fn enter_fn(p: prog, name: bytes, slots: map bytes i64) -> prog
  let nparams = get(p.arity, name) else fail "missing fn"
  let is_main = eqb(name, "main")
  let unwind = "u" ++ p.seen
  let blocks: list block = list()
  return spawn(p.code, p.pool, p.nconst, p.strs, p.funcs, p.jumps, p.marks, p.imap, p.bmap, p.smap, p.fnames, p.arity, slots, unwind, p.main_off, p.main_slots, p.saw_main, 1, p.cbuf.count, nparams, is_main, p.seen, p.cbuf, blocks, unwind, p.pbuf)
end

fn close_fn(p: prog) -> prog
  if len(p.blocks) != 0
    fail "unclosed block"
  end
  let cur = p
  if p.is_main != 0
    set cur = take_code(cur, byte(0))
  end
  let marks = put(cur.marks, cur.unwind, cur.cbuf.count)
  set cur = take_code(cur, byte(29))
  if cur.is_main != 0
    set cur = take_code(cur, byte(2))
  end
  if cur.is_main == 0
    set cur = take_code(cur, byte(32))
  end
  let nlocals = len(cur.slots)
  let funcs = cur.funcs ++ q8(cur.start) ++ q8(cur.nparams) ++ q8(nlocals)
  let main_off = cur.main_off
  let main_slots = cur.main_slots
  let saw = cur.saw_main
  if cur.is_main != 0
    set main_off = cur.start
    set main_slots = nlocals
    set saw = 1
  end
  return spawn(p.code, p.pool, p.nconst, p.strs, funcs, p.jumps, marks, p.imap, p.bmap, p.smap, p.fnames, p.arity, p.slots, p.unwind, main_off, main_slots, saw, 0, p.start, p.nparams, p.is_main, cur.seen + 1 else fail "math", cur.cbuf, cur.blocks, cur.failto, cur.pbuf)
end

fn take_code(p: prog, extra: bytes) -> prog
  return with_cbuf(p, badd(p.cbuf, extra))
end

fn finish_code(p: prog) -> prog
  return with_code(p, bfinish(p.cbuf))
end

fn emit_iffail(p: prog) -> prog
  let slot = p.cbuf.count + 1 else fail "math"
  let jumps = push(p.jumps, fixup(slot, p.failto))
  let marked = with_jumps(p, jumps)
  return take_code(marked, byte(11) ++ byte(0) ++ byte(0) ++ byte(0) ++ byte(0))
end

fn emit_pop_slot(p: prog, slot: i64) -> prog
  return take_code(p, byte(6) ++ u16(slot))
end

fn emit_push_slot(p: prog, slot: i64) -> prog
  return take_code(p, byte(7) ++ u16(slot))
end

fn intern_i64(p: prog, n: i64) -> prog
  if has(p.imap, n)
    return p
  end
  let rec = pool_rec(0, n, 0, 0)
  let pbuf = bpush(p.pbuf, rec)
  let imap = put(p.imap, n, p.nconst)
  return with_pool_i(p, pbuf, p.nconst + 1 else fail "math", imap)
end

fn push_i64(p: prog, n: i64) -> prog
  let q = intern_i64(p, n)
  let idx = get(q.imap, n) else fail "const"
  return take_code(q, byte(5) ++ u16(idx))
end

fn intern_bytes(p: prog, data: bytes) -> prog
  if has(p.smap, data)
    return p
  end
  let off = 0
  let strs = p.strs
  let bmap = p.bmap
  if has(p.bmap, data)
    set off = get(p.bmap, data) else fail "const"
  else
    set off = len(p.strs)
    set strs = p.strs ++ data
    set bmap = put(p.bmap, data, off)
  end
  let rec = pool_rec(257, off, len(data), 0)
  let pbuf = bpush(p.pbuf, rec)
  let smap = put(p.smap, data, p.nconst)
  return with_pool_b(p, pbuf, p.nconst + 1 else fail "math", strs, bmap, smap)
end

fn push_bytes(p: prog, data: bytes) -> prog
  let q = intern_bytes(p, data)
  let idx = get(q.smap, data) else fail "const"
  return take_code(q, byte(5) ++ u16(idx))
end

fn slot_index(raw: i64) -> i64
  if raw >= 1024
    let kind = raw / 1024 else fail "math"
    return raw - kind * 1024 else fail "math"
  end
  return raw
end

fn slot_kind(raw: i64) -> i64
  if raw >= 1024
    return raw / 1024 else fail "math"
  end
  return 1
end

fn pack_slot(index: i64, kind: i64) -> i64
  let scaled = kind * 1024 else fail "math"
  return index + scaled else fail "math"
end

fn push_local(p: prog, name: bytes) -> prog
  if has(p.slots, name) == 0
    fail "unknown name"
  end
  let raw = get(p.slots, name) else fail "unknown name"
  let slot = slot_index(raw)
  return take_code(p, byte(7) ++ u16(slot))
end

fn do_dec(cur: parsed) -> parsed
  return parsed(take_code(cur.prog, byte(34)), cur.pos, 2)
end

fn emit_add(p: prog) -> prog
  return emit_iffail(take_code(p, byte(13)))
end

fn emit_cat(p: prog) -> prog
  return take_code(p, byte(19))
end

fn parse_atom(p: prog, toks: list tok, pos: i64) -> parsed
  if pos >= len(toks)
    fail "expected expression"
  end
  let kind = at(toks, pos).kind
  if kind == 2
    let nxt = push_i64(p, at(toks, pos).num)
    return parsed(nxt, pos + 1 else fail "math", 1)
  end
  if kind == 3
    let nxt2 = push_bytes(p, at(toks, pos).text)
    return parsed(nxt2, pos + 1 else fail "math", 2)
  end
  if kind == 6
    let inner = parse_expr(p, toks, pos + 1 else fail "math")
    if tok_is(toks, inner.pos, 7) == 0
      fail "expected )"
    end
    return parsed(inner.prog, inner.pos + 1 else fail "math", inner.kind)
  end
  if kind == 1
    if eqb(at(toks, pos).text, "fail")
      return parse_fail_expr(p, toks, pos)
    end
    if eqb(at(toks, pos).text, "reason")
      return parsed(take_code(p, byte(29)), pos + 1 else fail "math", 2)
    end
    if tok_is(toks, pos + 1 else fail "math", 6)
      return parse_call(p, toks, pos)
    end
    let nxt3 = push_local(p, at(toks, pos).text)
    let raw = get(p.slots, at(toks, pos).text) else fail "unknown name"
    let sk = slot_kind(raw)
    if tok_is(toks, pos + 1 else fail "math", 19) == 0
      return parsed(nxt3, pos + 1 else fail "math", sk)
    end
    if sk != 3
      fail "field"
    end
    if tok_is(toks, pos + 2 else fail "math", 1) == 0
      fail "field"
    end
    let field = at(toks, pos + 2 else fail "math").text
    if eqb(field, "text")
      return parsed(take_code(nxt3, byte(28)), pos + 3 else fail "math", 2)
    end
    if eqb(field, "n")
      return parsed(take_code(nxt3, byte(27)), pos + 3 else fail "math", 1)
    end
    fail "field"
    return parsed(nxt3, pos, 0)
  end
  fail "bad expression"
  return parsed(p, pos, 0)
end

fn parse_argc(p: prog, toks: list tok, pos: i64) -> parsed
  if tok_is(toks, pos + 1 else fail "math", 6) == 0
    fail "expected ("
  end
  if tok_is(toks, pos + 2 else fail "math", 7) == 0
    fail "arity"
  end
  return parsed(take_code(p, byte(21)), pos + 3 else fail "math", 1)
end

fn parse_one(p: prog, toks: list tok, pos: i64, want: i64, op: i64, outk: i64) -> parsed
  if tok_is(toks, pos + 1 else fail "math", 6) == 0
    fail "expected ("
  end
  let cur = parse_expr(p, toks, pos + 2 else fail "math")
  if cur.kind != want
    fail "type"
  end
  if tok_is(toks, cur.pos, 7) == 0
    fail "expected )"
  end
  let done = emit_iffail(take_code(cur.prog, byte(op)))
  return parsed(done, cur.pos + 1 else fail "math", outk)
end

fn parse_arg(p: prog, toks: list tok, pos: i64) -> parsed
  return parse_one(p, toks, pos, 1, 22, 2)
end

fn parse_i64_call(p: prog, toks: list tok, pos: i64) -> parsed
  return parse_one(p, toks, pos, 2, 20, 1)
end

fn parse_len(p: prog, toks: list tok, pos: i64) -> parsed
  return parse_one(p, toks, pos, 2, 25, 1)
end

fn parse_open(p: prog, toks: list tok, pos: i64) -> parsed
  if tok_is(toks, pos + 1 else fail "math", 6) == 0
    fail "expected ("
  end
  let a1 = parse_expr(p, toks, pos + 2 else fail "math")
  if a1.kind != 2
    fail "type"
  end
  if tok_is(toks, a1.pos, 8) == 0
    fail "expected ,"
  end
  let a2 = parse_expr(a1.prog, toks, a1.pos + 1 else fail "math")
  if a2.kind != 1
    fail "type"
  end
  if tok_is(toks, a2.pos, 8) == 0
    fail "expected ,"
  end
  let a3 = parse_expr(a2.prog, toks, a2.pos + 1 else fail "math")
  if a3.kind != 2
    fail "type"
  end
  if tok_is(toks, a3.pos, 8) == 0
    fail "expected ,"
  end
  let a4 = parse_expr(a3.prog, toks, a3.pos + 1 else fail "math")
  if a4.kind != 2
    fail "type"
  end
  if tok_is(toks, a4.pos, 8) == 0
    fail "expected ,"
  end
  let a5 = parse_expr(a4.prog, toks, a4.pos + 1 else fail "math")
  if a5.kind != 2
    fail "type"
  end
  if tok_is(toks, a5.pos, 7) == 0
    fail "expected )"
  end
  let done = emit_iffail(take_code(a5.prog, byte(23)))
  return parsed(done, a5.pos + 1 else fail "math", 2)
end

fn parse_call(p: prog, toks: list tok, pos: i64) -> parsed
  let name = at(toks, pos).text
  if eqb(name, "argc")
    return parse_argc(p, toks, pos)
  end
  if eqb(name, "arg")
    return parse_arg(p, toks, pos)
  end
  if eqb(name, "open")
    return parse_open(p, toks, pos)
  end
  if eqb(name, "i64")
    return parse_i64_call(p, toks, pos)
  end
  if eqb(name, "len")
    return parse_len(p, toks, pos)
  end
  if eqb(name, "before")
    return parse_pair(p, toks, pos, 35, 2)
  end
  if eqb(name, "after")
    return parse_pair(p, toks, pos, 36, 2)
  end
  if eqb(name, "holds")
    return parse_pair(p, toks, pos, 37, 1)
  end
  if has(p.fnames, name) == 0
    fail "unknown function"
  end
  let want = get(p.arity, name) else fail "arity"
  let i = pos + 2 else fail "math"
  let cur = parsed(p, i, 1)
  let got = 0
  if tok_is(toks, i, 7)
    set i = i + 1 else fail "math"
  else
    set cur = parse_expr(p, toks, i)
    set got = 1
    set i = cur.pos
    while tok_is(toks, i, 8)
      set cur = parse_expr(cur.prog, toks, i + 1 else fail "math")
      set got = got + 1 else fail "math"
      set i = cur.pos
    end
    if tok_is(toks, i, 7) == 0
      fail "expected )"
    end
    set i = i + 1 else fail "math"
  end
  if got != want
    fail "arity"
  end
  let idx = get(p.fnames, name) else fail "unknown function"
  let called = take_code(cur.prog, byte(30) ++ u16(idx))
  let failed = emit_iffail(called)
  return parsed(failed, i, 1)
end

fn parse_pair(p: prog, toks: list tok, pos: i64, op: i64, outk: i64) -> parsed
  if tok_is(toks, pos + 1 else fail "math", 6) == 0
    fail "expected ("
  end
  let a1 = parse_expr(p, toks, pos + 2 else fail "math")
  if a1.kind != 2
    fail "type"
  end
  if tok_is(toks, a1.pos, 8) == 0
    fail "expected ,"
  end
  let a2 = parse_expr(a1.prog, toks, a1.pos + 1 else fail "math")
  if a2.kind != 2
    fail "type"
  end
  if tok_is(toks, a2.pos, 7) == 0
    fail "expected )"
  end
  let done = emit_iffail(take_code(a2.prog, byte(op)))
  return parsed(done, a2.pos + 1 else fail "math", outk)
end

fn product_op(toks: list tok, pos: i64) -> i64
  if tok_is(toks, pos, 21)
    return 15
  end
  if tok_is(toks, pos, 20)
    return 16
  end
  return 0
end

fn parse_product(p: prog, toks: list tok, pos: i64) -> parsed
  let cur = parse_atom(p, toks, pos)
  let op = product_op(toks, cur.pos)
  while op != 0
    if cur.kind != 1
      fail "type"
    end
    let right = parse_atom(cur.prog, toks, cur.pos + 1 else fail "math")
    if right.kind != 1
      fail "type"
    end
    let done = emit_iffail(take_code(right.prog, byte(op)))
    set cur = parsed(done, right.pos, 1)
    set op = product_op(toks, cur.pos)
  end
  return cur
end

fn parse_sum(p: prog, toks: list tok, pos: i64) -> parsed
  let cur = parse_product(p, toks, pos)
  while tok_is(toks, cur.pos, 4)
    if cur.kind != 1
      fail "type"
    end
    let right = parse_product(cur.prog, toks, cur.pos + 1 else fail "math")
    if right.kind != 1
      fail "type"
    end
    let added = emit_add(right.prog)
    set cur = parsed(added, right.pos, 1)
  end
  return cur
end


fn emit_return(p: prog, toks: list tok) -> prog
  let cur = parse_expr(p, toks, 1)
  if cur.pos != len(toks)
    fail "extra tokens"
  end
  return take_code(cur.prog, byte(31))
end

fn emit_write(p: prog, toks: list tok) -> prog
  let cur = parse_expr(p, toks, 1)
  if cur.pos != len(toks)
    fail "extra tokens"
  end
  let outp = cur
  if cur.kind == 1
    set outp = do_dec(cur)
  end
  return take_code(outp.prog, byte(1))
end

fn bind_params(toks: list tok) -> map bytes i64
  let slots: map bytes i64 = map()
  let i = 0
  let n = len(toks)
  let slot = 0
  while i < n
    if at(toks, i).kind == 9
      let name = at(toks, i - 1 else fail "math").text
      let type_at = i + 1 else fail "math"
      if type_at >= n
        fail "type"
      end
      if at(toks, type_at).kind != 1
        fail "type"
      end
      let type_name = at(toks, type_at).text
      let sk = 0
      if eqb(type_name, "i64")
        set sk = 1
      end
      if eqb(type_name, "bytes")
        set sk = 2
      end
      if sk == 0
        fail "type"
      end
      set slots = put(slots, name, pack_slot(slot, sk))
      set slot = slot + 1 else fail "math"
    end
    set i = i + 1 else fail "math"
  end
  return slots
end

fn with_marks(p: prog, marks: map bytes i64) -> prog
  return spawn(p.code, p.pool, p.nconst, p.strs, p.funcs, p.jumps, marks, p.imap, p.bmap, p.smap, p.fnames, p.arity, p.slots, p.unwind, p.main_off, p.main_slots, p.saw_main, p.live, p.start, p.nparams, p.is_main, p.seen, p.cbuf, p.blocks, p.failto, p.pbuf)
end

fn with_slots(p: prog, slots: map bytes i64) -> prog
  return spawn(p.code, p.pool, p.nconst, p.strs, p.funcs, p.jumps, p.marks, p.imap, p.bmap, p.smap, p.fnames, p.arity, slots, p.unwind, p.main_off, p.main_slots, p.saw_main, p.live, p.start, p.nparams, p.is_main, p.seen, p.cbuf, p.blocks, p.failto, p.pbuf)
end

fn with_seen(p: prog, seen: i64) -> prog
  return spawn(p.code, p.pool, p.nconst, p.strs, p.funcs, p.jumps, p.marks, p.imap, p.bmap, p.smap, p.fnames, p.arity, p.slots, p.unwind, p.main_off, p.main_slots, p.saw_main, p.live, p.start, p.nparams, p.is_main, seen, p.cbuf, p.blocks, p.failto, p.pbuf)
end

fn with_failto(p: prog, failto: bytes) -> prog
  return spawn(p.code, p.pool, p.nconst, p.strs, p.funcs, p.jumps, p.marks, p.imap, p.bmap, p.smap, p.fnames, p.arity, p.slots, p.unwind, p.main_off, p.main_slots, p.saw_main, p.live, p.start, p.nparams, p.is_main, p.seen, p.cbuf, p.blocks, failto, p.pbuf)
end

fn with_blocks(p: prog, blocks: list block) -> prog
  return spawn(p.code, p.pool, p.nconst, p.strs, p.funcs, p.jumps, p.marks, p.imap, p.bmap, p.smap, p.fnames, p.arity, p.slots, p.unwind, p.main_off, p.main_slots, p.saw_main, p.live, p.start, p.nparams, p.is_main, p.seen, p.cbuf, blocks, p.failto, p.pbuf)
end

fn drop_last(xs: list block) -> list block
  let out: list block = list()
  let i = 0
  let n = len(xs) - 1 else fail "math"
  while i < n
    set out = push(out, at(xs, i) else fail "block")
    set i = i + 1 else fail "math"
  end
  return out
end

fn emit_rel(p: prog, op: i64, name: bytes) -> prog
  let slot = p.cbuf.count + 1 else fail "math"
  let jumps = push(p.jumps, fixup(slot, name))
  let marked = with_jumps(p, jumps)
  return take_code(marked, byte(op) ++ byte(0) ++ byte(0) ++ byte(0) ++ byte(0))
end

fn mark_prog(p: prog, name: bytes) -> prog
  return with_marks(p, put(p.marks, name, p.cbuf.count))
end

fn has_else(toks: list tok, pos: i64) -> i64
  let i = pos
  let depth = 0
  let n = len(toks)
  while i < n
    let k = at(toks, i).kind else fail "token"
    if k == 6
      set depth = depth + 1 else fail "math"
    end
    if k == 7
      set depth = depth - 1 else fail "math"
    end
    if depth == 0
      if k == 1
        if eqb(at(toks, i).text, "else")
          return i
        end
      end
    end
    set i = i + 1 else fail "math"
  end
  return -1
end

fn parse_fail_expr(p: prog, toks: list tok, pos: i64) -> parsed
  let msg = parse_concat(p, toks, pos + 1 else fail "math")
  let shown = msg
  if msg.kind == 1
    set shown = do_dec(msg)
  end
  let op = 32
  if p.is_main != 0
    set op = 2
  end
  return parsed(take_code(shown.prog, byte(op)), shown.pos, 0)
end

fn parse_cmp(p: prog, toks: list tok, pos: i64) -> parsed
  let cur = parse_sum(p, toks, pos)
  let k = 0
  if cur.pos < len(toks)
    set k = at(toks, cur.pos).kind
  end
  if k < 13
    return cur
  end
  if k > 18
    return cur
  end
  let right = parse_sum(cur.prog, toks, cur.pos + 1 else fail "math")
  let code = k - 13 else fail "math"
  let cmpd = take_code(right.prog, byte(18) ++ byte(code))
  return parsed(cmpd, right.pos, 1)
end

fn parse_concat(p: prog, toks: list tok, pos: i64) -> parsed
  let cur = parse_cmp(p, toks, pos)
  while tok_is(toks, cur.pos, 5)
    if cur.kind == 1
      set cur = do_dec(cur)
    end
    let right = parse_cmp(cur.prog, toks, cur.pos + 1 else fail "math")
    let rhs = right
    if right.kind == 1
      set rhs = do_dec(right)
    end
    let cat = emit_cat(rhs.prog)
    set cur = parsed(cat, rhs.pos, 2)
  end
  return cur
end

fn parse_expr(p: prog, toks: list tok, pos: i64) -> parsed
  let at_else = has_else(toks, pos)
  if at_else < 0
    return parse_concat(p, toks, pos)
  end
  let cleared = take_code(p, byte(12))
  let n = cleared.seen + 1 else fail "math"
  let alt = "a" ++ n
  let done = "d" ++ n
  let saved = cleared.failto
  let armed = with_failto(with_seen(cleared, n), alt)
  let left = parse_concat(armed, toks, pos)
  if left.pos != at_else
    fail "bad else"
  end
  let jumped = emit_rel(left.prog, 8, done)
  let marked = mark_prog(jumped, alt)
  let restored = with_failto(marked, saved)
  let again = take_code(restored, byte(12))
  let right = parse_expr(again, toks, at_else + 1 else fail "math")
  let finished = mark_prog(right.prog, done)
  let kind = left.kind
  if kind == 0
    set kind = right.kind
  end
  if right.kind != 0
    if left.kind != 0
      if left.kind != right.kind
        fail "type"
      end
    end
  end
  return parsed(finished, right.pos, kind)
end

fn emit_let(p: prog, toks: list tok) -> prog
  if len(toks) < 4
    fail "expected a name"
  end
  if at(toks, 1).kind != 1
    fail "expected a name"
  end
  if at(toks, 2).kind != 12
    fail "expected ="
  end
  let name = at(toks, 1).text
  if has(p.slots, name)
    fail "already bound"
  end
  let cur = parse_expr(p, toks, 3)
  if cur.pos != len(toks)
    fail "extra tokens"
  end
  if cur.kind == 0
    fail "let needs a value"
  end
  let slot = len(p.slots)
  let slots = put(cur.prog.slots, name, pack_slot(slot, cur.kind))
  let bound = with_slots(cur.prog, slots)
  return take_code(bound, byte(6) ++ u16(slot))
end

fn emit_append(p: prog, toks: list tok, name: bytes, slot: i64) -> prog
  if len(toks) < 5
    return p
  end
  if at(toks, 3).kind != 1
    return p
  end
  if eqb(at(toks, 3).text, name) == 0
    return p
  end
  if at(toks, 4).kind != 5
    return p
  end
  if has_else(toks, 3) >= 0
    return p
  end
  let rhs = parse_expr(p, toks, 5)
  if rhs.pos != len(toks)
    fail "extra tokens"
  end
  if rhs.kind == 0
    fail "set needs a value"
  end
  let right = rhs
  if rhs.kind == 1
    set right = do_dec(rhs)
  end
  let slots = put(right.prog.slots, name, pack_slot(slot, 2))
  let bound = with_slots(right.prog, slots)
  return take_code(bound, byte(33) ++ u16(slot))
end

fn emit_set(p: prog, toks: list tok) -> prog
  if len(toks) < 4
    fail "expected a name"
  end
  if at(toks, 1).kind != 1
    fail "expected a name"
  end
  if at(toks, 2).kind != 12
    fail "expected ="
  end
  let name = at(toks, 1).text
  if has(p.slots, name) == 0
    fail "unknown name"
  end
  let raw = get(p.slots, name) else fail "unknown name"
  let slot = slot_index(raw)
  if slot < p.nparams
    fail "parameter"
  end
  if slot_kind(raw) == 2
    let appended = emit_append(p, toks, name, slot)
    if appended.cbuf.count != p.cbuf.count
      return appended
    end
  end
  let cur = parse_expr(p, toks, 3)
  if cur.pos != len(toks)
    fail "extra tokens"
  end
  if cur.kind == 0
    fail "set needs a value"
  end
  let slots = put(cur.prog.slots, name, pack_slot(slot, cur.kind))
  let bound = with_slots(cur.prog, slots)
  return take_code(bound, byte(6) ++ u16(slot))
end

fn emit_if(p: prog, toks: list tok) -> prog
  let cur = parse_expr(p, toks, 1)
  if cur.pos != len(toks)
    fail "extra tokens"
  end
  if cur.kind != 1
    fail "if needs an i64"
  end
  let n = cur.prog.seen + 1 else fail "math"
  let alt = "a" ++ n
  let done = "d" ++ n
  let jumped = emit_rel(with_seen(cur.prog, n), 9, alt)
  let blocks = push(jumped.blocks, block(1, alt, done))
  return with_blocks(jumped, blocks)
end

fn emit_while(p: prog, toks: list tok) -> prog
  let n = p.seen + 1 else fail "math"
  let head = "h" ++ n
  let done = "d" ++ n
  let marked = mark_prog(with_seen(p, n), head)
  let cur = parse_expr(marked, toks, 1)
  if cur.pos != len(toks)
    fail "extra tokens"
  end
  if cur.kind != 1
    fail "while needs an i64"
  end
  let jumped = emit_rel(cur.prog, 9, done)
  let blocks = push(jumped.blocks, block(2, head, done))
  return with_blocks(jumped, blocks)
end

fn emit_else(p: prog, toks: list tok) -> prog
  if len(toks) != 1
    fail "extra tokens"
  end
  if len(p.blocks) == 0
    fail "else"
  end
  let n = len(p.blocks) - 1 else fail "math"
  let top = at(p.blocks, n) else fail "else"
  if top.kind != 1
    fail "else"
  end
  let jumped = emit_rel(p, 8, top.done)
  let marked = mark_prog(jumped, top.alt)
  let rest = drop_last(marked.blocks)
  let blocks = push(rest, block(3, top.alt, top.done))
  return with_blocks(marked, blocks)
end

fn emit_fail_stmt(p: prog, toks: list tok) -> prog
  let cur = parse_fail_expr(p, toks, 0)
  if cur.pos != len(toks)
    fail "extra tokens"
  end
  return cur.prog
end

fn end_stmt(p: prog) -> prog
  if len(p.blocks) == 0
    return close_fn(p)
  end
  let n = len(p.blocks) - 1 else fail "math"
  let top = at(p.blocks, n) else fail "block"
  let rest = drop_last(p.blocks)
  if top.kind == 1
    return with_blocks(mark_prog(p, top.alt), rest)
  end
  if top.kind == 3
    return with_blocks(mark_prog(p, top.done), rest)
  end
  if top.kind == 2
    let jumped = emit_rel(p, 8, top.alt)
    return with_blocks(mark_prog(jumped, top.done), rest)
  end
  if top.kind == 4
    let tail = after(top.done, "n") else fail "block"
    let numtext = before(tail, "x") else fail "block"
    let number_slot = i64(numtext) else fail "block"
    let pushed = emit_push_slot(p, number_slot)
    let one = push_i64(pushed, 1)
    let added = emit_add(one)
    let popped = emit_pop_slot(added, number_slot)
    let jumped = emit_rel(popped, 8, top.alt)
    return with_blocks(mark_prog(jumped, top.done), rest)
  end
  if top.kind == 5
    let tail = after(top.done, "m") else fail "block"
    let numtext = before(tail, "z") else fail "block"
    let index_slot = i64(numtext) else fail "block"
    let pushed = emit_push_slot(p, index_slot)
    let one = push_i64(pushed, 1)
    let added = emit_add(one)
    let popped = emit_pop_slot(added, index_slot)
    let jumped = emit_rel(popped, 8, top.alt)
    return with_blocks(mark_prog(jumped, top.done), rest)
  end
  fail "block"
  return p
end

fn emit_for_bytes(p: prog, toks: list tok) -> prog
  if len(toks) < 6
    fail "expected a name"
  end
  if at(toks, 1).kind != 1
    fail "expected a name"
  end
  if at(toks, 2).kind != 1
    fail "expected in"
  end
  if eqb(at(toks, 2).text, "in") == 0
    fail "expected in"
  end
  if at(toks, 3).kind != 1
    fail "for needs bytes"
  end
  if eqb(at(toks, 3).text, "bytes") == 0
    fail "for needs bytes"
  end
  if at(toks, 4).kind != 6
    fail "expected ("
  end
  let name = at(toks, 1).text
  if has(p.slots, name)
    fail "already bound"
  end
  let cur = parse_expr(p, toks, 5)
  if cur.kind != 2
    fail "bytes needs bytes"
  end
  if tok_is(toks, cur.pos, 7) == 0
    fail "expected )"
  end
  let endp = cur.pos + 1 else fail "math"
  if endp != len(toks)
    fail "extra tokens"
  end
  let base = len(cur.prog.slots)
  let text_slot = base
  let index_slot = base + 1 else fail "math"
  let byte_slot = base + 2 else fail "math"
  let n = cur.prog.seen + 1 else fail "math"
  let loop = "k" ++ n
  let body = "b" ++ n
  let done = "m" ++ index_slot ++ "z" ++ n
  let slots = cur.prog.slots
  set slots = put(slots, byte(1) ++ n ++ "t", pack_slot(text_slot, 2))
  set slots = put(slots, byte(1) ++ n ++ "i", pack_slot(index_slot, 1))
  set slots = put(slots, name, pack_slot(byte_slot, 1))
  let bound = with_slots(with_seen(cur.prog, n), slots)
  let popped = emit_pop_slot(bound, text_slot)
  let zero = push_i64(popped, 0)
  let popz = emit_pop_slot(zero, index_slot)
  let looped = mark_prog(popz, loop)
  let pushed = emit_push_slot(looped, index_slot)
  let pushed2 = emit_push_slot(pushed, text_slot)
  let lengthed = emit_iffail(take_code(pushed2, byte(25)))
  let cmpd = take_code(lengthed, byte(18) ++ byte(5))
  let to_body = emit_rel(cmpd, 9, body)
  let to_done = emit_rel(to_body, 8, done)
  let at_body = mark_prog(to_done, body)
  let ptext = emit_push_slot(at_body, text_slot)
  let pindex = emit_push_slot(ptext, index_slot)
  let viewed = emit_iffail(take_code(pindex, byte(24)))
  let popb = emit_pop_slot(viewed, byte_slot)
  let blocks = push(popb.blocks, block(5, loop, done))
  return with_blocks(popb, blocks)
end

fn emit_for(p: prog, toks: list tok) -> prog
  if len(toks) < 6
    fail "expected a name"
  end
  if at(toks, 1).kind != 1
    fail "expected a name"
  end
  if at(toks, 2).kind != 1
    fail "expected in"
  end
  if eqb(at(toks, 2).text, "in") == 0
    fail "expected in"
  end
  if at(toks, 3).kind != 1
    fail "for needs lines"
  end
  if eqb(at(toks, 3).text, "bytes")
    return emit_for_bytes(p, toks)
  end
  if eqb(at(toks, 3).text, "lines") == 0
    fail "for needs lines"
  end
  if at(toks, 4).kind != 6
    fail "expected ("
  end
  let name = at(toks, 1).text
  if has(p.slots, name)
    fail "already bound"
  end
  let cur = parse_expr(p, toks, 5)
  if cur.kind != 2
    fail "lines needs bytes"
  end
  if tok_is(toks, cur.pos, 7) == 0
    fail "expected )"
  end
  let endp = cur.pos + 1 else fail "math"
  if endp != len(toks)
    fail "extra tokens"
  end
  let base = len(cur.prog.slots)
  let text_slot = base
  let index_slot = base + 1 else fail "math"
  let number_slot = base + 2 else fail "math"
  let line_slot = base + 3 else fail "math"
  let n = cur.prog.seen + 1 else fail "math"
  let loop = "k" ++ n
  let body = "b" ++ n
  let done = "n" ++ number_slot ++ "x" ++ n
  let slots = cur.prog.slots
  set slots = put(slots, byte(1) ++ n ++ "t", pack_slot(text_slot, 2))
  set slots = put(slots, byte(1) ++ n ++ "i", pack_slot(index_slot, 1))
  set slots = put(slots, byte(1) ++ n ++ "u", pack_slot(number_slot, 1))
  set slots = put(slots, name, pack_slot(line_slot, 3))
  let bound = with_slots(with_seen(cur.prog, n), slots)
  let popped = emit_pop_slot(bound, text_slot)
  let zero = push_i64(popped, 0)
  let popz = emit_pop_slot(zero, index_slot)
  let one = push_i64(popz, 1)
  let popn = emit_pop_slot(one, number_slot)
  let looped = mark_prog(popn, loop)
  let pushed = emit_push_slot(looped, index_slot)
  let pushed2 = emit_push_slot(pushed, text_slot)
  let lengthed = emit_iffail(take_code(pushed2, byte(25)))
  let cmpd = take_code(lengthed, byte(18) ++ byte(5))
  let to_body = emit_rel(cmpd, 9, body)
  let to_done = emit_rel(to_body, 8, done)
  let at_body = mark_prog(to_done, body)
  let ptext = emit_push_slot(at_body, text_slot)
  let pindex = emit_push_slot(ptext, index_slot)
  let pnum = emit_push_slot(pindex, number_slot)
  let viewed = emit_iffail(take_code(pnum, byte(26)))
  let popi = emit_pop_slot(viewed, index_slot)
  let popl = emit_pop_slot(popi, line_slot)
  let blocks = push(popl.blocks, block(4, loop, done))
  return with_blocks(popl, blocks)
end


fn on_line(p: prog, text: bytes) -> prog
  let toks = lex(text)
  if len(toks) == 0
    return p
  end
  let head = at(toks, 0).text
  if p.live == 0
    if eqb(head, "fn")
      if len(toks) < 2
        fail "expected a name"
      end
      let name = at(toks, 1).text
      if eqb(name, "main")
        if len(toks) != 2
          fail "main takes no parameters"
        end
      end
      return enter_fn(p, name, bind_params(toks))
    end
    if eqb(head, "phase")
      return p
    end
    if eqb(head, "gauge")
      return p
    end
    fail "expected fn"
    return p
  end
  if eqb(head, "end")
    if len(toks) != 1
      fail "extra tokens"
    end
    return end_stmt(p)
  end
  if eqb(head, "else")
    return emit_else(p, toks)
  end
  if eqb(head, "return")
    return emit_return(p, toks)
  end
  if eqb(head, "write")
    return emit_write(p, toks)
  end
  if eqb(head, "let")
    return emit_let(p, toks)
  end
  if eqb(head, "set")
    return emit_set(p, toks)
  end
  if eqb(head, "if")
    return emit_if(p, toks)
  end
  if eqb(head, "while")
    return emit_while(p, toks)
  end
  if eqb(head, "for")
    return emit_for(p, toks)
  end
  if eqb(head, "fail")
    return emit_fail_stmt(p, toks)
  end
  fail "unsupported statement"
  return p
end

fn patch_code(p: prog) -> prog
  let code = p.code
  for item in p.jumps
    if has(p.marks, item.word) == 0
      fail "missing jump"
    end
    let target = get(p.marks, item.word) else fail "missing jump"
    let rel = target - (item.slot + 4) else fail "math"
    set code = poke(code, item.slot, rel, 4)
  end
  return with_code(p, code)
end

fn compile(text: bytes) -> prog
  let fnames: map bytes i64 = map()
  let arity: map bytes i64 = map()
  let count = 0
  for line in lines(text)
    let toks = lex(line.text)
    if len(toks) > 0
      if eqb(at(toks, 0).text, "fn")
        if len(toks) < 2
          fail "expected a name"
        end
        let name = at(toks, 1).text
        if has(fnames, name)
          fail "duplicate function"
        end
        let slots = bind_params(toks)
        set fnames = put(fnames, name, count)
        set arity = put(arity, name, len(slots))
        set count = count + 1 else fail "math"
      end
    end
  end
  if count == 0
    fail "missing fn"
  end
  let p = fresh(fnames, arity)
  for line in lines(text)
    set p = on_line(p, line.text)
  end
  if p.live != 0
    fail "unclosed fn"
  end
  if p.saw_main == 0
    fail "missing main"
  end
  return patch_code(finish_code(finish_pool(p)))
end

fn bnew() -> buf
  let parts: list bytes = list()
  return buf(parts, "", 0, 0)
end

fn bflush(b: buf) -> buf
  if b.fills == 0
    return b
  end
  return buf(push(b.parts, b.part), "", 0, b.count)
end

fn bpush(b: buf, extra: bytes) -> buf
  if len(extra) == 0
    return b
  end
  let base = bflush(b)
  let count = base.count + len(extra) else fail "math"
  return buf(push(base.parts, extra), "", 0, count)
end

fn finish_pool(p: prog) -> prog
  return spawn(p.code, bfinish(p.pbuf), p.nconst, p.strs, p.funcs, p.jumps, p.marks, p.imap, p.bmap, p.smap, p.fnames, p.arity, p.slots, p.unwind, p.main_off, p.main_slots, p.saw_main, p.live, p.start, p.nparams, p.is_main, p.seen, p.cbuf, p.blocks, p.failto, p.pbuf)
end

fn badd(b: buf, extra: bytes) -> buf
  if len(extra) == 0
    return b
  end
  let part = b.part ++ extra
  let fills = b.fills + 1 else fail "math"
  let count = b.count + len(extra) else fail "math"
  let next = buf(b.parts, part, fills, count)
  if fills >= 8
    return bflush(next)
  end
  return next
end

fn flatten(xs: list bytes) -> bytes
  if len(xs) == 0
    return ""
  end
  if len(xs) == 1
    return at(xs, 0) else fail "chunk"
  end
  let out: list bytes = list()
  let i = 0
  let n = len(xs)
  while i < n
    let left = at(xs, i) else fail "chunk"
    let nxt = i + 1 else fail "math"
    if nxt < n
      let right = at(xs, nxt) else fail "chunk"
      set out = push(out, left ++ right)
      set i = nxt + 1 else fail "math"
    end
    if nxt >= n
      set out = push(out, left)
      set i = n
    end
  end
  return flatten(out)
end

fn bfinish(b: buf) -> bytes
  let parts = b.parts
  if b.fills != 0
    set parts = push(parts, b.part)
  end
  return flatten(parts)
end

fn bwrap(data: bytes) -> buf
  let parts: list bytes = list()
  if len(data) == 0
    return buf(parts, "", 0, 0)
  end
  return buf(parts, data, 1, len(data))
end

fn zeros(n: i64) -> bytes
  if n <= 0
    return ""
  end
  let chunk = byte(0)
  let parts: list bytes = list()
  set parts = push(parts, chunk)
  let grow = len(chunk) + len(chunk) else fail "math"
  while grow <= n
    set chunk = chunk ++ chunk
    set parts = push(parts, chunk)
    set grow = len(chunk) + len(chunk) else fail "math"
  end
  let out = ""
  let left = n
  let i = len(parts) - 1 else fail "math"
  while i >= 0
    let piece = at(parts, i) else fail "chunk"
    if left >= len(piece)
      set out = out ++ piece
      set left = left - len(piece) else fail "math"
    end
    set i = i - 1 else fail "math"
  end
  return out
end

fn bpad(b: buf, boundary: i64) -> buf
  let gap = rem(b.count, boundary)
  if gap == 0
    return b
  end
  let need = boundary - gap else fail "math"
  return badd(b, zeros(need))
end

fn rem(n: i64, m: i64) -> i64
  let q = n / m else fail "math"
  let r = n - q * m else fail "math"
  if r < 0
    return r + m else fail "math"
  end
  return r
end

fn align_up(n: i64, boundary: i64) -> i64
  let sum = n + boundary - 1 else fail "math"
  let q = sum / boundary else fail "math"
  return q * boundary else fail "math"
end

fn pad_align(data: bytes, boundary: i64) -> bytes
  let gap = rem(len(data), boundary)
  if gap == 0
    return data
  end
  let need = boundary - gap else fail "math"
  return data ++ zeros(need)
end

fn poke(data: bytes, off: i64, value: i64, nbytes: i64) -> bytes
  let out = data
  let v = value
  let i = 0
  while i < nbytes
    set out = set_byte(out, off + i else fail "math", low8(v)) else fail "poke"
    set v = asr8(v)
    set i = i + 1 else fail "math"
  end
  return out
end

fn mem_image(p: prog) -> bytes
  let gap = rem(len(p.code), 8)
  let padded = p.code
  if gap != 0
    set padded = p.code ++ zeros(8 - gap else fail "math")
  end
  let pool_off = 512 + len(padded) else fail "math"
  let funcs_off = pool_off + len(p.pool) else fail "math"
  let mem = zeros(512) ++ padded ++ p.pool ++ p.funcs
  set mem = poke(mem, 16, p.main_off, 8)
  set mem = poke(mem, 24, p.main_slots, 8)
  set mem = poke(mem, 104, len(p.code), 8)
  set mem = poke(mem, 208, p.nconst, 8)
  set mem = poke(mem, 216, 512, 8)
  set mem = poke(mem, 224, pool_off, 8)
  set mem = poke(mem, 232, funcs_off, 8)
  return mem
end

fn paint(code: bytes, jumps: list fixup, marks: map bytes i64, bias: i64) -> bytes
  let out = bnew()
  let i = 0
  let n = len(code)
  let j = 0
  let m = len(jumps)
  while i < n
    let slot = -1
    if j < m
      set slot = at(jumps, j).slot else fail "jump"
    end
    if slot == i
      let item = at(jumps, j) else fail "jump"
      if has(marks, item.word) == 0
        fail "missing label"
      end
      let target = get(marks, item.word) else fail "missing label"
      let rel = target - (bias + i + 4) else fail "math"
      set out = badd(out, q4(rel))
      set i = i + 4 else fail "math"
      set j = j + 1 else fail "math"
    else
      let nxt = i + 1 else fail "math"
      let take = 0
      if nxt < n
        if nxt != slot
          set take = 1
        end
      end
      if take == 1
        let lo = at(code, i) else fail "byte"
        let hi = at(code, nxt) else fail "byte"
        let packed = lo + hi * 256 else fail "math"
        set out = badd(out, u16(packed))
        set i = i + 2 else fail "math"
      else
        set out = badd(out, byte(at(code, i) else fail "byte"))
        set i = i + 1 else fail "math"
      end
    end
  end
  if j != m
    fail "missing patch"
  end
  return bfinish(out)
end

fn patch_unit(src: unit) -> unit
  let code = paint(bfinish(src.buf), src.jumps, src.marks, 0)
  return unit(bwrap(code), src.marks, src.jumps, src.rips)
end

fn patch_rips(src: unit, symbols: map bytes i64) -> bytes
  return paint(bfinish(src.buf), src.rips, symbols, 4096)
end

fn place(data: buf, symbols: map bytes i64, name: bytes, raw: bytes, alignment: i64, data_rva: i64) -> placed
  let bufv = bpad(data, alignment)
  let here = bufv.count
  let symbols2 = put(symbols, name, data_rva + here else fail "math")
  return placed(badd(bufv, raw), symbols2, here)
end

fn section(name: bytes, vsize: i64, va: i64, raw_size: i64, raw_ptr: i64, chars: i64) -> bytes
  let out = zeros(40)
  let i = 0
  let n = len(name)
  while i < n
    set out = set_byte(out, i, at(name, i) else fail "poke") else fail "poke"
    set i = i + 1 else fail "math"
  end
  set out = poke(out, 8, vsize, 4)
  set out = poke(out, 12, va, 4)
  set out = poke(out, 16, raw_size, 4)
  set out = poke(out, 20, raw_ptr, 4)
  set out = poke(out, 36, chars, 4)
  return out
end

fn dos_header() -> bytes
  let out = zeros(128)
  set out = set_byte(out, 0, 77) else fail "poke"
  set out = set_byte(out, 1, 90) else fail "poke"
  set out = poke(out, 60, 128, 4)
  return out
end

fn coff_header() -> bytes
  return u16(34404) ++ u16(2) ++ q4(0) ++ q4(0) ++ q4(0) ++ u16(240) ++ u16(35)
end

fn opt_header(text_raw: i64, data_raw: i64, entry_rva: i64, image_size: i64, import_rva: i64, import_size: i64) -> bytes
  let opt = zeros(240)
  set opt = poke(opt, 0, 523, 2)
  set opt = poke(opt, 4, text_raw, 4)
  set opt = poke(opt, 8, data_raw, 4)
  set opt = poke(opt, 16, entry_rva, 4)
  set opt = poke(opt, 20, 4096, 4)
  set opt = poke(opt, 24, 5368709120, 8)
  set opt = poke(opt, 32, 4096, 4)
  set opt = poke(opt, 36, 512, 4)
  set opt = poke(opt, 40, 6, 2)
  set opt = poke(opt, 48, 6, 2)
  set opt = poke(opt, 56, image_size, 4)
  set opt = poke(opt, 60, 512, 4)
  set opt = poke(opt, 68, 3, 2)
  set opt = poke(opt, 70, 256, 2)
  set opt = poke(opt, 72, 1048576, 8)
  set opt = poke(opt, 80, 4096, 8)
  set opt = poke(opt, 88, 1048576, 8)
  set opt = poke(opt, 96, 4096, 8)
  set opt = poke(opt, 108, 16, 4)
  set opt = poke(opt, 120, import_rva, 4)
  set opt = poke(opt, 124, import_size, 4)
  return opt
end

fn pe_image(code: bytes, data: bytes, entry_rva: i64, data_rva: i64, import_rva: i64, import_size: i64) -> bytes
  let text_raw = align_up(len(code), 512)
  let data_raw = align_up(len(data), 512)
  let image_size = align_up(data_rva + len(data) else fail "math", 4096)
  let opt = opt_header(text_raw, data_raw, entry_rva, image_size, import_rva, import_size)
  let data_ptr = 512 + text_raw else fail "math"
  let text_sec = section(".text", len(code), 4096, text_raw, 512, 1610612768)
  let data_sec = section(".data", len(data), data_rva, data_raw, data_ptr, 3221225536)
  let headers = dos_header() ++ byte(80) ++ byte(69) ++ byte(0) ++ byte(0) ++ coff_header() ++ opt ++ text_sec ++ data_sec
  if len(headers) > 512
    fail "headers"
  end
  let file = headers ++ zeros(512 - len(headers) else fail "math") ++ code ++ zeros(text_raw - len(code) else fail "math") ++ data ++ zeros(data_raw - len(data) else fail "math")
  return file
end

fn link_exe(p: prog) -> bytes
  let mem = mem_image(p)
  let asm1 = patch_unit(vessel())
  let data_rva = align_up(4096 + asm1.buf.count else fail "math", 4096)
  let symbols: map bytes i64 = map()
  let data = bnew()
  let s = place(data, symbols, "strs", p.strs, 1, data_rva)
  set s = place(s.data, s.symbols, "zeroch", "0", 1, data_rva)
  set s = place(s.data, s.symbols, "mintext", "-9223372036854775808", 1, data_rva)
  set s = place(s.data, s.symbols, "oommsg", "out of memory\n", 1, data_rva)
  set s = place(s.data, s.symbols, "depthmsg", "call depth\n", 1, data_rva)
  set s = place(s.data, s.symbols, "mem", mem, 8, data_rva)
  let hint0 = byte(0) ++ byte(0)
  set s = place(s.data, s.symbols, "dllname_kernel32.dll", "kernel32.dll" ++ byte(0), 2, data_rva)
  set s = place(s.data, s.symbols, "hint_kernel32.dll_GetStdHandle", hint0 ++ "GetStdHandle" ++ byte(0), 2, data_rva)
  set s = place(s.data, s.symbols, "hint_kernel32.dll_WriteFile", hint0 ++ "WriteFile" ++ byte(0), 2, data_rva)
  set s = place(s.data, s.symbols, "hint_kernel32.dll_ExitProcess", hint0 ++ "ExitProcess" ++ byte(0), 2, data_rva)
  set s = place(s.data, s.symbols, "hint_kernel32.dll_VirtualAlloc", hint0 ++ "VirtualAlloc" ++ byte(0), 2, data_rva)
  set s = place(s.data, s.symbols, "hint_kernel32.dll_GetCommandLineA", hint0 ++ "GetCommandLineA" ++ byte(0), 2, data_rva)
  set s = place(s.data, s.symbols, "hint_kernel32.dll_CreateFileA", hint0 ++ "CreateFileA" ++ byte(0), 2, data_rva)
  set s = place(s.data, s.symbols, "hint_kernel32.dll_ReadFile", hint0 ++ "ReadFile" ++ byte(0), 2, data_rva)
  set s = place(s.data, s.symbols, "hint_kernel32.dll_GetFileSizeEx", hint0 ++ "GetFileSizeEx" ++ byte(0), 2, data_rva)
  set s = place(s.data, s.symbols, "hint_kernel32.dll_CloseHandle", hint0 ++ "CloseHandle" ++ byte(0), 2, data_rva)
  set s = place(s.data, s.symbols, "hint_kernel32.dll_GetFileAttributesA", hint0 ++ "GetFileAttributesA" ++ byte(0), 2, data_rva)
  set data = bpad(s.data, 8)
  set symbols = s.symbols
  let ilt_at = data.count
  set symbols = put(symbols, "ilt_kernel32.dll", data_rva + ilt_at else fail "math")
  let h1 = get(symbols, "hint_kernel32.dll_GetStdHandle") else fail "hint"
  let h2 = get(symbols, "hint_kernel32.dll_WriteFile") else fail "hint"
  let h3 = get(symbols, "hint_kernel32.dll_ExitProcess") else fail "hint"
  let h4 = get(symbols, "hint_kernel32.dll_VirtualAlloc") else fail "hint"
  let h5 = get(symbols, "hint_kernel32.dll_GetCommandLineA") else fail "hint"
  let h6 = get(symbols, "hint_kernel32.dll_CreateFileA") else fail "hint"
  let h7 = get(symbols, "hint_kernel32.dll_ReadFile") else fail "hint"
  let h8 = get(symbols, "hint_kernel32.dll_GetFileSizeEx") else fail "hint"
  let h9 = get(symbols, "hint_kernel32.dll_CloseHandle") else fail "hint"
  let h10 = get(symbols, "hint_kernel32.dll_GetFileAttributesA") else fail "hint"
  set data = badd(data, q8(h1))
  set data = badd(data, q8(h2))
  set data = badd(data, q8(h3))
  set data = badd(data, q8(h4))
  set data = badd(data, q8(h5))
  set data = badd(data, q8(h6))
  set data = badd(data, q8(h7))
  set data = badd(data, q8(h8))
  set data = badd(data, q8(h9))
  set data = badd(data, q8(h10))
  set data = badd(data, q8(0))
  set data = bpad(data, 8)
  let iat_at = data.count
  set symbols = put(symbols, "iat_kernel32.dll", data_rva + iat_at else fail "math")
  set symbols = put(symbols, "iat_kernel32_GetStdHandle", data_rva + data.count else fail "math")
  set data = badd(data, q8(h1))
  set symbols = put(symbols, "iat_kernel32_WriteFile", data_rva + data.count else fail "math")
  set data = badd(data, q8(h2))
  set symbols = put(symbols, "iat_kernel32_ExitProcess", data_rva + data.count else fail "math")
  set data = badd(data, q8(h3))
  set symbols = put(symbols, "iat_kernel32_VirtualAlloc", data_rva + data.count else fail "math")
  set data = badd(data, q8(h4))
  set symbols = put(symbols, "iat_kernel32_GetCommandLineA", data_rva + data.count else fail "math")
  set data = badd(data, q8(h5))
  set symbols = put(symbols, "iat_kernel32_CreateFileA", data_rva + data.count else fail "math")
  set data = badd(data, q8(h6))
  set symbols = put(symbols, "iat_kernel32_ReadFile", data_rva + data.count else fail "math")
  set data = badd(data, q8(h7))
  set symbols = put(symbols, "iat_kernel32_GetFileSizeEx", data_rva + data.count else fail "math")
  set data = badd(data, q8(h8))
  set symbols = put(symbols, "iat_kernel32_CloseHandle", data_rva + data.count else fail "math")
  set data = badd(data, q8(h9))
  set symbols = put(symbols, "iat_kernel32_GetFileAttributesA", data_rva + data.count else fail "math")
  set data = badd(data, q8(h10))
  set data = badd(data, q8(0))
  set data = bpad(data, 4)
  let import_at = data.count
  let ilt = get(symbols, "ilt_kernel32.dll") else fail "ilt"
  let dllr = get(symbols, "dllname_kernel32.dll") else fail "dll"
  let iat = get(symbols, "iat_kernel32.dll") else fail "iat"
  set data = badd(data, q4(ilt) ++ q4(0) ++ q4(0) ++ q4(dllr) ++ q4(iat))
  set data = badd(data, zeros(20))
  let import_rva = data_rva + import_at else fail "math"
  let code = patch_rips(asm1, symbols)
  let entry_off = get(asm1.marks, "start") else fail "missing start"
  let entry_rva = 4096 + entry_off else fail "math"
  return pe_image(code, bfinish(data), entry_rva, data_rva, import_rva, 40)
end

fn main
  if argc() != 3
    fail "usage: compiler source out\n"
  end
  let src = open(arg(1), 1048576, "cannot open ", "", "file too large\n") else fail reason
  let image = link_exe(compile(src))
  let wrote = save(arg(2), image) else fail reason
end
