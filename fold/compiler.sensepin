fn fresh(fnames: buf, arity: buf, sname: map bytes i64, sfld: map bytes i64, nstruct: i64, rets: buf) -> prog
  let slots: map bytes i64 = map()
  let blocks: list block = list()
  let bmap = badd(bnew(), q8(0) ++ u16(1) ++ "\n")
  return spawn("", "", 0, badd(bnew(), "\n"), bnew(), bnew(), bnew(), "", bmap, bnew(), fnames, arity, slots, "", 0, 0, 0, 0, 0, 0, 0, 0, bnew(), blocks, "", bnew(), sname, sfld, nstruct, "", 0, rets)
end

fn enter_fn(p: prog, name: bytes, slots: map bytes i64) -> prog
  let nparams = seek_buf(p.cold.pack.arity, name)
  if nparams < 0
    fail "missing fn"
  end
  let is_main = eqb(name, "main")
  let unwind = "u" ++ p.cold.seen
  let blocks: list block = list()
  return spawn(p.cold.pack.code, p.cold.pack.pool, p.cold.pack.nconst, p.cold.pack.strs, p.cold.pack.funcs, p.jumps, p.cold.marks, p.cold.pack.imap, p.cold.pack.bmap, p.cold.pack.smap, p.cold.pack.fnames, p.cold.pack.arity, slots, unwind, p.cold.pack.main_off, p.cold.pack.main_slots, p.cold.pack.saw_main, 1, p.count, nparams, is_main, p.cold.seen, as_buf(p), blocks, unwind, p.cold.pack.pbuf, p.cold.pack.sname, p.cold.pack.sfld, p.cold.pack.nstruct, p.cold.pack.building, p.cold.pack.nfield, p.cold.pack.rets)
end

fn close_fn(p: prog) -> prog
  if len(p.cold.blocks) != 0
    fail "unclosed block"
  end
  let cur = p
  if p.cold.pack.is_main != 0
    set cur = take_code(cur, byte(0))
  end
  let marks = note(cur.cold.marks, cur.count, cur.cold.pack.unwind)
  set cur = take_code(cur, byte(29))
  if cur.cold.pack.is_main != 0
    set cur = take_code(cur, byte(2))
  end
  if cur.cold.pack.is_main == 0
    set cur = take_code(cur, byte(32))
  end
  let nlocals = len(cur.cold.slots)
  let rec = q8(cur.cold.pack.start) ++ q8(cur.cold.pack.nparams) ++ q8(nlocals)
  let funcs = badd(cur.cold.pack.funcs, rec)
  let main_off = cur.cold.pack.main_off
  let main_slots = cur.cold.pack.main_slots
  let saw = cur.cold.pack.saw_main
  if cur.cold.pack.is_main != 0
    set main_off = cur.cold.pack.start
    set main_slots = nlocals
    set saw = 1
  end
  return spawn(p.cold.pack.code, p.cold.pack.pool, p.cold.pack.nconst, p.cold.pack.strs, funcs, p.jumps, marks, p.cold.pack.imap, p.cold.pack.bmap, p.cold.pack.smap, p.cold.pack.fnames, p.cold.pack.arity, p.cold.slots, p.cold.pack.unwind, main_off, main_slots, saw, 0, p.cold.pack.start, p.cold.pack.nparams, p.cold.pack.is_main, cur.cold.seen + 1 else fail "math", as_buf(cur), cur.cold.blocks, cur.cold.failto, cur.cold.pack.pbuf, cur.cold.pack.sname, cur.cold.pack.sfld, cur.cold.pack.nstruct, cur.cold.pack.building, cur.cold.pack.nfield, cur.cold.pack.rets)
end

fn as_buf(p: prog) -> buf
  return buf(p.cold.parts, p.part, p.fills, p.count, p.mid, p.mfills)
end

fn cold_parts(h: cold, parts: list bytes) -> cold
  return cold(h.pack, h.marks, h.slots, h.seen, parts, h.blocks, h.failto)
end

fn tack(p: prog, jumps: buf, extra: bytes) -> prog
  if len(extra) == 0
    return prog(p.part, p.fills, p.count, jumps, p.cold, p.mid, p.mfills)
  end
  let part = p.part ++ extra
  let fills = p.fills + 1 else fail "math"
  let count = p.count + len(extra) else fail "math"
  if fills >= 8
    let mid = p.mid ++ part
    let mf = p.mfills + 1 else fail "math"
    if mf >= 8
      let parts = push(p.cold.parts, mid)
      let held = cold_parts(p.cold, parts)
      return prog("", 0, count, jumps, held, "", 0)
    end
    return prog("", 0, count, jumps, p.cold, mid, mf)
  end
  return prog(part, fills, count, jumps, p.cold, p.mid, p.mfills)
end

fn take_code(p: prog, extra: bytes) -> prog
  if len(extra) == 0
    return p
  end
  return tack(p, p.jumps, extra)
end

fn finish_code(p: prog) -> prog
  return with_code(p, bfinish(as_buf(p)))
end

fn emit_iffail(p: prog) -> prog
  let slot = p.count + 1 else fail "math"
  let jumps = note(p.jumps, slot, p.cold.failto)
  return tack(p, jumps, byte(11) ++ byte(0) ++ byte(0) ++ byte(0) ++ byte(0))
end

fn emit_pop_slot(p: prog, slot: i64) -> prog
  return take_code(p, byte(6) ++ u16(slot))
end

fn emit_push_slot(p: prog, slot: i64) -> prog
  return take_code(p, byte(7) ++ u16(slot))
end

fn intern_i64(p: prog, n: i64) -> prog
  if seek_i64(p.cold.pack.imap, n) >= 0
    return p
  end
  let rec = pool_rec(0, n, 0, 0)
  let pbuf = badd(p.cold.pack.pbuf, rec)
  let imap = p.cold.pack.imap ++ q8(n) ++ q8(p.cold.pack.nconst)
  return with_pool_i(p, pbuf, p.cold.pack.nconst + 1 else fail "math", imap)
end

fn push_i64(p: prog, n: i64) -> prog
  let q = intern_i64(p, n)
  let idx = seek_i64(q.cold.pack.imap, n)
  if idx < 0
    fail "const"
  end
  return take_code(q, byte(5) ++ u16(idx))
end

fn intern_bytes(p: prog, data: bytes) -> prog
  if seek_buf(p.cold.pack.smap, data) >= 0
    return p
  end
  let off = seek_buf(p.cold.pack.bmap, data)
  let strs = p.cold.pack.strs
  let bmap = p.cold.pack.bmap
  if off < 0
    set off = p.cold.pack.strs.count
    set strs = badd(p.cold.pack.strs, data)
    set bmap = badd(p.cold.pack.bmap, q8(off) ++ u16(len(data)) ++ data)
  end
  let rec = pool_rec(257, off, len(data), 0)
  let pbuf = badd(p.cold.pack.pbuf, rec)
  let smap = badd(p.cold.pack.smap, q8(p.cold.pack.nconst) ++ u16(len(data)) ++ data)
  return with_pool_b(p, pbuf, p.cold.pack.nconst + 1 else fail "math", strs, bmap, smap)
end

fn push_bytes(p: prog, data: bytes) -> prog
  let q = intern_bytes(p, data)
  let idx = seek_buf(q.cold.pack.smap, data)
  if idx < 0
    fail "const"
  end
  return take_code(q, byte(5) ++ u16(idx))
end

fn slot_index(raw: i64) -> i64
  if raw >= 1024
    let kind = raw / 1024 else fail "math"
    return raw - kind * 1024 else fail "math"
  end
  return raw
end

fn slot_kind(raw: i64) -> i64
  if raw >= 1024
    return raw / 1024 else fail "math"
  end
  return 1
end

fn pack_slot(index: i64, kind: i64) -> i64
  let scaled = kind * 1024 else fail "math"
  return index + scaled else fail "math"
end

fn push_local(p: prog, name: bytes) -> prog
  if has(p.cold.slots, name) == 0
    fail "unknown name"
  end
  let raw = get(p.cold.slots, name) else fail "unknown name"
  let slot = slot_index(raw)
  return take_code(p, byte(7) ++ u16(slot))
end

fn made(p: prog, pos: i64, kind: i64) -> parsed
  return parsed(p, pos, kind)
end

fn made_block(kind: i64, alt: bytes, done: bytes) -> block
  return block(kind, alt, done)
end

fn do_dec(cur: parsed) -> parsed
  return made(take_code(cur.prog, byte(34)), cur.pos, 2)
end

fn emit_add(p: prog) -> prog
  return emit_iffail(take_code(p, byte(13)))
end

fn emit_cat(p: prog) -> prog
  return take_code(p, byte(19))
end

fn id_text(n: i64) -> bytes
  if n == 0
    return "0"
  end
  let out = ""
  let v = n
  while v > 0
    let q = v / 10 else fail "math"
    let r = v - q * 10 else fail "math"
    set out = byte(48 + r else fail "math") ++ out
    set v = q
  end
  return out
end

fn with_row(p: prog, sname: map bytes i64, sfld: map bytes i64, nstruct: i64, building: bytes, nfield: i64, live: i64) -> prog
  return spawn(p.cold.pack.code, p.cold.pack.pool, p.cold.pack.nconst, p.cold.pack.strs, p.cold.pack.funcs, p.jumps, p.cold.marks, p.cold.pack.imap, p.cold.pack.bmap, p.cold.pack.smap, p.cold.pack.fnames, p.cold.pack.arity, p.cold.slots, p.cold.pack.unwind, p.cold.pack.main_off, p.cold.pack.main_slots, p.cold.pack.saw_main, live, p.cold.pack.start, p.cold.pack.nparams, p.cold.pack.is_main, p.cold.seen, as_buf(p), p.cold.blocks, p.cold.failto, p.cold.pack.pbuf, sname, sfld, nstruct, building, nfield, p.cold.pack.rets)
end

fn with_fns(p: prog, fnames: buf, arity: buf, rets: buf) -> prog
  return spawn(p.cold.pack.code, p.cold.pack.pool, p.cold.pack.nconst, p.cold.pack.strs, p.cold.pack.funcs, p.jumps, p.cold.marks, p.cold.pack.imap, p.cold.pack.bmap, p.cold.pack.smap, fnames, arity, p.cold.slots, p.cold.pack.unwind, p.cold.pack.main_off, p.cold.pack.main_slots, p.cold.pack.saw_main, p.cold.pack.live, p.cold.pack.start, p.cold.pack.nparams, p.cold.pack.is_main, p.cold.seen, as_buf(p), p.cold.blocks, p.cold.failto, p.cold.pack.pbuf, p.cold.pack.sname, p.cold.pack.sfld, p.cold.pack.nstruct, p.cold.pack.building, p.cold.pack.nfield, rets)
end

fn read_type(p: prog, toks: toks, pos: i64) -> parsed
  if pos >= toks.count
    fail "type"
  end
  if tok_kind(toks, pos) != 1
    fail "type"
  end
  let name = tok_text(toks, pos)
  if eqb(name, "i64")
    return made(p, pos + 1 else fail "math", 1)
  end
  if eqb(name, "bytes")
    return made(p, pos + 1 else fail "math", 2)
  end
  if eqb(name, "list")
    let inner = read_type(p, toks, pos + 1 else fail "math")
    let k = 1000 + inner.kind else fail "math"
    return made(p, inner.pos, k)
  end
  if eqb(name, "map")
    let key = read_type(p, toks, pos + 1 else fail "math")
    let val = read_type(p, toks, key.pos)
    let scaled = key.kind * 1000 else fail "math"
    let body = 2000 + scaled else fail "math"
    let mk = body + val.kind else fail "math"
    return made(p, val.pos, mk)
  end
  if has(p.cold.pack.sname, name) == 0
    fail "type"
  end
  let packed = get(p.cold.pack.sname, name) else fail "type"
  return made(p, pos + 1 else fail "math", slot_index(packed))
end

fn note_field(p: prog, toks: toks) -> prog
  if toks.count < 3
    fail "expected a field name"
  end
  if tok_kind(toks, 0) != 1
    fail "expected a field name"
  end
  if tok_kind(toks, 1) != 9
    fail "expected :"
  end
  let name = tok_text(toks, 0)
  let typed = read_type(p, toks, 2)
  if typed.pos != toks.count
    fail "extra tokens"
  end
  let slash = id_text(p.cold.pack.nstruct) ++ "/" ++ name
  if has(p.cold.pack.sfld, slash)
    fail "duplicate field"
  end
  let dot = id_text(p.cold.pack.nstruct) ++ "." ++ id_text(p.cold.pack.nfield)
  let sfld = put(p.cold.pack.sfld, slash, pack_slot(p.cold.pack.nfield, typed.kind))
  set sfld = put(sfld, dot, typed.kind)
  return with_row(p, p.cold.pack.sname, sfld, p.cold.pack.nstruct, p.cold.pack.building, p.cold.pack.nfield + 1 else fail "math", p.cold.pack.live)
end

fn leading_is(text: bytes, word: bytes) -> i64
  let i = 0
  let n = len(text)
  let go = 1
  while go
    if i >= n
      set go = 0
    else
      let c = at_or(text, i)
      if c == 32
        set i = i + 1 else fail "math"
      else
        if c == 9
          set i = i + 1 else fail "math"
        else
          set go = 0
        end
      end
    end
  end
  let w = len(word)
  let endat = i + w else fail "math"
  if endat > n
    return 0
  end
  if eq_span(text, i, word, 0, w) == 0
    return 0
  end
  if endat < n
    if is_ident(at_or(text, endat))
      return 0
    end
  end
  return 1
end

fn leading_word(text: bytes) -> bytes
  let i = 0
  let n = len(text)
  let go = 1
  while go
    if i >= n
      set go = 0
    else
      let c = at_or(text, i)
      if c == 32
        set i = i + 1 else fail "math"
      else
        if c == 9
          set i = i + 1 else fail "math"
        else
          set go = 0
        end
      end
    end
  end
  if i >= n
    return ""
  end
  if is_letter(at_or(text, i)) == 0
    return ""
  end
  let got = read_ident(text, i)
  return got.tok.text
end

fn scan_structs(p: prog, text: bytes) -> prog
  let cur = p
  let mode = 0
  for line in lines(text)
    let take = 0
    if mode == 2
      set take = 1
    else
      if leading_is(line.text, "struct")
        set take = 1
      end
    end
    if take != 0
        let toks = lex(line.text)
        if toks.count != 0
          if mode == 2
            if eqb(tok_text(toks, 0), "end")
              if toks.count != 1
                fail "extra tokens"
              end
              if cur.cold.pack.nfield == 0
                fail "struct needs a field"
              end
              let packed = pack_slot(cur.cold.pack.nstruct, cur.cold.pack.nfield)
              let sname = put(cur.cold.pack.sname, cur.cold.pack.building, packed)
              let nxt = cur.cold.pack.nstruct + 1 else fail "math"
              set cur = with_row(cur, sname, cur.cold.pack.sfld, nxt, "", 0, 0)
              set mode = 0
            else
              set cur = note_field(cur, toks)
            end
          else
            if eqb(tok_text(toks, 0), "struct")
              if toks.count != 2
                fail "expected a struct name"
              end
              if tok_kind(toks, 1) != 1
                fail "expected a struct name"
              end
              let name = tok_text(toks, 1)
              if has(cur.cold.pack.sname, name)
                fail "duplicate struct"
              end
              set cur = with_row(cur, cur.cold.pack.sname, cur.cold.pack.sfld, cur.cold.pack.nstruct, name, 0, 0)
              set mode = 2
            end
          end
        end
    end
  end
  if mode != 0
    fail "expected end"
  end
  return cur
end

fn arrow_type(p: prog, toks: toks) -> i64
  let i = 0
  let n = toks.count
  while i < n
    if tok_kind(toks, i) == 10
      let typed = read_type(p, toks, i + 1 else fail "math")
      return typed.kind
    end
    set i = i + 1 else fail "math"
  end
  return 0
end

fn scan_fns(p: prog, text: bytes) -> prog
  let fnames = p.cold.pack.fnames
  let arity = p.cold.pack.arity
  let rets = p.cold.pack.rets
  let count = 0
  for line in lines(text)
    if leading_is(line.text, "fn")
      let toks = lex(line.text)
      if toks.count > 0
        if eqb(tok_text(toks, 0), "fn")
          if toks.count < 2
            fail "expected a name"
          end
          let name = tok_text(toks, 1)
          if eqb(name, "main")
            if toks.count != 2
              fail "main takes no parameters"
            end
          end
          if seek_buf(fnames, name) >= 0
            fail "duplicate function"
          end
          let slots = bind_params(p, toks)
          set fnames = note(fnames, count, name)
          set arity = note(arity, len(slots), name)
          set rets = note(rets, arrow_type(p, toks), name)
          set count = count + 1 else fail "math"
        end
      end
    end
  end
  if count == 0
    fail "missing fn"
  end
  return with_fns(p, fnames, arity, rets)
end

fn take_fields(cur: parsed, toks: toks) -> parsed
  let out = cur
  while tok_is(toks, out.pos, 19)
    if tok_is(toks, out.pos + 1 else fail "math", 1) == 0
      fail "field"
    end
    let field = tok_text(toks, out.pos + 1 else fail "math")
    if out.kind == 3
      if eqb(field, "text")
        set out = made(take_code(out.prog, byte(28)), out.pos + 2 else fail "math", 2)
      else
        if eqb(field, "n")
          set out = made(take_code(out.prog, byte(27)), out.pos + 2 else fail "math", 1)
        else
          fail "field"
        end
      end
    else
      if out.kind < 7
        fail "field"
      end
      if out.kind >= 1000
        fail "field"
      end
      let key = id_text(out.kind) ++ "/" ++ field
      if has(out.prog.cold.pack.sfld, key) == 0
        fail "field"
      end
      let packed = get(out.prog.cold.pack.sfld, key) else fail "field"
      let coded = take_code(out.prog, byte(51) ++ u16(slot_index(packed)))
      set out = made(coded, out.pos + 2 else fail "math", slot_kind(packed))
    end
  end
  return out
end

fn parse_atom(p: prog, toks: toks, pos: i64) -> parsed
  if pos >= toks.count
    fail "expected expression"
  end
  let kind = tok_kind(toks, pos)
  if kind == 2
    let nxt = push_i64(p, tok_num(toks, pos))
    return made(nxt, pos + 1 else fail "math", 1)
  end
  if kind == 3
    let nxt2 = push_bytes(p, tok_text(toks, pos))
    return made(nxt2, pos + 1 else fail "math", 2)
  end
  if kind == 6
    let inner = parse_expr(p, toks, pos + 1 else fail "math")
    if tok_is(toks, inner.pos, 7) == 0
      fail "expected )"
    end
    return take_fields(made(inner.prog, inner.pos + 1 else fail "math", inner.kind), toks)
  end
  if kind == 1
    if eqb(tok_text(toks, pos), "fail")
      return parse_fail_expr(p, toks, pos)
    end
    if eqb(tok_text(toks, pos), "reason")
      return made(take_code(p, byte(29)), pos + 1 else fail "math", 2)
    end
    if tok_is(toks, pos + 1 else fail "math", 6)
      return take_fields(parse_call(p, toks, pos), toks)
    end
    let nxt3 = push_local(p, tok_text(toks, pos))
    let raw = get(p.cold.slots, tok_text(toks, pos)) else fail "unknown name"
    let sk = slot_kind(raw)
    return take_fields(made(nxt3, pos + 1 else fail "math", sk), toks)
  end
  if kind == 11
    let unary = parse_atom(p, toks, pos + 1 else fail "math")
    if unary.kind != 1
      fail "type"
    end
    let negated = emit_iffail(take_code(unary.prog, byte(17)))
    return made(negated, unary.pos, 1)
  end
  fail "bad expression"
  return made(p, pos, 0)
end

fn parse_argc(p: prog, toks: toks, pos: i64) -> parsed
  if tok_is(toks, pos + 1 else fail "math", 6) == 0
    fail "expected ("
  end
  if tok_is(toks, pos + 2 else fail "math", 7) == 0
    fail "arity"
  end
  return made(take_code(p, byte(21)), pos + 3 else fail "math", 1)
end

fn parse_one(p: prog, toks: toks, pos: i64, want: i64, op: i64, outk: i64) -> parsed
  if tok_is(toks, pos + 1 else fail "math", 6) == 0
    fail "expected ("
  end
  let cur = parse_expr(p, toks, pos + 2 else fail "math")
  if cur.kind != want
    fail "type"
  end
  if tok_is(toks, cur.pos, 7) == 0
    fail "expected )"
  end
  let done = emit_iffail(take_code(cur.prog, byte(op)))
  return made(done, cur.pos + 1 else fail "math", outk)
end

fn parse_arg(p: prog, toks: toks, pos: i64) -> parsed
  return parse_one(p, toks, pos, 1, 22, 2)
end

fn parse_i64_call(p: prog, toks: toks, pos: i64) -> parsed
  return parse_one(p, toks, pos, 2, 20, 1)
end

fn parse_len(p: prog, toks: toks, pos: i64) -> parsed
  if tok_is(toks, pos + 1 else fail "math", 6) == 0
    fail "expected ("
  end
  let cur = parse_expr(p, toks, pos + 2 else fail "math")
  if tok_is(toks, cur.pos, 7) == 0
    fail "expected )"
  end
  let op = 0
  if cur.kind == 2
    set op = 25
  end
  if cur.kind >= 1000
    if cur.kind < 2000
      set op = 49
    end
  end
  if cur.kind >= 2000
    set op = 56
  end
  if op == 0
    fail "type"
  end
  let done = emit_iffail(take_code(cur.prog, byte(op)))
  return made(done, cur.pos + 1 else fail "math", 1)
end

fn parse_open(p: prog, toks: toks, pos: i64) -> parsed
  if tok_is(toks, pos + 1 else fail "math", 6) == 0
    fail "expected ("
  end
  let a1 = parse_expr(p, toks, pos + 2 else fail "math")
  if a1.kind != 2
    fail "type"
  end
  if tok_is(toks, a1.pos, 8) == 0
    fail "expected ,"
  end
  let a2 = parse_expr(a1.prog, toks, a1.pos + 1 else fail "math")
  if a2.kind != 1
    fail "type"
  end
  if tok_is(toks, a2.pos, 8) == 0
    fail "expected ,"
  end
  let a3 = parse_expr(a2.prog, toks, a2.pos + 1 else fail "math")
  if a3.kind != 2
    fail "type"
  end
  if tok_is(toks, a3.pos, 8) == 0
    fail "expected ,"
  end
  let a4 = parse_expr(a3.prog, toks, a3.pos + 1 else fail "math")
  if a4.kind != 2
    fail "type"
  end
  if tok_is(toks, a4.pos, 8) == 0
    fail "expected ,"
  end
  let a5 = parse_expr(a4.prog, toks, a4.pos + 1 else fail "math")
  if a5.kind != 2
    fail "type"
  end
  if tok_is(toks, a5.pos, 7) == 0
    fail "expected )"
  end
  let done = emit_iffail(take_code(a5.prog, byte(23)))
  return made(done, a5.pos + 1 else fail "math", 2)
end

fn parse_call(p: prog, toks: toks, pos: i64) -> parsed
  let name = tok_text(toks, pos)
  if eqb(name, "argc")
    return parse_argc(p, toks, pos)
  end
  if eqb(name, "arg")
    return parse_arg(p, toks, pos)
  end
  if eqb(name, "open")
    return parse_open(p, toks, pos)
  end
  if eqb(name, "i64")
    return parse_i64_call(p, toks, pos)
  end
  if eqb(name, "len")
    return parse_len(p, toks, pos)
  end
  if eqb(name, "before")
    return parse_pair(p, toks, pos, 35, 2)
  end
  if eqb(name, "after")
    return parse_pair(p, toks, pos, 36, 2)
  end
  if eqb(name, "holds")
    return parse_pair(p, toks, pos, 37, 1)
  end
  if eqb(name, "byte")
    return parse_one(p, toks, pos, 1, 3, 2)
  end
  if eqb(name, "at")
    return parse_at(p, toks, pos)
  end
  if eqb(name, "set_byte")
    return parse_set_byte(p, toks, pos)
  end
  if eqb(name, "save")
    return parse_save(p, toks, pos)
  end
  if eqb(name, "list")
    return parse_list(p, toks, pos)
  end
  if eqb(name, "map")
    return parse_map_lit(p, toks, pos)
  end
  if eqb(name, "push")
    return parse_push(p, toks, pos)
  end
  if eqb(name, "put")
    return parse_put(p, toks, pos)
  end
  if eqb(name, "get")
    return parse_get(p, toks, pos)
  end
  if eqb(name, "has")
    return parse_has(p, toks, pos)
  end
  if has(p.cold.pack.sname, name)
    return parse_struct_call(p, toks, pos, name)
  end
  if seek_buf(p.cold.pack.fnames, name) < 0
    fail "unknown function"
  end
  let want = seek_buf(p.cold.pack.arity, name)
  if want < 0
    fail "arity"
  end
  let i = pos + 2 else fail "math"
  let code = ""
  let pcur = p
  let got = 0
  let mode = 1
  if tok_is(toks, i, 7)
    set i = i + 1 else fail "math"
    set mode = 2
  end
  while mode == 1
    let k = tok_kind(toks, i)
    let took = 0
    if k == 2
      let num = tok_num(toks, i)
      set pcur = intern_i64(pcur, num)
      let ix = seek_i64(pcur.cold.pack.imap, num)
      if ix < 0
        fail "const"
      end
      set code = code ++ byte(5) ++ u16(ix)
      set i = i + 1 else fail "math"
      set got = got + 1 else fail "math"
      set took = 1
    end
    if k == 3
      let lit = tok_text(toks, i)
      set pcur = intern_bytes(pcur, lit)
      let sx = seek_buf(pcur.cold.pack.smap, lit)
      if sx < 0
        fail "const"
      end
      set code = code ++ byte(5) ++ u16(sx)
      set i = i + 1 else fail "math"
      set got = got + 1 else fail "math"
      set took = 1
    end
    if k == 1
      let nxt = i + 1 else fail "math"
      if tok_is(toks, nxt, 6)
        set mode = 0
      else
        if tok_is(toks, nxt, 19)
          let nm = tok_text(toks, i)
          if eqb(nm, "fail")
            set mode = 0
          else
            if eqb(nm, "reason")
              set mode = 0
            else
              if has(pcur.cold.slots, nm) == 0
                fail "unknown name"
              end
              let raws = get(pcur.cold.slots, nm) else fail "unknown name"
              set code = code ++ byte(7) ++ u16(slot_index(raws))
              let sk = slot_kind(raws)
              set i = i + 1 else fail "math"
              let go = 1
              while go
                if tok_is(toks, i, 19) == 0
                  set go = 0
                else
                  if tok_is(toks, i + 1 else fail "math", 1) == 0
                    fail "field"
                  end
                  let field = tok_text(toks, i + 1 else fail "math")
                  if sk == 3
                    if eqb(field, "text")
                      set code = code ++ byte(28)
                      set sk = 2
                    else
                      if eqb(field, "n")
                        set code = code ++ byte(27)
                        set sk = 1
                      else
                        fail "field"
                      end
                    end
                  else
                    if sk < 7
                      fail "field"
                    end
                    if sk >= 1000
                      fail "field"
                    end
                    let key = id_text(sk) ++ "/" ++ field
                    if has(pcur.cold.pack.sfld, key) == 0
                      fail "field"
                    end
                    let packed = get(pcur.cold.pack.sfld, key) else fail "field"
                    set code = code ++ byte(51) ++ u16(slot_index(packed))
                    set sk = slot_kind(packed)
                  end
                  set i = i + 2 else fail "math"
                end
              end
              set got = got + 1 else fail "math"
              set took = 1
            end
          end
        else
          let nm2 = tok_text(toks, i)
          if eqb(nm2, "fail")
            set mode = 0
          else
            if eqb(nm2, "reason")
              set mode = 0
            else
              if has(pcur.cold.slots, nm2) == 0
                fail "unknown name"
              end
              let raws2 = get(pcur.cold.slots, nm2) else fail "unknown name"
              set code = code ++ byte(7) ++ u16(slot_index(raws2))
              set i = i + 1 else fail "math"
              set got = got + 1 else fail "math"
              set took = 1
            end
          end
        end
      end
    end
    if took
      if tok_is(toks, i, 8)
        set i = i + 1 else fail "math"
      else
        if tok_is(toks, i, 7)
          set i = i + 1 else fail "math"
          set mode = 2
        else
          set mode = 0
        end
      end
    else
      if mode == 1
        set mode = 0
      end
    end
  end
  let cur = made(p, i, 1)
  if mode != 2
    set code = ""
    set pcur = p
    set i = pos + 2 else fail "math"
    set got = 0
    if tok_is(toks, i, 7)
      set i = i + 1 else fail "math"
    else
      set cur = parse_expr(p, toks, i)
      set got = 1
      set i = cur.pos
      while tok_is(toks, i, 8)
        set cur = parse_expr(cur.prog, toks, i + 1 else fail "math")
        set got = got + 1 else fail "math"
        set i = cur.pos
      end
      if tok_is(toks, i, 7) == 0
        fail "expected )"
      end
      set i = i + 1 else fail "math"
    end
  end
  if got != want
    fail "arity"
  end
  let idx = seek_buf(p.cold.pack.fnames, name)
  if idx < 0
    fail "unknown function"
  end
  let base = cur.prog
  if mode == 2
    set base = pcur
  end
  let called = take_code(base, code ++ byte(30) ++ u16(idx))
  let failed = emit_iffail(called)
  let rk = 1
  let rkfound = seek_buf(p.cold.pack.rets, name)
  if rkfound >= 0
    set rk = rkfound
  end
  if rk == 0
    set rk = 1
  end
  return made(failed, i, rk)
end

fn parse_pair(p: prog, toks: toks, pos: i64, op: i64, outk: i64) -> parsed
  if tok_is(toks, pos + 1 else fail "math", 6) == 0
    fail "expected ("
  end
  let a1 = parse_expr(p, toks, pos + 2 else fail "math")
  if a1.kind != 2
    fail "type"
  end
  if tok_is(toks, a1.pos, 8) == 0
    fail "expected ,"
  end
  let a2 = parse_expr(a1.prog, toks, a1.pos + 1 else fail "math")
  if a2.kind != 2
    fail "type"
  end
  if tok_is(toks, a2.pos, 7) == 0
    fail "expected )"
  end
  let done = emit_iffail(take_code(a2.prog, byte(op)))
  return made(done, a2.pos + 1 else fail "math", outk)
end

fn product_op(toks: toks, pos: i64) -> i64
  if tok_is(toks, pos, 21)
    return 15
  end
  if tok_is(toks, pos, 20)
    return 16
  end
  return 0
end

fn parse_product(p: prog, toks: toks, pos: i64) -> parsed
  let cur = parse_atom(p, toks, pos)
  let op = product_op(toks, cur.pos)
  while op != 0
    if cur.kind != 1
      fail "type"
    end
    let right = parse_atom(cur.prog, toks, cur.pos + 1 else fail "math")
    if right.kind != 1
      fail "type"
    end
    let done = emit_iffail(take_code(right.prog, byte(op)))
    set cur = made(done, right.pos, 1)
    set op = product_op(toks, cur.pos)
  end
  return cur
end

fn sum_op(toks: toks, pos: i64) -> i64
  if tok_is(toks, pos, 4)
    return 13
  end
  if tok_is(toks, pos, 11)
    return 14
  end
  return 0
end

fn parse_list(p: prog, toks: toks, pos: i64) -> parsed
  if tok_is(toks, pos + 1 else fail "math", 6) == 0
    fail "expected ("
  end
  let i = pos + 2 else fail "math"
  if tok_is(toks, i, 7)
    let done = take_code(p, byte(46) ++ u16(0))
    return made(done, i + 1 else fail "math", 0)
  end
  let cur = parse_expr(p, toks, i)
  if cur.kind == 0
    fail "type"
  end
  let elem = cur.kind
  let count = 1
  while tok_is(toks, cur.pos, 8)
    set cur = parse_expr(cur.prog, toks, cur.pos + 1 else fail "math")
    if cur.kind != elem
      fail "type"
    end
    set count = count + 1 else fail "math"
  end
  if tok_is(toks, cur.pos, 7) == 0
    fail "expected )"
  end
  let built = take_code(cur.prog, byte(46) ++ u16(count))
  let kind = 1000 + elem else fail "math"
  return made(built, cur.pos + 1 else fail "math", kind)
end

fn parse_map_lit(p: prog, toks: toks, pos: i64) -> parsed
  if tok_is(toks, pos + 1 else fail "math", 6) == 0
    fail "expected ("
  end
  let i = pos + 2 else fail "math"
  if tok_is(toks, i, 7)
    let done = take_code(p, byte(52) ++ u16(0))
    return made(done, i + 1 else fail "math", 0)
  end
  let key = parse_expr(p, toks, i)
  if key.kind == 0
    fail "type"
  end
  if tok_is(toks, key.pos, 8) == 0
    fail "expected ,"
  end
  let val = parse_expr(key.prog, toks, key.pos + 1 else fail "math")
  if val.kind == 0
    fail "type"
  end
  let kk = key.kind
  let vk = val.kind
  let cur = val
  let pairs = 1
  while tok_is(toks, cur.pos, 8)
    let nk = parse_expr(cur.prog, toks, cur.pos + 1 else fail "math")
    if nk.kind != kk
      fail "type"
    end
    if tok_is(toks, nk.pos, 8) == 0
      fail "expected ,"
    end
    set cur = parse_expr(nk.prog, toks, nk.pos + 1 else fail "math")
    if cur.kind != vk
      fail "type"
    end
    set pairs = pairs + 1 else fail "math"
  end
  if tok_is(toks, cur.pos, 7) == 0
    fail "expected )"
  end
  let built = take_code(cur.prog, byte(52) ++ u16(pairs))
  let scaled = kk * 1000 else fail "math"
  let body = 2000 + scaled else fail "math"
  let kind = body + vk else fail "math"
  return made(built, cur.pos + 1 else fail "math", kind)
end

fn parse_push(p: prog, toks: toks, pos: i64) -> parsed
  if tok_is(toks, pos + 1 else fail "math", 6) == 0
    fail "expected ("
  end
  let a1 = parse_expr(p, toks, pos + 2 else fail "math")
  if a1.kind < 1000
    fail "type"
  end
  if a1.kind >= 2000
    fail "type"
  end
  if tok_is(toks, a1.pos, 8) == 0
    fail "expected ,"
  end
  let a2 = parse_expr(a1.prog, toks, a1.pos + 1 else fail "math")
  let elem = a1.kind - 1000 else fail "math"
  if a2.kind != elem
    fail "type"
  end
  if tok_is(toks, a2.pos, 7) == 0
    fail "expected )"
  end
  let done = take_code(a2.prog, byte(47))
  return made(done, a2.pos + 1 else fail "math", a1.kind)
end

fn parse_put(p: prog, toks: toks, pos: i64) -> parsed
  if tok_is(toks, pos + 1 else fail "math", 6) == 0
    fail "expected ("
  end
  let a1 = parse_expr(p, toks, pos + 2 else fail "math")
  if a1.kind < 2000
    fail "type"
  end
  if tok_is(toks, a1.pos, 8) == 0
    fail "expected ,"
  end
  let a2 = parse_expr(a1.prog, toks, a1.pos + 1 else fail "math")
  let span = a1.kind - 2000 else fail "math"
  let kk = span / 1000 else fail "math"
  let scaled = kk * 1000 else fail "math"
  let vk = span - scaled else fail "math"
  if a2.kind != kk
    fail "type"
  end
  if tok_is(toks, a2.pos, 8) == 0
    fail "expected ,"
  end
  let a3 = parse_expr(a2.prog, toks, a2.pos + 1 else fail "math")
  if a3.kind != vk
    fail "type"
  end
  if tok_is(toks, a3.pos, 7) == 0
    fail "expected )"
  end
  let done = take_code(a3.prog, byte(53))
  return made(done, a3.pos + 1 else fail "math", a1.kind)
end

fn parse_get(p: prog, toks: toks, pos: i64) -> parsed
  if tok_is(toks, pos + 1 else fail "math", 6) == 0
    fail "expected ("
  end
  let a1 = parse_expr(p, toks, pos + 2 else fail "math")
  if a1.kind < 2000
    fail "type"
  end
  if tok_is(toks, a1.pos, 8) == 0
    fail "expected ,"
  end
  let a2 = parse_expr(a1.prog, toks, a1.pos + 1 else fail "math")
  let span = a1.kind - 2000 else fail "math"
  let kk = span / 1000 else fail "math"
  if a2.kind != kk
    fail "type"
  end
  if tok_is(toks, a2.pos, 7) == 0
    fail "expected )"
  end
  let scaled = kk * 1000 else fail "math"
  let vk = span - scaled else fail "math"
  let done = emit_iffail(take_code(a2.prog, byte(54)))
  return made(done, a2.pos + 1 else fail "math", vk)
end

fn parse_has(p: prog, toks: toks, pos: i64) -> parsed
  if tok_is(toks, pos + 1 else fail "math", 6) == 0
    fail "expected ("
  end
  let a1 = parse_expr(p, toks, pos + 2 else fail "math")
  if a1.kind < 2000
    fail "type"
  end
  if tok_is(toks, a1.pos, 8) == 0
    fail "expected ,"
  end
  let a2 = parse_expr(a1.prog, toks, a1.pos + 1 else fail "math")
  let span = a1.kind - 2000 else fail "math"
  let kk = span / 1000 else fail "math"
  if a2.kind != kk
    fail "type"
  end
  if tok_is(toks, a2.pos, 7) == 0
    fail "expected )"
  end
  let done = take_code(a2.prog, byte(55))
  return made(done, a2.pos + 1 else fail "math", 1)
end

fn parse_struct_call(p: prog, toks: toks, pos: i64, name: bytes) -> parsed
  let packed = get(p.cold.pack.sname, name) else fail "type"
  let id = slot_index(packed)
  let nfields = slot_kind(packed)
  if tok_is(toks, pos + 1 else fail "math", 6) == 0
    fail "expected ("
  end
  let i = pos + 2 else fail "math"
  let code = ""
  let pcur = p
  let got = 0
  let mode = 1
  if tok_is(toks, i, 7)
    set i = i + 1 else fail "math"
    set mode = 2
  end
  while mode == 1
    let k = tok_kind(toks, i)
    let sk = 0
    let took = 0
    if k == 1
      if tok_is(toks, i + 1 else fail "math", 6)
        set mode = 0
      else
        let nm = tok_text(toks, i)
        if has(pcur.cold.slots, nm) == 0
          set mode = 0
        else
          let raws = get(pcur.cold.slots, nm) else fail "unknown name"
          set code = code ++ byte(7) ++ u16(slot_index(raws))
          set sk = slot_kind(raws)
          set i = i + 1 else fail "math"
          let go = 1
          while go
            if tok_is(toks, i, 19) == 0
              set go = 0
            else
              if tok_is(toks, i + 1 else fail "math", 1) == 0
                fail "field"
              end
              let field = tok_text(toks, i + 1 else fail "math")
              if sk == 3
                if eqb(field, "text")
                  set code = code ++ byte(28)
                  set sk = 2
                else
                  if eqb(field, "n")
                    set code = code ++ byte(27)
                    set sk = 1
                  else
                    fail "field"
                  end
                end
              else
                if sk < 7
                  fail "field"
                end
                if sk >= 1000
                  fail "field"
                end
                let key = id_text(sk) ++ "/" ++ field
                if has(pcur.cold.pack.sfld, key) == 0
                  fail "field"
                end
                let fp = get(pcur.cold.pack.sfld, key) else fail "field"
                set code = code ++ byte(51) ++ u16(slot_index(fp))
                set sk = slot_kind(fp)
              end
              set i = i + 2 else fail "math"
            end
          end
          set took = 1
        end
      end
    else
      set mode = 0
    end
    if took
      let need = get(p.cold.pack.sfld, id_text(id) ++ "." ++ id_text(got)) else fail "field"
      if sk != need
        fail "type"
      end
      set got = got + 1 else fail "math"
      if tok_is(toks, i, 8)
        set i = i + 1 else fail "math"
      else
        if tok_is(toks, i, 7)
          set i = i + 1 else fail "math"
          set mode = 2
        else
          set mode = 0
        end
      end
    else
      if mode == 1
        set mode = 0
      end
    end
  end
  if mode == 2
    if got != nfields
      fail "arity"
    end
    let built = take_code(pcur, code ++ byte(50) ++ u16(nfields))
    return made(built, i, id)
  end
  let cur = made(p, pos + 2 else fail "math", 0)
  set got = 0
  if tok_is(toks, cur.pos, 7) == 0
    set cur = parse_expr(p, toks, cur.pos)
    set got = 1
    let want = get(p.cold.pack.sfld, id_text(id) ++ "." ++ id_text(0)) else fail "field"
    if cur.kind != want
      fail "type"
    end
    while tok_is(toks, cur.pos, 8)
      set cur = parse_expr(cur.prog, toks, cur.pos + 1 else fail "math")
      let need2 = get(p.cold.pack.sfld, id_text(id) ++ "." ++ id_text(got)) else fail "field"
      if cur.kind != need2
        fail "type"
      end
      set got = got + 1 else fail "math"
    end
  end
  if tok_is(toks, cur.pos, 7) == 0
    fail "expected )"
  end
  if got != nfields
    fail "arity"
  end
  let slow = take_code(cur.prog, byte(50) ++ u16(nfields))
  return made(slow, cur.pos + 1 else fail "math", id)
end

fn parse_at(p: prog, toks: toks, pos: i64) -> parsed
  if tok_is(toks, pos + 1 else fail "math", 6) == 0
    fail "expected ("
  end
  let a1 = parse_expr(p, toks, pos + 2 else fail "math")
  let op = 0
  let outk = 1
  if a1.kind == 2
    set op = 24
  end
  if a1.kind >= 1000
    if a1.kind < 2000
      set op = 48
      set outk = a1.kind - 1000 else fail "math"
    end
  end
  if op == 0
    fail "type"
  end
  if tok_is(toks, a1.pos, 8) == 0
    fail "expected ,"
  end
  let a2 = parse_expr(a1.prog, toks, a1.pos + 1 else fail "math")
  if a2.kind != 1
    fail "type"
  end
  if tok_is(toks, a2.pos, 7) == 0
    fail "expected )"
  end
  let done = emit_iffail(take_code(a2.prog, byte(op)))
  return made(done, a2.pos + 1 else fail "math", outk)
end

fn parse_set_byte(p: prog, toks: toks, pos: i64) -> parsed
  if tok_is(toks, pos + 1 else fail "math", 6) == 0
    fail "expected ("
  end
  let a1 = parse_expr(p, toks, pos + 2 else fail "math")
  if a1.kind != 2
    fail "type"
  end
  if tok_is(toks, a1.pos, 8) == 0
    fail "expected ,"
  end
  let a2 = parse_expr(a1.prog, toks, a1.pos + 1 else fail "math")
  if a2.kind != 1
    fail "type"
  end
  if tok_is(toks, a2.pos, 8) == 0
    fail "expected ,"
  end
  let a3 = parse_expr(a2.prog, toks, a2.pos + 1 else fail "math")
  if a3.kind != 1
    fail "type"
  end
  if tok_is(toks, a3.pos, 7) == 0
    fail "expected )"
  end
  let done = emit_iffail(take_code(a3.prog, byte(10)))
  return made(done, a3.pos + 1 else fail "math", 2)
end

fn parse_save(p: prog, toks: toks, pos: i64) -> parsed
  if tok_is(toks, pos + 1 else fail "math", 6) == 0
    fail "expected ("
  end
  let a1 = parse_expr(p, toks, pos + 2 else fail "math")
  if a1.kind != 2
    fail "type"
  end
  if tok_is(toks, a1.pos, 8) == 0
    fail "expected ,"
  end
  let a2 = parse_expr(a1.prog, toks, a1.pos + 1 else fail "math")
  if a2.kind != 2
    fail "type"
  end
  if tok_is(toks, a2.pos, 7) == 0
    fail "expected )"
  end
  let done = emit_iffail(take_code(a2.prog, byte(4)))
  return made(done, a2.pos + 1 else fail "math", 1)
end

fn parse_sum(p: prog, toks: toks, pos: i64) -> parsed
  let cur = parse_product(p, toks, pos)
  let op = sum_op(toks, cur.pos)
  while op != 0
    if cur.kind != 1
      fail "type"
    end
    let right = parse_product(cur.prog, toks, cur.pos + 1 else fail "math")
    if right.kind != 1
      fail "type"
    end
    let added = emit_iffail(take_code(right.prog, byte(op)))
    set cur = made(added, right.pos, 1)
    set op = sum_op(toks, cur.pos)
  end
  return cur
end


fn emit_return(p: prog, toks: toks) -> prog
  let fast = emit_return_fast(p, toks)
  if fast.count != p.count
    return fast
  end
  let cur = parse_expr(p, toks, 1)
  if cur.pos != toks.count
    fail "extra tokens"
  end
  return take_code(cur.prog, byte(31))
end

fn emit_write(p: prog, toks: toks) -> prog
  let fast = emit_write_fast(p, toks)
  if fast.count != p.count
    return fast
  end
  let cur = parse_expr(p, toks, 1)
  if cur.pos != toks.count
    fail "extra tokens"
  end
  let outp = cur
  if cur.kind == 1
    set outp = do_dec(cur)
  end
  return take_code(outp.prog, byte(1))
end

fn bind_params(p: prog, toks: toks) -> map bytes i64
  let slots: map bytes i64 = map()
  let i = 0
  let n = toks.count
  let slot = 0
  while i < n
    if tok_kind(toks, i) == 9
      let name = tok_text(toks, i - 1 else fail "math")
      let typed = read_type(p, toks, i + 1 else fail "math")
      set slots = put(slots, name, pack_slot(slot, typed.kind))
      set slot = slot + 1 else fail "math"
      set i = typed.pos - 1 else fail "math"
    end
    set i = i + 1 else fail "math"
  end
  return slots
end

fn hold(p: prog, held: cold) -> prog
  return prog(p.part, p.fills, p.count, p.jumps, held, p.mid, p.mfills)
end
fn with_marks(p: prog, marks: buf) -> prog
  return hold(p, cold(p.cold.pack, marks, p.cold.slots, p.cold.seen, p.cold.parts, p.cold.blocks, p.cold.failto))
end

fn with_slots(p: prog, slots: map bytes i64) -> prog
  return hold(p, cold(p.cold.pack, p.cold.marks, slots, p.cold.seen, p.cold.parts, p.cold.blocks, p.cold.failto))
end

fn with_seen(p: prog, seen: i64) -> prog
  return hold(p, cold(p.cold.pack, p.cold.marks, p.cold.slots, seen, p.cold.parts, p.cold.blocks, p.cold.failto))
end

fn with_failto(p: prog, failto: bytes) -> prog
  return hold(p, cold(p.cold.pack, p.cold.marks, p.cold.slots, p.cold.seen, p.cold.parts, p.cold.blocks, failto))
end

fn with_blocks(p: prog, blocks: list block) -> prog
  return hold(p, cold(p.cold.pack, p.cold.marks, p.cold.slots, p.cold.seen, p.cold.parts, blocks, p.cold.failto))
end

fn drop_last(xs: list block) -> list block
  let out: list block = list()
  let i = 0
  let n = len(xs) - 1 else fail "math"
  while i < n
    set out = push(out, at(xs, i) else fail "block")
    set i = i + 1 else fail "math"
  end
  return out
end

fn emit_rel(p: prog, op: i64, name: bytes) -> prog
  let slot = p.count + 1 else fail "math"
  let jumps = note(p.jumps, slot, name)
  return tack(p, jumps, byte(op) ++ byte(0) ++ byte(0) ++ byte(0) ++ byte(0))
end

fn mark_prog(p: prog, name: bytes) -> prog
  return with_marks(p, note(p.cold.marks, p.count, name))
end

fn tok_eq(toks: toks, index: i64, word: bytes) -> i64
  if index < 0
    return 0
  end
  if index >= toks.count
    return 0
  end
  let packed = locate(toks.raw, index)
  if packed_kind(packed) != 1
    return 0
  end
  let start = packed_start(packed)
  let stop = packed_end(packed)
  let n = len(word)
  let nlen = stop - start else fail "math"
  if nlen != n
    return 0
  end
  return eq_span(toks.raw, start, word, 0, n)
end

fn has_else(toks: toks, pos: i64) -> i64
  let i = pos
  let depth = 0
  let n = toks.count
  while i < n
    let k = tok_kind(toks, i) else fail "token"
    if k == 6
      set depth = depth + 1 else fail "math"
    end
    if k == 7
      set depth = depth - 1 else fail "math"
    end
    if depth == 0
      if k == 8
        return -1
      end
      if k == 1
        if tok_eq(toks, i, "else")
          return i
        end
      end
    end
    if depth < 0
      return -1
    end
    set i = i + 1 else fail "math"
  end
  return -1
end

fn parse_fail_expr(p: prog, toks: toks, pos: i64) -> parsed
  let msg = parse_concat(p, toks, pos + 1 else fail "math")
  let shown = msg
  if msg.kind == 1
    set shown = do_dec(msg)
  end
  let op = 32
  if p.cold.pack.is_main != 0
    set op = 2
  end
  return made(take_code(shown.prog, byte(op)), shown.pos, 0)
end

fn parse_cmp(p: prog, toks: toks, pos: i64) -> parsed
  let cur = parse_sum(p, toks, pos)
  let k = 0
  if cur.pos < toks.count
    set k = tok_kind(toks, cur.pos)
  end
  if k < 13
    return cur
  end
  if k > 18
    return cur
  end
  let right = parse_sum(cur.prog, toks, cur.pos + 1 else fail "math")
  let code = k - 13 else fail "math"
  let cmpd = take_code(right.prog, byte(18) ++ byte(code))
  return made(cmpd, right.pos, 1)
end

fn parse_concat(p: prog, toks: toks, pos: i64) -> parsed
  let cur = parse_cmp(p, toks, pos)
  while tok_is(toks, cur.pos, 5)
    if cur.kind == 1
      set cur = do_dec(cur)
    end
    let right = parse_cmp(cur.prog, toks, cur.pos + 1 else fail "math")
    let rhs = right
    if right.kind == 1
      set rhs = do_dec(right)
    end
    let cat = emit_cat(rhs.prog)
    set cur = made(cat, rhs.pos, 2)
  end
  return cur
end

fn parse_expr(p: prog, toks: toks, pos: i64) -> parsed
  let at_else = has_else(toks, pos)
  if at_else < 0
    return parse_concat(p, toks, pos)
  end
  let cleared = take_code(p, byte(12))
  let n = cleared.cold.seen + 1 else fail "math"
  let alt = "a" ++ n
  let done = "d" ++ n
  let saved = cleared.cold.failto
  let armed = with_failto(with_seen(cleared, n), alt)
  let left = parse_concat(armed, toks, pos)
  if left.pos != at_else
    fail "bad else"
  end
  let jumped = emit_rel(left.prog, 8, done)
  let marked = mark_prog(jumped, alt)
  let restored = with_failto(marked, saved)
  let again = take_code(restored, byte(12))
  let right = parse_expr(again, toks, at_else + 1 else fail "math")
  let finished = mark_prog(right.prog, done)
  let kind = left.kind
  if kind == 0
    set kind = right.kind
  end
  if right.kind != 0
    if left.kind != 0
      if left.kind != right.kind
        fail "type"
      end
    end
  end
  return made(finished, right.pos, kind)
end

fn z4() -> bytes
  let pair = byte(0) ++ byte(0)
  return pair ++ pair
end

fn flat_no(p: prog, pos: i64, seen: i64) -> flat
  let none: list jnote = list()
  return flat(p, "", pos, -1, none, none, seen)
end

fn shift_notes(xs: list jnote, delta: i64) -> list jnote
  let out: list jnote = list()
  let i = 0
  let n = len(xs)
  while i < n
    let jn = at(xs, i) else fail "block"
    let moved = jn.rel + delta else fail "math"
    set out = push(out, jnote(moved, jn.name))
    set i = i + 1 else fail "math"
  end
  return out
end

fn join_notes(left: list jnote, right: list jnote) -> list jnote
  let out = left
  let i = 0
  let n = len(right)
  while i < n
    let jn = at(right, i) else fail "block"
    set out = push(out, jn)
    set i = i + 1 else fail "math"
  end
  return out
end

fn emit_flat(prog: prog, code: bytes, pos: i64, kind: i64, jumps: list jnote, marks: list jnote, seen: i64) -> flat
  return flat(prog, code, pos, kind, jumps, marks, seen)
end

fn atom_base(toks: toks, pos: i64) -> i64
  if pos >= toks.count
    return 0
  end
  let k = tok_kind(toks, pos)
  if k == 2
    return 1
  end
  if k == 3
    return 1
  end
  if k == 1
    if tok_eq(toks, pos, "fail")
      return 0
    end
    if tok_eq(toks, pos, "reason")
      return 1
    end
    let nxt = pos + 1 else fail "math"
    if tok_is(toks, nxt, 6)
      return 0
    end
    if tok_is(toks, nxt, 19)
      return 0
    end
    return 1
  end
  return 0
end

fn has_op(toks: toks, pos: i64, level: i64) -> i64
  if level >= 1
    if product_op(toks, pos) != 0
      return 1
    end
  end
  if level >= 2
    if sum_op(toks, pos) != 0
      return 1
    end
  end
  if level >= 3
    let k = 0
    if pos < toks.count
      set k = tok_kind(toks, pos)
    end
    if k >= 13
      if k <= 18
        return 1
      end
    end
  end
  if level >= 4
    if tok_is(toks, pos, 5)
      return 1
    end
  end
  return 0
end

fn arg_simple(toks: toks, pos: i64) -> i64
  if atom_base(toks, pos) == 0
    return 0
  end
  let nxt = pos + 1 else fail "math"
  if tok_is(toks, nxt, 8)
    return 1
  end
  if tok_is(toks, nxt, 7)
    return 1
  end
  return 0
end

fn rhs_simple(toks: toks, pos: i64, level: i64) -> i64
  if atom_base(toks, pos) == 0
    return 0
  end
  let nxt = pos + 1 else fail "math"
  if has_op(toks, nxt, level)
    return 0
  end
  return 1
end

fn paint_atom(p: prog, toks: toks, pos: i64, seen: i64) -> flat
  let none: list jnote = list()
  let pk = tok_kind(toks, pos)
  if pk == 2
    let num = tok_num(toks, pos)
    let nxt = intern_i64(p, num)
    let ix = seek_i64(nxt.cold.pack.imap, num)
    if ix < 0
      fail "const"
    end
    return emit_flat(nxt, byte(5) ++ u16(ix), pos + 1 else fail "math", 1, none, none, seen)
  end
  if pk == 3
    let lit = tok_text(toks, pos)
    let nxt2 = intern_bytes(p, lit)
    let sx = seek_buf(nxt2.cold.pack.smap, lit)
    if sx < 0
      fail "const"
    end
    return emit_flat(nxt2, byte(5) ++ u16(sx), pos + 1 else fail "math", 2, none, none, seen)
  end
  if pk == 1
    if tok_eq(toks, pos, "reason")
      return emit_flat(p, byte(29), pos + 1 else fail "math", 2, none, none, seen)
    end
    let nm = tok_text(toks, pos)
    if has(p.cold.slots, nm) == 0
      fail "unknown name"
    end
    let raw = get(p.cold.slots, nm) else fail "unknown name"
    return emit_flat(p, byte(7) ++ u16(slot_index(raw)), pos + 1 else fail "math", slot_kind(raw), none, none, seen)
  end
  fail "bad expression"
  return flat_no(p, pos, seen)
end

fn flat_call(p: prog, toks: toks, pos: i64, name: bytes, failto: bytes, seen: i64) -> flat
  if tok_is(toks, pos + 1 else fail "math", 6) == 0
    fail "expected ("
  end
  let prog = p
  let code = ""
  let atp = pos + 2 else fail "math"
  let none: list jnote = list()
  let jumps = none
  let marks = none
  let sn = seen
  let got = 0
  let k0 = 0
  let k1 = 0
  let closed = 0
  let wi = 0
  if tok_is(toks, atp, 7)
    set atp = atp + 1 else fail "math"
    set closed = 1
  end
  while closed == 0
    let want = -1
    if eqb(name, "arg")
      set want = 1
    end
    if eqb(name, "i64")
      set want = 2
    end
    if eqb(name, "byte")
      set want = 1
    end
    if eqb(name, "before")
      set want = 2
    end
    if eqb(name, "after")
      set want = 2
    end
    if eqb(name, "holds")
      set want = 2
    end
    if eqb(name, "save")
      set want = 2
    end
    if eqb(name, "set_byte")
      if wi == 0
        set want = 2
      end
      if wi > 0
        set want = 1
      end
    end
    if eqb(name, "open")
      set want = 2
      if wi == 1
        set want = 1
      end
    end
    if eqb(name, "at")
      if wi == 1
        set want = 1
      end
    end
    if eqb(name, "has")
      if wi >= 1
        let span_k = k0 - 2000 else fail "math"
        set want = span_k / 1000 else fail "math"
      end
    end
    if eqb(name, "get")
      if wi >= 1
        let span_g = k0 - 2000 else fail "math"
        set want = span_g / 1000 else fail "math"
      end
    end
    if eqb(name, "put")
      if wi == 1
        let span_p = k0 - 2000 else fail "math"
        set want = span_p / 1000 else fail "math"
      end
      if wi >= 2
        let span_q = k0 - 2000 else fail "math"
        let pkey = span_q / 1000 else fail "math"
        let pscaled = pkey * 1000 else fail "math"
        set want = span_q - pscaled else fail "math"
      end
    end
    if eqb(name, "push")
      if wi >= 1
        set want = k0 - 1000 else fail "math"
      end
    end
    if eqb(name, "list")
      if wi >= 1
        set want = k0
      end
    end
    if eqb(name, "map")
      if wi >= 2
        let pair = wi / 2 else fail "math"
        let tw = pair * 2 else fail "math"
        if tw == wi
          set want = k0
        end
        if tw != wi
          set want = k1
        end
      end
    end
    if has(p.cold.pack.sname, name)
      let packed = get(p.cold.pack.sname, name) else fail "type"
      let idn = slot_index(packed)
      let key = id_text(idn) ++ "." ++ id_text(wi)
      set want = get(p.cold.pack.sfld, key) else fail "field"
    end
    let akind = 0
    if arg_simple(toks, atp)
      let pk = tok_kind(toks, atp)
      if pk == 2
        let num = tok_num(toks, atp)
        set prog = intern_i64(prog, num)
        let ix = seek_i64(prog.cold.pack.imap, num)
        if ix < 0
          fail "const"
        end
        set code = code ++ byte(5) ++ u16(ix)
        set akind = 1
      end
      if pk == 3
        let lit = tok_text(toks, atp)
        set prog = intern_bytes(prog, lit)
        let sx = seek_buf(prog.cold.pack.smap, lit)
        if sx < 0
          fail "const"
        end
        set code = code ++ byte(5) ++ u16(sx)
        set akind = 2
      end
      if pk == 1
        if tok_eq(toks, atp, "reason")
          set code = code ++ byte(29)
          set akind = 2
        else
          let anm = tok_text(toks, atp)
          if has(prog.cold.slots, anm) == 0
            fail "unknown name"
          end
          let araw = get(prog.cold.slots, anm) else fail "unknown name"
          set code = code ++ byte(7) ++ u16(slot_index(araw))
          set akind = slot_kind(araw)
        end
      end
      set atp = atp + 1 else fail "math"
    else
      let piece = flat_expr(prog, toks, atp, failto, sn)
      if piece.kind < 0
        return piece
      end
      let shift = len(code)
      set jumps = join_notes(jumps, shift_notes(piece.jumps, shift))
      set marks = join_notes(marks, shift_notes(piece.marks, shift))
      set code = code ++ piece.code
      set prog = piece.prog
      set atp = piece.pos
      set sn = piece.seen
      set akind = piece.kind
    end
    if want >= 0
      if akind != want
        fail "type"
      end
    end
    if eqb(name, "list")
      if akind == 0
        fail "type"
      end
    end
    if eqb(name, "map")
      if akind == 0
        fail "type"
      end
    end
    if wi == 0
      set k0 = akind
      if eqb(name, "has")
        if k0 < 2000
          fail "type"
        end
      end
      if eqb(name, "get")
        if k0 < 2000
          fail "type"
        end
      end
      if eqb(name, "put")
        if k0 < 2000
          fail "type"
        end
      end
      if eqb(name, "push")
        if k0 < 1000
          fail "type"
        end
        if k0 >= 2000
          fail "type"
        end
      end
    end
    if wi == 1
      set k1 = akind
    end
    set got = got + 1 else fail "math"
    set wi = wi + 1 else fail "math"
    if tok_is(toks, atp, 7)
      set atp = atp + 1 else fail "math"
      set closed = 1
    else
      if tok_is(toks, atp, 8) == 0
        fail "expected ,"
      end
      set atp = atp + 1 else fail "math"
    end
  end
  let tail = ""
  let outk = 0
  let iff = 0
  let done = 0
  if eqb(name, "argc")
    if got != 0
      fail "arity"
    end
    set tail = byte(21)
    set outk = 1
    set done = 1
  end
  if eqb(name, "arg")
    if got != 1
      fail "arity"
    end
    set tail = byte(22)
    set outk = 2
    set iff = 1
    set done = 1
  end
  if eqb(name, "i64")
    if got != 1
      fail "arity"
    end
    set tail = byte(20)
    set outk = 1
    set iff = 1
    set done = 1
  end
  if eqb(name, "byte")
    if got != 1
      fail "arity"
    end
    set tail = byte(3)
    set outk = 2
    set iff = 1
    set done = 1
  end
  if eqb(name, "len")
    if got != 1
      fail "arity"
    end
    set outk = 1
    set iff = 1
    if k0 == 2
      set tail = byte(25)
    end
    if k0 >= 1000
      if k0 < 2000
        set tail = byte(49)
      end
    end
    if k0 >= 2000
      set tail = byte(56)
    end
    if len(tail) == 0
      fail "type"
    end
    set done = 1
  end
  if eqb(name, "before")
    if got != 2
      fail "arity"
    end
    set tail = byte(35)
    set outk = 2
    set iff = 1
    set done = 1
  end
  if eqb(name, "after")
    if got != 2
      fail "arity"
    end
    set tail = byte(36)
    set outk = 2
    set iff = 1
    set done = 1
  end
  if eqb(name, "holds")
    if got != 2
      fail "arity"
    end
    set tail = byte(37)
    set outk = 1
    set iff = 1
    set done = 1
  end
  if eqb(name, "at")
    if got != 2
      fail "arity"
    end
    set outk = 1
    set iff = 1
    if k0 == 2
      set tail = byte(24)
    end
    if k0 >= 1000
      if k0 < 2000
        set tail = byte(48)
        set outk = k0 - 1000 else fail "math"
      end
    end
    if len(tail) == 0
      fail "type"
    end
    set done = 1
  end
  if eqb(name, "set_byte")
    if got != 3
      fail "arity"
    end
    set tail = byte(10)
    set outk = 2
    set iff = 1
    set done = 1
  end
  if eqb(name, "save")
    if got != 2
      fail "arity"
    end
    set tail = byte(4)
    set outk = 1
    set iff = 1
    set done = 1
  end
  if eqb(name, "open")
    if got != 5
      fail "arity"
    end
    set tail = byte(23)
    set outk = 2
    set iff = 1
    set done = 1
  end
  if eqb(name, "has")
    if got != 2
      fail "arity"
    end
    set tail = byte(55)
    set outk = 1
    set done = 1
  end
  if eqb(name, "get")
    if got != 2
      fail "arity"
    end
    let span_v = k0 - 2000 else fail "math"
    let keyk = span_v / 1000 else fail "math"
    let scaled_v = keyk * 1000 else fail "math"
    set outk = span_v - scaled_v else fail "math"
    set tail = byte(54)
    set iff = 1
    set done = 1
  end
  if eqb(name, "put")
    if got != 3
      fail "arity"
    end
    set tail = byte(53)
    set outk = k0
    set done = 1
  end
  if eqb(name, "push")
    if got != 2
      fail "arity"
    end
    set tail = byte(47)
    set outk = k0
    set done = 1
  end
  if eqb(name, "list")
    if got == 0
      set tail = byte(46) ++ u16(0)
      set outk = 0
    end
    if got != 0
      set tail = byte(46) ++ u16(got)
      set outk = 1000 + k0 else fail "math"
    end
    set done = 1
  end
  if eqb(name, "map")
    if got == 0
      set tail = byte(52) ++ u16(0)
      set outk = 0
    end
    if got != 0
      let pairs = got / 2 else fail "math"
      let even = pairs * 2 else fail "math"
      if even != got
        fail "arity"
      end
      let scaled_m = k0 * 1000 else fail "math"
      set outk = 2000 + scaled_m else fail "math"
      set outk = outk + k1 else fail "math"
      set tail = byte(52) ++ u16(pairs)
    end
    set done = 1
  end
  if done == 0
    if has(p.cold.pack.sname, name)
      let spacked = get(p.cold.pack.sname, name) else fail "type"
      let sid = slot_index(spacked)
      let nfields = slot_kind(spacked)
      if got != nfields
        fail "arity"
      end
      set tail = byte(50) ++ u16(nfields)
      set outk = sid
      set done = 1
    end
  end
  if done == 0
    let idx = seek_buf(p.cold.pack.fnames, name)
    if idx < 0
      fail "unknown function"
    end
    let need = seek_buf(p.cold.pack.arity, name)
    if need < 0
      fail "arity"
    end
    if got != need
      fail "arity"
    end
    let rkfound = seek_buf(p.cold.pack.rets, name)
    let rk = 1
    if rkfound >= 0
      set rk = rkfound
    end
    if rk == 0
      set rk = 1
    end
    set tail = byte(30) ++ u16(idx)
    set outk = rk
    set iff = 1
    set done = 1
  end
  if iff != 0
    let callb = code ++ tail
    let orel = len(callb) + 1 else fail "math"
    set code = callb ++ byte(11) ++ z4()
    set jumps = push(jumps, jnote(orel, failto))
  end
  if iff == 0
    set code = code ++ tail
  end
  while tok_is(toks, atp, 19)
    if tok_is(toks, atp + 1 else fail "math", 1) == 0
      fail "field"
    end
    let field = tok_text(toks, atp + 1 else fail "math")
    if outk == 3
      if eqb(field, "text")
        set code = code ++ byte(28)
        set outk = 2
      else
        if eqb(field, "n")
          set code = code ++ byte(27)
          set outk = 1
        else
          fail "field"
        end
      end
    else
      if outk < 7
        fail "field"
      end
      if outk >= 1000
        fail "field"
      end
      let fkey = id_text(outk) ++ "/" ++ field
      if has(prog.cold.pack.sfld, fkey) == 0
        fail "field"
      end
      let fp = get(prog.cold.pack.sfld, fkey) else fail "field"
      set code = code ++ byte(51) ++ u16(slot_index(fp))
      set outk = slot_kind(fp)
    end
    set atp = atp + 2 else fail "math"
  end
  return emit_flat(prog, code, atp, outk, jumps, marks, sn)
end

fn flat_parse(p: prog, toks: toks, pos: i64, failto: bytes, seen: i64, level: i64) -> flat
  let prog = p
  let code = ""
  let atp = pos
  let kind = 0
  let sn = seen
  let none: list jnote = list()
  let jumps = none
  let marks = none
  let allow_dot = 0
  if pos >= toks.count
    fail "expected expression"
  end
  let kt = tok_kind(toks, pos)
  if kt == 11
    let unary = flat_parse(prog, toks, pos + 1 else fail "math", failto, sn, 0)
    if unary.kind < 0
      return unary
    end
    if unary.kind != 1
      fail "type"
    end
    let ucall = unary.code ++ byte(17)
    let urel = len(ucall) + 1 else fail "math"
    set code = ucall ++ byte(11) ++ z4()
    set jumps = push(unary.jumps, jnote(urel, failto))
    set marks = unary.marks
    set prog = unary.prog
    set atp = unary.pos
    set sn = unary.seen
    set kind = 1
  else
    if kt == 6
      let inner = flat_expr(prog, toks, pos + 1 else fail "math", failto, sn)
      if inner.kind < 0
        return inner
      end
      if tok_is(toks, inner.pos, 7) == 0
        fail "expected )"
      end
      set prog = inner.prog
      set code = inner.code
      set jumps = inner.jumps
      set marks = inner.marks
      set atp = inner.pos + 1 else fail "math"
      set sn = inner.seen
      set kind = inner.kind
      set allow_dot = 1
    else
      if kt == 1
        if tok_eq(toks, pos, "fail")
          let msg = flat_parse(prog, toks, pos + 1 else fail "math", failto, sn, 4)
          if msg.kind < 0
            return msg
          end
          let mcode = msg.code
          if msg.kind == 1
            set mcode = mcode ++ byte(34)
          end
          let fop = 32
          if p.cold.pack.is_main != 0
            set fop = 2
          end
          set mcode = mcode ++ byte(fop)
          return emit_flat(msg.prog, mcode, msg.pos, 0, msg.jumps, msg.marks, msg.seen)
        end
        if tok_eq(toks, pos, "reason")
          set code = byte(29)
          set atp = pos + 1 else fail "math"
          set kind = 2
        else
          if tok_is(toks, pos + 1 else fail "math", 6)
            let cnm = tok_text(toks, pos)
            let called = flat_call(prog, toks, pos, cnm, failto, sn)
            if called.kind < 0
              return called
            end
            if has_op(toks, called.pos, level) == 0
              return called
            end
            set prog = called.prog
            set code = called.code
            set jumps = called.jumps
            set marks = called.marks
            set atp = called.pos
            set sn = called.seen
            set kind = called.kind
          else
            let nm = tok_text(toks, pos)
            if has(prog.cold.slots, nm) == 0
              fail "unknown name"
            end
            let raw = get(prog.cold.slots, nm) else fail "unknown name"
            set code = byte(7) ++ u16(slot_index(raw))
            set kind = slot_kind(raw)
            set atp = pos + 1 else fail "math"
            set allow_dot = 1
          end
        end
      else
        if kt == 2
          let num = tok_num(toks, pos)
          set prog = intern_i64(prog, num)
          let ix = seek_i64(prog.cold.pack.imap, num)
          if ix < 0
            fail "const"
          end
          set code = byte(5) ++ u16(ix)
          set kind = 1
          set atp = pos + 1 else fail "math"
        else
          if kt == 3
            let lit = tok_text(toks, pos)
            set prog = intern_bytes(prog, lit)
            let sx = seek_buf(prog.cold.pack.smap, lit)
            if sx < 0
              fail "const"
            end
            set code = byte(5) ++ u16(sx)
            set kind = 2
            set atp = pos + 1 else fail "math"
          else
            fail "bad expression"
          end
        end
      end
    end
  end
  while allow_dot != 0
    if tok_is(toks, atp, 19) == 0
      set allow_dot = 0
    else
      if tok_is(toks, atp + 1 else fail "math", 1) == 0
        fail "field"
      end
      let fld = tok_text(toks, atp + 1 else fail "math")
      if kind == 3
        if eqb(fld, "text")
          set code = code ++ byte(28)
          set kind = 2
        else
          if eqb(fld, "n")
            set code = code ++ byte(27)
            set kind = 1
          else
            fail "field"
          end
        end
      else
        if kind < 7
          fail "field"
        end
        if kind >= 1000
          fail "field"
        end
        let dkey = id_text(kind) ++ "/" ++ fld
        if has(prog.cold.pack.sfld, dkey) == 0
          fail "field"
        end
        let dp = get(prog.cold.pack.sfld, dkey) else fail "field"
        set code = code ++ byte(51) ++ u16(slot_index(dp))
        set kind = slot_kind(dp)
      end
      set atp = atp + 2 else fail "math"
    end
  end
  if has_op(toks, atp, level) == 0
    return emit_flat(prog, code, atp, kind, jumps, marks, sn)
  end
  let stop = 0
  let saw_cmp = 0
  while stop == 0
    let op = 0
    let iff = 0
    let cop = 0
    let rlevel = 0
    let took = 0
    if level >= 1
      let pop = product_op(toks, atp)
      if pop != 0
        set op = pop
        set iff = 1
        set rlevel = 0
        set took = 1
      end
    end
    if took == 0
      if level >= 2
        let sop = sum_op(toks, atp)
        if sop != 0
          set op = sop
          set iff = 1
          set rlevel = 1
          set took = 1
        end
      end
    end
    if took == 0
      if saw_cmp == 0
        if level >= 3
          let ck = 0
          if atp < toks.count
            set ck = tok_kind(toks, atp)
          end
          if ck >= 13
            if ck <= 18
              set op = 18
              set cop = ck - 13 else fail "math"
              set rlevel = 2
              set took = 1
              set saw_cmp = 1
            end
          end
        end
      end
    end
    if took == 0
      if level >= 4
        if tok_is(toks, atp, 5)
          set op = 19
          set rlevel = 3
          set took = 2
        end
      end
    end
    if took == 0
      set stop = 1
    else
      if iff != 0
        if kind != 1
          fail "type"
        end
      end
      if took == 2
        if kind == 1
          set code = code ++ byte(34)
          set kind = 2
        end
      end
      let rhs_at = atp + 1 else fail "math"
      let shift = len(code)
      let rkind = 0
      let rprog = prog
      let rcode = ""
      let rat = rhs_at
      let rsn = sn
      let rjumps = none
      let rmarks = none
      if rhs_simple(toks, rhs_at, rlevel)
        let bit = paint_atom(prog, toks, rhs_at, sn)
        set rprog = bit.prog
        set rcode = bit.code
        set rat = bit.pos
        set rsn = bit.seen
        set rkind = bit.kind
        set rjumps = bit.jumps
        set rmarks = bit.marks
      else
        let deep = flat_parse(prog, toks, rhs_at, failto, sn, rlevel)
        if deep.kind < 0
          return deep
        end
        set rprog = deep.prog
        set rcode = deep.code
        set rat = deep.pos
        set rsn = deep.seen
        set rkind = deep.kind
        set rjumps = deep.jumps
        set rmarks = deep.marks
      end
      if iff != 0
        if rkind != 1
          fail "type"
        end
      end
      set jumps = join_notes(jumps, shift_notes(rjumps, shift))
      set marks = join_notes(marks, shift_notes(rmarks, shift))
      set code = code ++ rcode
      set prog = rprog
      set atp = rat
      set sn = rsn
      if took == 2
        if rkind == 1
          set code = code ++ byte(34)
        end
        set code = code ++ byte(19)
        set kind = 2
      end
      if took == 1
        if iff != 0
          let callb = code ++ byte(op)
          let orel = len(callb) + 1 else fail "math"
          set code = callb ++ byte(11) ++ z4()
          set jumps = push(jumps, jnote(orel, failto))
          set kind = 1
        end
        if iff == 0
          set code = code ++ byte(op) ++ byte(cop)
          set kind = 1
        end
      end
    end
  end
  return emit_flat(prog, code, atp, kind, jumps, marks, sn)
end

fn flat_expr(p: prog, toks: toks, pos: i64, failto: bytes, seen: i64) -> flat
  let at_else = has_else(toks, pos)
  if at_else < 0
    return flat_parse(p, toks, pos, failto, seen, 4)
  end
  let n = seen + 1 else fail "math"
  let alt = "a" ++ n
  let done_name = "d" ++ n
  let left = flat_parse(p, toks, pos, alt, n, 4)
  if left.kind < 0
    return flat_no(p, pos, seen)
  end
  if left.pos != at_else
    fail "bad else"
  end
  let jmp_rel = 1 + len(left.code) + 1 else fail "math"
  let merged = byte(12) ++ left.code ++ byte(8) ++ z4()
  let j2 = shift_notes(left.jumps, 1)
  set j2 = push(j2, jnote(jmp_rel, done_name))
  let m2 = shift_notes(left.marks, 1)
  set m2 = push(m2, jnote(len(merged), alt))
  let right = flat_expr(left.prog, toks, at_else + 1 else fail "math", failto, left.seen)
  if right.kind < 0
    return flat_no(p, pos, seen)
  end
  let code2 = merged ++ byte(12) ++ right.code
  let delta = len(merged) + 1 else fail "math"
  set j2 = join_notes(j2, shift_notes(right.jumps, delta))
  set m2 = join_notes(m2, shift_notes(right.marks, delta))
  set m2 = push(m2, jnote(len(code2), done_name))
  let ek = left.kind
  if ek == 0
    set ek = right.kind
  end
  if right.kind != 0
    if left.kind != 0
      if left.kind != right.kind
        fail "type"
      end
    end
  end
  return emit_flat(right.prog, code2, right.pos, ek, j2, m2, right.seen)
end

fn flat_fail(p: prog, toks: toks, pos: i64, failto: bytes, seen: i64) -> flat
  return flat_parse(p, toks, pos, failto, seen, 4)
end
fn flat_apply(fl: flat, suffix: bytes) -> prog
  let code = fl.code ++ suffix
  let jumps = fl.prog.jumps
  let ji = 0
  let jlen = len(fl.jumps)
  while ji < jlen
    let item = at(fl.jumps, ji) else fail "block"
    let slot = fl.prog.count + item.rel else fail "math"
    set jumps = note(jumps, slot, item.name)
    set ji = ji + 1 else fail "math"
  end
  let marks = fl.prog.cold.marks
  let mi = 0
  let mlen = len(fl.marks)
  while mi < mlen
    let item2 = at(fl.marks, mi) else fail "block"
    let atn = fl.prog.count + item2.rel else fail "math"
    set marks = note(marks, atn, item2.name)
    set mi = mi + 1 else fail "math"
  end
  let tacked = tack(fl.prog, jumps, code)
  let seen_p = tacked
  if fl.seen != tacked.cold.seen
    set seen_p = with_seen(tacked, fl.seen)
  end
  if mlen != 0
    return with_marks(seen_p, marks)
  end
  return seen_p
end

fn emit_let_fast(p: prog, toks: toks) -> prog
  if toks.count < 4
    return p
  end
  if tok_kind(toks, 1) != 1
    return p
  end
  let eq_at = 2
  let ann = 0
  if tok_kind(toks, 2) == 9
    let typed = read_type(p, toks, 3)
    if tok_is(toks, typed.pos, 12) == 0
      return p
    end
    set ann = typed.kind
    set eq_at = typed.pos
  end
  if tok_kind(toks, eq_at) != 12
    return p
  end
  let name = tok_text(toks, 1)
  if has(p.cold.slots, name)
    fail "already bound"
  end
  let fl = flat_expr(p, toks, eq_at + 1 else fail "math", p.cold.failto, p.cold.seen)
  if fl.kind < 0
    return p
  end
  if fl.pos != toks.count
    fail "extra tokens"
  end
  let kind = fl.kind
  if ann != 0
    if kind == 0
      set kind = ann
    end
    if kind != ann
      fail "type"
    end
  end
  if kind == 0
    fail "let needs a value"
  end
  let slot = len(fl.prog.cold.slots)
  let slots = put(fl.prog.cold.slots, name, pack_slot(slot, kind))
  let applied = flat_apply(fl, byte(6) ++ u16(slot))
  return with_slots(applied, slots)
end

fn emit_set_fast(p: prog, toks: toks) -> prog
  if toks.count < 4
    return p
  end
  if tok_kind(toks, 1) != 1
    return p
  end
  if tok_kind(toks, 2) != 12
    return p
  end
  let name = tok_text(toks, 1)
  if has(p.cold.slots, name) == 0
    return p
  end
  let raw = get(p.cold.slots, name) else fail "unknown name"
  let slot = slot_index(raw)
  if slot < p.cold.pack.nparams
    return p
  end
  if slot_kind(raw) == 2
    if toks.count >= 5
      if tok_kind(toks, 3) == 1
        if eqb(tok_text(toks, 3), name)
          if tok_kind(toks, 4) == 5
            if has_else(toks, 3) < 0
              let rhs = flat_expr(p, toks, 5, p.cold.failto, p.cold.seen)
              if rhs.kind >= 0
                if rhs.pos == toks.count
                  let body = rhs
                  if rhs.kind == 1
                    set body = flat(rhs.prog, rhs.code ++ byte(34), rhs.pos, 2, rhs.jumps, rhs.marks, rhs.seen)
                  end
                  let applied = flat_apply(body, byte(33) ++ u16(slot))
                  let slots = put(applied.cold.slots, name, pack_slot(slot, 2))
                  return with_slots(applied, slots)
                end
              end
            end
          end
        end
      end
    end
  end
  let fl = flat_expr(p, toks, 3, p.cold.failto, p.cold.seen)
  if fl.kind < 0
    return p
  end
  if fl.pos != toks.count
    fail "extra tokens"
  end
  if fl.kind == 0
    fail "set needs a value"
  end
  let applied2 = flat_apply(fl, byte(6) ++ u16(slot))
  if fl.kind == slot_kind(raw)
    return applied2
  end
  let slots2 = put(applied2.cold.slots, name, pack_slot(slot, fl.kind))
  return with_slots(applied2, slots2)
end

fn emit_if_fast(p: prog, toks: toks) -> prog
  let fl = flat_expr(p, toks, 1, p.cold.failto, p.cold.seen)
  if fl.kind < 0
    return p
  end
  if fl.pos != toks.count
    fail "extra tokens"
  end
  if fl.kind != 1
    fail "if needs an i64"
  end
  let n = fl.seen + 1 else fail "math"
  let alt = "a" ++ n
  let done = "d" ++ n
  let rel = len(fl.code) + 1 else fail "math"
  let jumps = push(fl.jumps, jnote(rel, alt))
  let code = fl.code ++ byte(9) ++ z4()
  let fl2 = flat(fl.prog, code, fl.pos, 1, jumps, fl.marks, n)
  let applied = flat_apply(fl2, "")
  let blocks = push(applied.cold.blocks, block(1, alt, done))
  return with_blocks(applied, blocks)
end

fn emit_return_fast(p: prog, toks: toks) -> prog
  let fl = flat_expr(p, toks, 1, p.cold.failto, p.cold.seen)
  if fl.kind < 0
    return p
  end
  if fl.pos != toks.count
    fail "extra tokens"
  end
  return flat_apply(fl, byte(31))
end

fn emit_write_fast(p: prog, toks: toks) -> prog
  let fl = flat_expr(p, toks, 1, p.cold.failto, p.cold.seen)
  if fl.kind < 0
    return p
  end
  if fl.pos != toks.count
    fail "extra tokens"
  end
  let suffix = byte(1)
  if fl.kind == 1
    set suffix = byte(34) ++ byte(1)
  end
  return flat_apply(fl, suffix)
end

fn emit_fail_fast(p: prog, toks: toks) -> prog
  if tok_eq(toks, 0, "fail") == 0
    return p
  end
  let fl = flat_fail(p, toks, 0, p.cold.failto, p.cold.seen)
  if fl.kind < 0
    return p
  end
  if fl.pos != toks.count
    fail "extra tokens"
  end
  return flat_apply(fl, "")
end

fn emit_let(p: prog, toks: toks) -> prog
  let fast = emit_let_fast(p, toks)
  if fast.count != p.count
    return fast
  end
  if toks.count < 4
    fail "expected a name"
  end
  if tok_kind(toks, 1) != 1
    fail "expected a name"
  end
  let eq_at = 2
  let ann = 0
  if tok_kind(toks, 2) == 9
    let typed = read_type(p, toks, 3)
    if tok_is(toks, typed.pos, 12) == 0
      fail "expected ="
    end
    set ann = typed.kind
    set eq_at = typed.pos
  end
  if tok_kind(toks, eq_at) != 12
    fail "expected ="
  end
  let name = tok_text(toks, 1)
  if has(p.cold.slots, name)
    fail "already bound"
  end
  let cur = parse_expr(p, toks, eq_at + 1 else fail "math")
  if cur.pos != toks.count
    fail "extra tokens"
  end
  let kind = cur.kind
  if ann != 0
    if kind == 0
      set kind = ann
    end
    if kind != ann
      fail "type"
    end
  end
  if kind == 0
    fail "let needs a value"
  end
  let slot = len(cur.prog.cold.slots)
  let slots = put(cur.prog.cold.slots, name, pack_slot(slot, kind))
  let bound = with_slots(cur.prog, slots)
  return take_code(bound, byte(6) ++ u16(slot))
end

fn emit_append(p: prog, toks: toks, name: bytes, slot: i64) -> prog
  if toks.count < 5
    return p
  end
  if tok_kind(toks, 3) != 1
    return p
  end
  if eqb(tok_text(toks, 3), name) == 0
    return p
  end
  if tok_kind(toks, 4) != 5
    return p
  end
  if has_else(toks, 3) >= 0
    return p
  end
  let rhs = parse_expr(p, toks, 5)
  if rhs.pos != toks.count
    fail "extra tokens"
  end
  if rhs.kind == 0
    fail "set needs a value"
  end
  let right = rhs
  if rhs.kind == 1
    set right = do_dec(rhs)
  end
  let slots = put(right.prog.cold.slots, name, pack_slot(slot, 2))
  let bound = with_slots(right.prog, slots)
  return take_code(bound, byte(33) ++ u16(slot))
end

fn emit_plain_set(p: prog, toks: toks) -> prog
  if toks.count < 6
    return p
  end
  if tok_kind(toks, 1) != 1
    return p
  end
  if tok_kind(toks, 2) != 12
    return p
  end
  if tok_kind(toks, 3) != 1
    return p
  end
  if tok_kind(toks, 4) != 6
    return p
  end
  if has_else(toks, 3) >= 0
    return p
  end
  let name = tok_text(toks, 1)
  if has(p.cold.slots, name) == 0
    return p
  end
  let raw = get(p.cold.slots, name) else fail "unknown name"
  let slot = slot_index(raw)
  if slot < p.cold.pack.nparams
    return p
  end
  let fp = locate(toks.raw, 3)
  let fs = packed_start(fp)
  let fe = packed_end(fp)
  let flen = fe - fs else fail "math"
  if seek_span_buf(p.cold.pack.fnames, toks.raw, fs, flen) < 0
    return p
  end
  let want = seek_span_buf(p.cold.pack.arity, toks.raw, fs, flen)
  if want < 0
    return p
  end
  let i = 5
  let code = ""
  let pcur = p
  let got = 0
  let mode = 1
  while mode == 1
    if i >= toks.count
      set mode = 0
    else
      let k = tok_kind(toks, i)
      if k == 7
        set i = i + 1 else fail "math"
        set mode = 2
      else
        if k == 2
          let packed = locate(toks.raw, i)
          let a = packed_start(packed)
          let b = packed_end(packed)
          let nlen = b - a else fail "math"
          if nlen >= 19
            set mode = 0
          else
            let num = span_i64(toks.raw, a, b)
            set pcur = intern_i64(pcur, num)
            let ix = seek_i64(pcur.cold.pack.imap, num)
            if ix < 0
              fail "const"
            end
            set code = code ++ byte(5) ++ u16(ix)
            set i = i + 1 else fail "math"
            set got = got + 1 else fail "math"
          end
        else
          if k == 3
            let lit = tok_text(toks, i)
            set pcur = intern_bytes(pcur, lit)
            let sx = seek_buf(pcur.cold.pack.smap, lit)
            if sx < 0
              fail "const"
            end
            set code = code ++ byte(5) ++ u16(sx)
            set i = i + 1 else fail "math"
            set got = got + 1 else fail "math"
          else
            if k == 1
              if tok_is(toks, i + 1 else fail "math", 6)
                set mode = 0
              else
                if tok_is(toks, i + 1 else fail "math", 19)
                  set mode = 0
                else
                  if tok_eq(toks, i, "fail")
                    set mode = 0
                  else
                    if tok_eq(toks, i, "reason")
                      set mode = 0
                    else
                      let nm = tok_text(toks, i)
                      if has(pcur.cold.slots, nm) == 0
                        set mode = 0
                      else
                        let raws = get(pcur.cold.slots, nm) else fail "unknown name"
                        set code = code ++ byte(7) ++ u16(slot_index(raws))
                        set i = i + 1 else fail "math"
                        set got = got + 1 else fail "math"
                      end
                    end
                  end
                end
              end
            else
              set mode = 0
            end
          end
        end
        if mode == 1
          if tok_is(toks, i, 8)
            set i = i + 1 else fail "math"
          else
            if tok_is(toks, i, 7)
              set i = i + 1 else fail "math"
              set mode = 2
            else
              set mode = 0
            end
          end
        end
      end
    end
  end
  if mode != 2
    return p
  end
  if i != toks.count
    return p
  end
  if got != want
    return p
  end
  let idx = seek_span_buf(p.cold.pack.fnames, toks.raw, fs, flen)
  if idx < 0
    return p
  end
  let rk = seek_span_buf(p.cold.pack.rets, toks.raw, fs, flen)
  if rk <= 0
    set rk = 1
  end
  let base = pcur
  if rk != slot_kind(raw)
    let slots = put(base.cold.slots, name, pack_slot(slot, rk))
    set base = with_slots(base, slots)
  end
  let call = code ++ byte(30) ++ u16(idx)
  let slotj = base.count + len(call) + 1 else fail "math"
  let jumps = note(base.jumps, slotj, base.cold.failto)
  let tail = byte(11) ++ byte(0) ++ byte(0) ++ byte(0) ++ byte(0) ++ byte(6) ++ u16(slot)
  return tack(base, jumps, call ++ tail)
end

fn emit_set(p: prog, toks: toks) -> prog
  let plain = emit_plain_set(p, toks)
  if plain.count != p.count
    return plain
  end
  let fast = emit_set_fast(p, toks)
  if fast.count != p.count
    return fast
  end
  if toks.count < 4
    fail "expected a name"
  end
  if tok_kind(toks, 1) != 1
    fail "expected a name"
  end
  if tok_kind(toks, 2) != 12
    fail "expected ="
  end
  let name = tok_text(toks, 1)
  if has(p.cold.slots, name) == 0
    fail "unknown name"
  end
  let raw = get(p.cold.slots, name) else fail "unknown name"
  let slot = slot_index(raw)
  if slot < p.cold.pack.nparams
    fail "parameter"
  end
  if slot_kind(raw) == 2
    let appended = emit_append(p, toks, name, slot)
    if appended.count != p.count
      return appended
    end
  end
  let cur = parse_expr(p, toks, 3)
  if cur.pos != toks.count
    fail "extra tokens"
  end
  if cur.kind == 0
    fail "set needs a value"
  end
  if cur.kind == slot_kind(raw)
    return take_code(cur.prog, byte(6) ++ u16(slot))
  end
  let slots = put(cur.prog.cold.slots, name, pack_slot(slot, cur.kind))
  let bound = with_slots(cur.prog, slots)
  return take_code(bound, byte(6) ++ u16(slot))
end

fn emit_if(p: prog, toks: toks) -> prog
  let fast = emit_if_fast(p, toks)
  if fast.count != p.count
    return fast
  end
  let cur = parse_expr(p, toks, 1)
  if cur.pos != toks.count
    fail "extra tokens"
  end
  if cur.kind != 1
    fail "if needs an i64"
  end
  let n = cur.prog.cold.seen + 1 else fail "math"
  let alt = "a" ++ n
  let done = "d" ++ n
  let jumped = emit_rel(with_seen(cur.prog, n), 9, alt)
  let blocks = push(jumped.cold.blocks, made_block(1, alt, done))
  return with_blocks(jumped, blocks)
end

fn emit_while(p: prog, toks: toks) -> prog
  let n = p.cold.seen + 1 else fail "math"
  let head = "h" ++ n
  let done = "d" ++ n
  let marked = mark_prog(with_seen(p, n), head)
  let cur = parse_expr(marked, toks, 1)
  if cur.pos != toks.count
    fail "extra tokens"
  end
  if cur.kind != 1
    fail "while needs an i64"
  end
  let jumped = emit_rel(cur.prog, 9, done)
  let blocks = push(jumped.cold.blocks, made_block(2, head, done))
  return with_blocks(jumped, blocks)
end

fn emit_else(p: prog, toks: toks) -> prog
  if toks.count != 1
    fail "extra tokens"
  end
  if len(p.cold.blocks) == 0
    fail "else"
  end
  let n = len(p.cold.blocks) - 1 else fail "math"
  let top = at(p.cold.blocks, n) else fail "else"
  if top.kind != 1
    fail "else"
  end
  let jumped = emit_rel(p, 8, top.done)
  let marked = mark_prog(jumped, top.alt)
  let rest = drop_last(marked.cold.blocks)
  let blocks = push(rest, made_block(3, top.alt, top.done))
  return with_blocks(marked, blocks)
end

fn emit_fail_stmt(p: prog, toks: toks) -> prog
  let fast = emit_fail_fast(p, toks)
  if fast.count != p.count
    return fast
  end
  let cur = parse_fail_expr(p, toks, 0)
  if cur.pos != toks.count
    fail "extra tokens"
  end
  return cur.prog
end

fn end_stmt(p: prog) -> prog
  if len(p.cold.blocks) == 0
    return close_fn(p)
  end
  let n = len(p.cold.blocks) - 1 else fail "math"
  let top = at(p.cold.blocks, n) else fail "block"
  let rest = drop_last(p.cold.blocks)
  if top.kind == 1
    return with_blocks(mark_prog(p, top.alt), rest)
  end
  if top.kind == 3
    return with_blocks(mark_prog(p, top.done), rest)
  end
  if top.kind == 2
    let jumped = emit_rel(p, 8, top.alt)
    return with_blocks(mark_prog(jumped, top.done), rest)
  end
  if top.kind == 4
    let tailb = after(top.done, "n") else fail "block"
    let numtextb = before(tailb, "x") else fail "block"
    let number_slot = i64(numtextb) else fail "block"
    let pushedb = emit_push_slot(p, number_slot)
    let oneb = push_i64(pushedb, 1)
    let addedb = emit_add(oneb)
    let poppedb = emit_pop_slot(addedb, number_slot)
    let jumpedb = emit_rel(poppedb, 8, top.alt)
    return with_blocks(mark_prog(jumpedb, top.done), rest)
  end
  if top.kind == 5
    let tailm = after(top.done, "m") else fail "block"
    let numtextm = before(tailm, "z") else fail "block"
    let index_slot = i64(numtextm) else fail "block"
    let pushedm = emit_push_slot(p, index_slot)
    let onem = push_i64(pushedm, 1)
    let addedm = emit_add(onem)
    let poppedm = emit_pop_slot(addedm, index_slot)
    let jumpedm = emit_rel(poppedm, 8, top.alt)
    return with_blocks(mark_prog(jumpedm, top.done), rest)
  end
  fail "block"
  return p
end

fn emit_for_bytes(p: prog, toks: toks) -> prog
  if toks.count < 6
    fail "expected a name"
  end
  if tok_kind(toks, 1) != 1
    fail "expected a name"
  end
  if tok_kind(toks, 2) != 1
    fail "expected in"
  end
  if eqb(tok_text(toks, 2), "in") == 0
    fail "expected in"
  end
  if tok_kind(toks, 3) != 1
    fail "for needs bytes"
  end
  if eqb(tok_text(toks, 3), "bytes") == 0
    fail "for needs bytes"
  end
  if tok_kind(toks, 4) != 6
    fail "expected ("
  end
  let name = tok_text(toks, 1)
  if has(p.cold.slots, name)
    fail "already bound"
  end
  let cur = parse_expr(p, toks, 5)
  if cur.kind != 2
    fail "bytes needs bytes"
  end
  if tok_is(toks, cur.pos, 7) == 0
    fail "expected )"
  end
  let endp = cur.pos + 1 else fail "math"
  if endp != toks.count
    fail "extra tokens"
  end
  let base = len(cur.prog.cold.slots)
  let text_slot = base
  let index_slot = base + 1 else fail "math"
  let byte_slot = base + 2 else fail "math"
  let n = cur.prog.cold.seen + 1 else fail "math"
  let loop = "k" ++ n
  let body = "b" ++ n
  let done = "m" ++ index_slot ++ "z" ++ n
  let slots = cur.prog.cold.slots
  set slots = put(slots, byte(1) ++ n ++ "t", pack_slot(text_slot, 2))
  set slots = put(slots, byte(1) ++ n ++ "i", pack_slot(index_slot, 1))
  set slots = put(slots, name, pack_slot(byte_slot, 1))
  let bound = with_slots(with_seen(cur.prog, n), slots)
  let popped = emit_pop_slot(bound, text_slot)
  let zero = push_i64(popped, 0)
  let popz = emit_pop_slot(zero, index_slot)
  let looped = mark_prog(popz, loop)
  let pushed = emit_push_slot(looped, index_slot)
  let pushed2 = emit_push_slot(pushed, text_slot)
  let lengthed = emit_iffail(take_code(pushed2, byte(25)))
  let cmpd = take_code(lengthed, byte(18) ++ byte(5))
  let to_body = emit_rel(cmpd, 9, body)
  let to_done = emit_rel(to_body, 8, done)
  let at_body = mark_prog(to_done, body)
  let ptext = emit_push_slot(at_body, text_slot)
  let pindex = emit_push_slot(ptext, index_slot)
  let viewed = emit_iffail(take_code(pindex, byte(24)))
  let popb = emit_pop_slot(viewed, byte_slot)
  let blocks = push(popb.cold.blocks, made_block(5, loop, done))
  return with_blocks(popb, blocks)
end

fn emit_for_agg(p: prog, toks: toks) -> prog
  if toks.count < 4
    fail "expected a name"
  end
  if tok_kind(toks, 1) != 1
    fail "expected a name"
  end
  if tok_kind(toks, 2) != 1
    fail "expected in"
  end
  if eqb(tok_text(toks, 2), "in") == 0
    fail "expected in"
  end
  let name = tok_text(toks, 1)
  if has(p.cold.slots, name)
    fail "already bound"
  end
  let cur = parse_expr(p, toks, 3)
  if cur.pos != toks.count
    fail "extra tokens"
  end
  let len_op = 0
  let at_op = 0
  let item_kind = 0
  if cur.kind >= 1000
    if cur.kind < 2000
      set len_op = 49
      set at_op = 48
      set item_kind = cur.kind - 1000 else fail "math"
    end
  end
  if cur.kind >= 2000
    set len_op = 56
    set at_op = 57
    let span = cur.kind - 2000 else fail "math"
    set item_kind = span / 1000 else fail "math"
  end
  if len_op == 0
    fail "for needs lines"
  end
  let base = len(cur.prog.cold.slots)
  let text_slot = base
  let index_slot = base + 1 else fail "math"
  let item_slot = base + 2 else fail "math"
  let n = cur.prog.cold.seen + 1 else fail "math"
  let loop = "k" ++ n
  let body = "b" ++ n
  let done = "m" ++ index_slot ++ "z" ++ n
  let slots = cur.prog.cold.slots
  set slots = put(slots, byte(1) ++ n ++ "t", pack_slot(text_slot, cur.kind))
  set slots = put(slots, byte(1) ++ n ++ "i", pack_slot(index_slot, 1))
  set slots = put(slots, name, pack_slot(item_slot, item_kind))
  let bound = with_slots(with_seen(cur.prog, n), slots)
  let popped = emit_pop_slot(bound, text_slot)
  let zero = push_i64(popped, 0)
  let popz = emit_pop_slot(zero, index_slot)
  let looped = mark_prog(popz, loop)
  let pushed = emit_push_slot(looped, index_slot)
  let pushed2 = emit_push_slot(pushed, text_slot)
  let lengthed = emit_iffail(take_code(pushed2, byte(len_op)))
  let cmpd = take_code(lengthed, byte(18) ++ byte(5))
  let to_body = emit_rel(cmpd, 9, body)
  let to_done = emit_rel(to_body, 8, done)
  let at_body = mark_prog(to_done, body)
  let ptext = emit_push_slot(at_body, text_slot)
  let pindex = emit_push_slot(ptext, index_slot)
  let viewed = emit_iffail(take_code(pindex, byte(at_op)))
  let popb = emit_pop_slot(viewed, item_slot)
  let blocks = push(popb.cold.blocks, made_block(5, loop, done))
  return with_blocks(popb, blocks)
end

fn emit_for(p: prog, toks: toks) -> prog
  if toks.count < 4
    fail "expected a name"
  end
  if tok_kind(toks, 1) != 1
    fail "expected a name"
  end
  if tok_kind(toks, 2) != 1
    fail "expected in"
  end
  if eqb(tok_text(toks, 2), "in") == 0
    fail "expected in"
  end
  if tok_kind(toks, 3) != 1
    return emit_for_agg(p, toks)
  end
  if eqb(tok_text(toks, 3), "bytes")
    return emit_for_bytes(p, toks)
  end
  if eqb(tok_text(toks, 3), "lines") == 0
    return emit_for_agg(p, toks)
  end
  if tok_kind(toks, 4) != 6
    fail "expected ("
  end
  let name = tok_text(toks, 1)
  if has(p.cold.slots, name)
    fail "already bound"
  end
  let cur = parse_expr(p, toks, 5)
  if cur.kind != 2
    fail "lines needs bytes"
  end
  if tok_is(toks, cur.pos, 7) == 0
    fail "expected )"
  end
  let endp = cur.pos + 1 else fail "math"
  if endp != toks.count
    fail "extra tokens"
  end
  let base = len(cur.prog.cold.slots)
  let text_slot = base
  let index_slot = base + 1 else fail "math"
  let number_slot = base + 2 else fail "math"
  let line_slot = base + 3 else fail "math"
  let n = cur.prog.cold.seen + 1 else fail "math"
  let loop = "k" ++ n
  let body = "b" ++ n
  let done = "n" ++ number_slot ++ "x" ++ n
  let slots = cur.prog.cold.slots
  set slots = put(slots, byte(1) ++ n ++ "t", pack_slot(text_slot, 2))
  set slots = put(slots, byte(1) ++ n ++ "i", pack_slot(index_slot, 1))
  set slots = put(slots, byte(1) ++ n ++ "u", pack_slot(number_slot, 1))
  set slots = put(slots, name, pack_slot(line_slot, 3))
  let bound = with_slots(with_seen(cur.prog, n), slots)
  let popped = emit_pop_slot(bound, text_slot)
  let zero = push_i64(popped, 0)
  let popz = emit_pop_slot(zero, index_slot)
  let one = push_i64(popz, 1)
  let popn = emit_pop_slot(one, number_slot)
  let looped = mark_prog(popn, loop)
  let pushed = emit_push_slot(looped, index_slot)
  let pushed2 = emit_push_slot(pushed, text_slot)
  let lengthed = emit_iffail(take_code(pushed2, byte(25)))
  let cmpd = take_code(lengthed, byte(18) ++ byte(5))
  let to_body = emit_rel(cmpd, 9, body)
  let to_done = emit_rel(to_body, 8, done)
  let at_body = mark_prog(to_done, body)
  let ptext = emit_push_slot(at_body, text_slot)
  let pindex = emit_push_slot(ptext, index_slot)
  let pnum = emit_push_slot(pindex, number_slot)
  let viewed = emit_iffail(take_code(pnum, byte(26)))
  let popi = emit_pop_slot(viewed, index_slot)
  let popl = emit_pop_slot(popi, line_slot)
  let blocks = push(popl.cold.blocks, made_block(4, loop, done))
  return with_blocks(popl, blocks)
end


fn on_line(p: prog, text: bytes) -> prog
  let toks = lex(text)
  if toks.count == 0
    return p
  end
  let head = tok_text(toks, 0)
  if p.cold.pack.live == 3
    if eqb(head, "end")
      if toks.count != 1
        fail "extra tokens"
      end
      return with_row(p, p.cold.pack.sname, p.cold.pack.sfld, p.cold.pack.nstruct, "", 0, 0)
    end
    return p
  end
  if p.cold.pack.live == 0
    if eqb(head, "fn")
      if toks.count < 2
        fail "expected a name"
      end
      let name = tok_text(toks, 1)
      if eqb(name, "main")
        if toks.count != 2
          fail "main takes no parameters"
        end
      end
      return enter_fn(p, name, bind_params(p, toks))
    end
    if eqb(head, "phase")
      return p
    end
    if eqb(head, "gauge")
      return p
    end
    if eqb(head, "struct")
      return with_row(p, p.cold.pack.sname, p.cold.pack.sfld, p.cold.pack.nstruct, "", 0, 3)
    end
    if eqb(head, "use")
      fail "use needs a source file"
    end
    fail "expected fn"
    return p
  end
  if eqb(head, "end")
    if toks.count != 1
      fail "extra tokens"
    end
    return end_stmt(p)
  end
  if eqb(head, "else")
    return emit_else(p, toks)
  end
  if eqb(head, "return")
    return emit_return(p, toks)
  end
  if eqb(head, "write")
    return emit_write(p, toks)
  end
  if eqb(head, "let")
    return emit_let(p, toks)
  end
  if eqb(head, "set")
    return emit_set(p, toks)
  end
  if eqb(head, "if")
    return emit_if(p, toks)
  end
  if eqb(head, "while")
    return emit_while(p, toks)
  end
  if eqb(head, "for")
    return emit_for(p, toks)
  end
  if eqb(head, "fail")
    return emit_fail_stmt(p, toks)
  end
  fail "unsupported statement"
  return p
end

fn patch_code(p: prog) -> prog
  let code = paint(p.cold.pack.code, bfinish(p.jumps), bfinish(p.cold.marks), 0)
  return with_code(p, code)
end

fn compile(text: bytes) -> prog
  let none: map bytes i64 = map()
  let seed = fresh(bnew(), bnew(), none, none, 7, bnew())
  let typed = scan_fns(scan_structs(seed, text), text)
  let p = fresh(typed.cold.pack.fnames, typed.cold.pack.arity, typed.cold.pack.sname, typed.cold.pack.sfld, typed.cold.pack.nstruct, typed.cold.pack.rets)
  let seen = 0
  for line in lines(text)
    set seen = seen + 1 else fail "math"
    set p = on_line(p, line.text)
  end
  if p.cold.pack.live != 0
    fail "unclosed fn"
  end
  if p.cold.pack.saw_main == 0
    fail "missing main"
  end
  return patch_code(finish_code(finish_pool(p)))
end

fn bnew() -> buf
  let parts: list bytes = list()
  return buf(parts, "", 0, 0, "", 0)
end

fn bflush(b: buf) -> buf
  let parts = b.parts
  let moved = 0
  if b.mfills != 0
    set parts = push(parts, b.mid)
    set moved = 1
  end
  if b.fills != 0
    set parts = push(parts, b.part)
    set moved = 1
  end
  if moved == 0
    return b
  end
  return buf(parts, "", 0, b.count, "", 0)
end

fn bpush(b: buf, extra: bytes) -> buf
  if len(extra) == 0
    return b
  end
  let base = bflush(b)
  let count = base.count + len(extra) else fail "math"
  return buf(push(base.parts, extra), "", 0, count, "", 0)
end

fn finish_pool(p: prog) -> prog
  return spawn(p.cold.pack.code, bfinish(p.cold.pack.pbuf), p.cold.pack.nconst, p.cold.pack.strs, p.cold.pack.funcs, p.jumps, p.cold.marks, p.cold.pack.imap, p.cold.pack.bmap, p.cold.pack.smap, p.cold.pack.fnames, p.cold.pack.arity, p.cold.slots, p.cold.pack.unwind, p.cold.pack.main_off, p.cold.pack.main_slots, p.cold.pack.saw_main, p.cold.pack.live, p.cold.pack.start, p.cold.pack.nparams, p.cold.pack.is_main, p.cold.seen, as_buf(p), p.cold.blocks, p.cold.failto, p.cold.pack.pbuf, p.cold.pack.sname, p.cold.pack.sfld, p.cold.pack.nstruct, p.cold.pack.building, p.cold.pack.nfield, p.cold.pack.rets)
end

fn badd(b: buf, extra: bytes) -> buf
  if len(extra) == 0
    return b
  end
  if len(extra) >= 256
    return bpush(b, extra)
  end
  let part = b.part ++ extra
  let fills = b.fills + 1 else fail "math"
  let count = b.count + len(extra) else fail "math"
  if fills >= 8
    let mid = b.mid ++ part
    let mf = b.mfills + 1 else fail "math"
    if mf >= 8
      return buf(push(b.parts, mid), "", 0, count, "", 0)
    end
    return buf(b.parts, "", 0, count, mid, mf)
  end
  return buf(b.parts, part, fills, count, b.mid, b.mfills)
end

fn flatten(xs: list bytes) -> bytes
  if len(xs) == 0
    return ""
  end
  if len(xs) == 1
    return at(xs, 0) else fail "chunk"
  end
  let out: list bytes = list()
  let i = 0
  let n = len(xs)
  while i < n
    let left = at(xs, i) else fail "chunk"
    let nxt = i + 1 else fail "math"
    if nxt < n
      let right = at(xs, nxt) else fail "chunk"
      set out = push(out, left ++ right)
      set i = nxt + 1 else fail "math"
    end
    if nxt >= n
      set out = push(out, left)
      set i = n
    end
  end
  return flatten(out)
end

fn bfinish(b: buf) -> bytes
  let parts = b.parts
  if b.mfills != 0
    set parts = push(parts, b.mid)
  end
  if b.fills != 0
    set parts = push(parts, b.part)
  end
  return flatten(parts)
end

fn bwrap(data: bytes) -> buf
  let parts: list bytes = list()
  if len(data) == 0
    return buf(parts, "", 0, 0, "", 0)
  end
  return buf(parts, data, 1, len(data), "", 0)
end

fn zeros(n: i64) -> bytes
  if n <= 0
    return ""
  end
  let chunk = byte(0)
  let parts: list bytes = list()
  set parts = push(parts, chunk)
  let grow = len(chunk) + len(chunk) else fail "math"
  while grow <= n
    set chunk = chunk ++ chunk
    set parts = push(parts, chunk)
    set grow = len(chunk) + len(chunk) else fail "math"
  end
  let out = ""
  let left = n
  let i = len(parts) - 1 else fail "math"
  while i >= 0
    let piece = at(parts, i) else fail "chunk"
    if left >= len(piece)
      set out = out ++ piece
      set left = left - len(piece) else fail "math"
    end
    set i = i - 1 else fail "math"
  end
  return out
end

fn bpad(b: buf, boundary: i64) -> buf
  let gap = rem(b.count, boundary)
  if gap == 0
    return b
  end
  let need = boundary - gap else fail "math"
  return badd(b, zeros(need))
end

fn rem(n: i64, m: i64) -> i64
  let q = n / m else fail "math"
  let r = n - q * m else fail "math"
  if r < 0
    return r + m else fail "math"
  end
  return r
end

fn align_up(n: i64, boundary: i64) -> i64
  let sum = n + boundary - 1 else fail "math"
  let q = sum / boundary else fail "math"
  return q * boundary else fail "math"
end

fn pad_align(data: bytes, boundary: i64) -> bytes
  let gap = rem(len(data), boundary)
  if gap == 0
    return data
  end
  let need = boundary - gap else fail "math"
  return data ++ zeros(need)
end

fn poke(data: bytes, off: i64, value: i64, nbytes: i64) -> bytes
  let out = data
  let v = value
  let i = 0
  while i < nbytes
    set out = set_byte(out, off + i else fail "math", low8(v)) else fail "poke"
    set v = asr8(v)
    set i = i + 1 else fail "math"
  end
  return out
end

fn mem_image(p: prog) -> bytes
  let gap = rem(len(p.cold.pack.code), 8)
  let padded = p.cold.pack.code
  if gap != 0
    set padded = p.cold.pack.code ++ zeros(8 - gap else fail "math")
  end
  let pool_off = 512 + len(padded) else fail "math"
  let funcs_off = pool_off + len(p.cold.pack.pool) else fail "math"
  let head = zeros(512)
  set head = poke(head, 16, p.cold.pack.main_off, 8)
  set head = poke(head, 24, p.cold.pack.main_slots, 8)
  set head = poke(head, 104, len(p.cold.pack.code), 8)
  set head = poke(head, 208, p.cold.pack.nconst, 8)
  set head = poke(head, 216, 512, 8)
  set head = poke(head, 224, pool_off, 8)
  set head = poke(head, 232, funcs_off, 8)
  return head ++ padded ++ p.cold.pack.pool ++ bfinish(p.cold.pack.funcs)
end

fn note(b: buf, slot: i64, name: bytes) -> buf
  return badd(b, q8(slot) ++ u16(len(name)) ++ name)
end

fn load_u16(data: bytes, off: i64) -> i64
  let lo = at(data, off) else fail "byte"
  let hi = at(data, off + 1 else fail "math") else fail "byte"
  return lo + hi * 256 else fail "math"
end

fn load_i64(data: bytes, off: i64) -> i64
  let v = 0
  let mul = 1
  let k = 0
  while k < 7
    let b = at(data, off + k else fail "math") else fail "byte"
    set v = v + b * mul else fail "math"
    set mul = mul * 256 else fail "math"
    set k = k + 1 else fail "math"
  end
  let hi = at(data, off + 7 else fail "math") else fail "byte"
  if hi >= 128
    let sign = hi - 256 else fail "math"
    return v + sign * mul else fail "math"
  end
  return v + hi * mul else fail "math"
end

fn note_bytes(raw: bytes, slot: i64, name: bytes) -> bytes
  let head = q8(slot) ++ u16(len(name))
  return raw ++ head ++ name
end

fn seek_buf(index: buf, name: bytes) -> i64
  let n = len(index.parts)
  let i = 0
  while i < n
    let hit = seek_named(at(index.parts, i) else fail "chunk", name)
    if hit >= 0
      return hit
    end
    set i = i + 1 else fail "math"
  end
  if index.mfills != 0
    let midhit = seek_named(index.mid, name)
    if midhit >= 0
      return midhit
    end
  end
  return seek_named(index.part, name)
end

fn seek_span_buf(index: buf, text: bytes, atn: i64, nlen: i64) -> i64
  let n = len(index.parts)
  let i = 0
  while i < n
    let hit = seek_span(at(index.parts, i) else fail "chunk", text, atn, nlen)
    if hit >= 0
      return hit
    end
    set i = i + 1 else fail "math"
  end
  if index.mfills != 0
    let midhit = seek_span(index.mid, text, atn, nlen)
    if midhit >= 0
      return midhit
    end
  end
  return seek_span(index.part, text, atn, nlen)
end

fn seek_span(raw: bytes, text: bytes, atn: i64, nlen: i64) -> i64
  let i = 0
  let n = len(raw)
  while i < n
    let slot = load_i64(raw, i)
    let klen = load_u16(raw, i + 8 else fail "math")
    let kat = i + 10 else fail "math"
    if klen == nlen
      if eq_span(raw, kat, text, atn, nlen) != 0
        return slot
      end
    end
    set i = kat + klen else fail "math"
  end
  return -1
end

fn span_i64(text: bytes, start: i64, stop: i64) -> i64
  let i = start
  let neg = 0
  if i < stop
    if at(text, i) == 45
      set neg = 1
      set i = i + 1 else fail "math"
    end
  end
  if i >= stop
    fail "bad integer"
  end
  let n = 0
  while i < stop
    let c = at(text, i) else fail "byte"
    if c < 48
      fail "bad integer"
    end
    if c > 57
      fail "bad integer"
    end
    let d = c - 48 else fail "math"
    set n = n * 10 else fail "math"
    set n = n + d else fail "math"
    set i = i + 1 else fail "math"
  end
  if neg != 0
    set n = 0 - n else fail "math"
  end
  return n
end

fn seek_named(raw: bytes, name: bytes) -> i64
  let i = 0
  let n = len(raw)
  let want = len(name)
  while i < n
    let slot = load_i64(raw, i)
    let nlen = load_u16(raw, i + 8 else fail "math")
    let kat = i + 10 else fail "math"
    if nlen == want
      if eq_span(raw, kat, name, 0, want) != 0
        return slot
      end
    end
    set i = kat + nlen else fail "math"
  end
  return -1
end

fn seek_i64(raw: bytes, n: i64) -> i64
  let i = 0
  let m = len(raw)
  while i < m
    if load_i64(raw, i) == n
      return load_i64(raw, i + 8 else fail "math")
    end
    set i = i + 16 else fail "math"
  end
  return -1
end

fn span(data: bytes, off: i64, n: i64) -> bytes
  let out = ""
  let k = 0
  while k < n
    set out = out ++ byte(at(data, off + k else fail "math") else fail "byte")
    set k = k + 1 else fail "math"
  end
  return out
end

fn eq_span(left: bytes, left_at: i64, right: bytes, right_at: i64, n: i64) -> i64
  let k = 0
  while k < n
    if at(left, left_at + k else fail "math") != at(right, right_at + k else fail "math")
      return 0
    end
    set k = k + 1 else fail "math"
  end
  return 1
end

fn find_note(marks: bytes, src: bytes, atn: i64, nlen: i64) -> i64
  let i = 0
  let n = len(marks)
  while i < n
    let slot = load_i64(marks, i)
    let klen = load_u16(marks, i + 8 else fail "math")
    let kat = i + 10 else fail "math"
    if klen == nlen
      if eq_span(marks, kat, src, atn, nlen) != 0
        return slot
      end
    end
    set i = kat + klen else fail "math"
  end
  fail "missing label"
  return 0
end

fn find_named(marks: bytes, name: bytes) -> i64
  return find_note(marks, name, 0, len(name))
end

fn paint(code: bytes, jumps: bytes, marks: bytes, bias: i64) -> bytes
  let out = bnew()
  let i = 0
  let n = len(code)
  let j = 0
  let m = len(jumps)
  while i < n
    let slot = -1
    if j < m
      set slot = load_i64(jumps, j)
    end
    if slot == i
      let nlen = load_u16(jumps, j + 8 else fail "math")
      let target = find_note(marks, jumps, j + 10 else fail "math", nlen)
      let rel = target - (bias + i + 4) else fail "math"
      set out = badd(out, q4(rel))
      set i = i + 4 else fail "math"
      set j = j + 10 + nlen else fail "math"
    else
      let room = n - i else fail "math"
      if slot >= 0
        let dist = slot - i else fail "math"
        if dist < room
          set room = dist
        end
      end
      let take = 32
      if room < take
        set take = room
      end
      if take <= 0
        fail "missing patch"
      end
      set out = badd(out, span(code, i, take))
      set i = i + take else fail "math"
    end
  end
  if j != m
    fail "missing patch"
  end
  return bfinish(out)
end

fn patch_unit(src: unit) -> unit
  let code = paint(bfinish(src.buf), bfinish(src.jumps), bfinish(src.marks), 0)
  return unit(bwrap(code), src.marks, src.jumps, src.rips)
end

fn patch_rips(src: unit, symbols: map bytes i64) -> bytes
  let notes = bnew()
  for k in symbols
    set notes = note(notes, get(symbols, k) else fail "missing label", k)
  end
  return paint(bfinish(src.buf), bfinish(src.rips), bfinish(notes), 4096)
end

fn place(data: buf, symbols: map bytes i64, name: bytes, raw: bytes, alignment: i64, data_rva: i64) -> placed
  let bufv = bpad(data, alignment)
  let here = bufv.count
  let symbols2 = put(symbols, name, data_rva + here else fail "math")
  return placed(badd(bufv, raw), symbols2, here)
end

fn section(name: bytes, vsize: i64, va: i64, raw_size: i64, raw_ptr: i64, chars: i64) -> bytes
  let out = zeros(40)
  let i = 0
  let n = len(name)
  while i < n
    set out = set_byte(out, i, at(name, i) else fail "poke") else fail "poke"
    set i = i + 1 else fail "math"
  end
  set out = poke(out, 8, vsize, 4)
  set out = poke(out, 12, va, 4)
  set out = poke(out, 16, raw_size, 4)
  set out = poke(out, 20, raw_ptr, 4)
  set out = poke(out, 36, chars, 4)
  return out
end

fn dos_header() -> bytes
  let out = zeros(128)
  set out = set_byte(out, 0, 77) else fail "poke"
  set out = set_byte(out, 1, 90) else fail "poke"
  set out = poke(out, 60, 128, 4)
  return out
end

fn coff_header() -> bytes
  return u16(34404) ++ u16(2) ++ q4(0) ++ q4(0) ++ q4(0) ++ u16(240) ++ u16(35)
end

fn opt_header(text_raw: i64, data_raw: i64, entry_rva: i64, image_size: i64, import_rva: i64, import_size: i64) -> bytes
  let opt = zeros(240)
  set opt = poke(opt, 0, 523, 2)
  set opt = poke(opt, 4, text_raw, 4)
  set opt = poke(opt, 8, data_raw, 4)
  set opt = poke(opt, 16, entry_rva, 4)
  set opt = poke(opt, 20, 4096, 4)
  set opt = poke(opt, 24, 5368709120, 8)
  set opt = poke(opt, 32, 4096, 4)
  set opt = poke(opt, 36, 512, 4)
  set opt = poke(opt, 40, 6, 2)
  set opt = poke(opt, 48, 6, 2)
  set opt = poke(opt, 56, image_size, 4)
  set opt = poke(opt, 60, 512, 4)
  set opt = poke(opt, 68, 3, 2)
  set opt = poke(opt, 70, 256, 2)
  set opt = poke(opt, 72, 1048576, 8)
  set opt = poke(opt, 80, 4096, 8)
  set opt = poke(opt, 88, 1048576, 8)
  set opt = poke(opt, 96, 4096, 8)
  set opt = poke(opt, 108, 16, 4)
  set opt = poke(opt, 120, import_rva, 4)
  set opt = poke(opt, 124, import_size, 4)
  return opt
end

fn pe_image(code: bytes, data: bytes, entry_rva: i64, data_rva: i64, import_rva: i64, import_size: i64) -> bytes
  let text_raw = align_up(len(code), 512)
  let data_raw = align_up(len(data), 512)
  let image_size = align_up(data_rva + len(data) else fail "math", 4096)
  let opt = opt_header(text_raw, data_raw, entry_rva, image_size, import_rva, import_size)
  let data_ptr = 512 + text_raw else fail "math"
  let text_sec = section(".text", len(code), 4096, text_raw, 512, 1610612768)
  let data_sec = section(".data", len(data), data_rva, data_raw, data_ptr, 3221225536)
  let headers = dos_header() ++ byte(80) ++ byte(69) ++ byte(0) ++ byte(0) ++ coff_header() ++ opt ++ text_sec ++ data_sec
  if len(headers) > 512
    fail "headers"
  end
  let file = headers ++ zeros(512 - len(headers) else fail "math") ++ code ++ zeros(text_raw - len(code) else fail "math") ++ data ++ zeros(data_raw - len(data) else fail "math")
  return file
end

fn link_exe(p: prog) -> bytes
  let mem = mem_image(p)
  let asm1 = patch_unit(vessel())
  let data_rva = align_up(4096 + asm1.buf.count else fail "math", 4096)
  let symbols: map bytes i64 = map()
  let data = bnew()
  let s = place(data, symbols, "strs", bfinish(p.cold.pack.strs), 1, data_rva)
  set s = place(s.data, s.symbols, "zeroch", "0", 1, data_rva)
  set s = place(s.data, s.symbols, "mintext", "-9223372036854775808", 1, data_rva)
  set s = place(s.data, s.symbols, "oommsg", "out of memory\n", 1, data_rva)
  set s = place(s.data, s.symbols, "depthmsg", "call depth\n", 1, data_rva)
  set s = place(s.data, s.symbols, "mem", mem, 8, data_rva)
  let hint0 = byte(0) ++ byte(0)
  set s = place(s.data, s.symbols, "dllname_kernel32.dll", "kernel32.dll" ++ byte(0), 2, data_rva)
  set s = place(s.data, s.symbols, "hint_kernel32.dll_GetStdHandle", hint0 ++ "GetStdHandle" ++ byte(0), 2, data_rva)
  set s = place(s.data, s.symbols, "hint_kernel32.dll_WriteFile", hint0 ++ "WriteFile" ++ byte(0), 2, data_rva)
  set s = place(s.data, s.symbols, "hint_kernel32.dll_ExitProcess", hint0 ++ "ExitProcess" ++ byte(0), 2, data_rva)
  set s = place(s.data, s.symbols, "hint_kernel32.dll_VirtualAlloc", hint0 ++ "VirtualAlloc" ++ byte(0), 2, data_rva)
  set s = place(s.data, s.symbols, "hint_kernel32.dll_GetCommandLineA", hint0 ++ "GetCommandLineA" ++ byte(0), 2, data_rva)
  set s = place(s.data, s.symbols, "hint_kernel32.dll_CreateFileA", hint0 ++ "CreateFileA" ++ byte(0), 2, data_rva)
  set s = place(s.data, s.symbols, "hint_kernel32.dll_ReadFile", hint0 ++ "ReadFile" ++ byte(0), 2, data_rva)
  set s = place(s.data, s.symbols, "hint_kernel32.dll_GetFileSizeEx", hint0 ++ "GetFileSizeEx" ++ byte(0), 2, data_rva)
  set s = place(s.data, s.symbols, "hint_kernel32.dll_CloseHandle", hint0 ++ "CloseHandle" ++ byte(0), 2, data_rva)
  set s = place(s.data, s.symbols, "hint_kernel32.dll_GetFileAttributesA", hint0 ++ "GetFileAttributesA" ++ byte(0), 2, data_rva)
  set data = bpad(s.data, 8)
  set symbols = s.symbols
  let ilt_at = data.count
  set symbols = put(symbols, "ilt_kernel32.dll", data_rva + ilt_at else fail "math")
  let h1 = get(symbols, "hint_kernel32.dll_GetStdHandle") else fail "hint"
  let h2 = get(symbols, "hint_kernel32.dll_WriteFile") else fail "hint"
  let h3 = get(symbols, "hint_kernel32.dll_ExitProcess") else fail "hint"
  let h4 = get(symbols, "hint_kernel32.dll_VirtualAlloc") else fail "hint"
  let h5 = get(symbols, "hint_kernel32.dll_GetCommandLineA") else fail "hint"
  let h6 = get(symbols, "hint_kernel32.dll_CreateFileA") else fail "hint"
  let h7 = get(symbols, "hint_kernel32.dll_ReadFile") else fail "hint"
  let h8 = get(symbols, "hint_kernel32.dll_GetFileSizeEx") else fail "hint"
  let h9 = get(symbols, "hint_kernel32.dll_CloseHandle") else fail "hint"
  let h10 = get(symbols, "hint_kernel32.dll_GetFileAttributesA") else fail "hint"
  set data = badd(data, q8(h1))
  set data = badd(data, q8(h2))
  set data = badd(data, q8(h3))
  set data = badd(data, q8(h4))
  set data = badd(data, q8(h5))
  set data = badd(data, q8(h6))
  set data = badd(data, q8(h7))
  set data = badd(data, q8(h8))
  set data = badd(data, q8(h9))
  set data = badd(data, q8(h10))
  set data = badd(data, q8(0))
  set data = bpad(data, 8)
  let iat_at = data.count
  set symbols = put(symbols, "iat_kernel32.dll", data_rva + iat_at else fail "math")
  set symbols = put(symbols, "iat_kernel32_GetStdHandle", data_rva + data.count else fail "math")
  set data = badd(data, q8(h1))
  set symbols = put(symbols, "iat_kernel32_WriteFile", data_rva + data.count else fail "math")
  set data = badd(data, q8(h2))
  set symbols = put(symbols, "iat_kernel32_ExitProcess", data_rva + data.count else fail "math")
  set data = badd(data, q8(h3))
  set symbols = put(symbols, "iat_kernel32_VirtualAlloc", data_rva + data.count else fail "math")
  set data = badd(data, q8(h4))
  set symbols = put(symbols, "iat_kernel32_GetCommandLineA", data_rva + data.count else fail "math")
  set data = badd(data, q8(h5))
  set symbols = put(symbols, "iat_kernel32_CreateFileA", data_rva + data.count else fail "math")
  set data = badd(data, q8(h6))
  set symbols = put(symbols, "iat_kernel32_ReadFile", data_rva + data.count else fail "math")
  set data = badd(data, q8(h7))
  set symbols = put(symbols, "iat_kernel32_GetFileSizeEx", data_rva + data.count else fail "math")
  set data = badd(data, q8(h8))
  set symbols = put(symbols, "iat_kernel32_CloseHandle", data_rva + data.count else fail "math")
  set data = badd(data, q8(h9))
  set symbols = put(symbols, "iat_kernel32_GetFileAttributesA", data_rva + data.count else fail "math")
  set data = badd(data, q8(h10))
  set data = badd(data, q8(0))
  set data = bpad(data, 4)
  let import_at = data.count
  let ilt = get(symbols, "ilt_kernel32.dll") else fail "ilt"
  let dllr = get(symbols, "dllname_kernel32.dll") else fail "dll"
  let iat = get(symbols, "iat_kernel32.dll") else fail "iat"
  set data = badd(data, q4(ilt) ++ q4(0) ++ q4(0) ++ q4(dllr) ++ q4(iat))
  set data = badd(data, zeros(20))
  let import_rva = data_rva + import_at else fail "math"
  let code = patch_rips(asm1, symbols)
  let entry_off = find_named(bfinish(asm1.marks), "start")
  let entry_rva = 4096 + entry_off else fail "math"
  return pe_image(code, bfinish(data), entry_rva, data_rva, import_rva, 40)
end

fn brest(data: bytes) -> buf
  let parts: list bytes = list()
  if len(data) == 0
    return buf(parts, "", 0, 0, "", 0)
  end
  set parts = push(parts, data)
  return buf(parts, "", 0, len(data), "", 0)
end

fn chap_path(prefix: bytes, name: bytes) -> bytes
  return prefix ++ "." ++ name
end

fn save_blob(prefix: bytes, name: bytes, data: bytes) -> i64
  if len(data) == 0
    return 0
  end
  let wrote = save(chap_path(prefix, name), data) else fail reason
  return wrote
end

fn open_blob(prefix: bytes, name: bytes, n: i64) -> bytes
  if n == 0
    return ""
  end
  let raw = open(chap_path(prefix, name), 1048576, "cannot open ", "empty chapter\n", "file too large\n") else fail reason
  if len(raw) != n
    fail "chapter"
  end
  return raw
end

fn save_map(out: buf, m: map bytes i64) -> buf
  let cur = out
  set cur = badd(cur, q8(len(m)))
  for k in m
    set cur = badd(cur, q8(len(k)))
    set cur = badd(cur, k)
    set cur = badd(cur, q8(get(m, k) else fail "chapter"))
  end
  return cur
end

fn take_num(c: cursor) -> cursor
  let v = load_i64(c.data, c.off)
  return cursor(c.data, c.off + 8 else fail "math", v, c.raw, c.m, c.xs)
end

fn take_raw(c: cursor) -> cursor
  let nraw = load_i64(c.data, c.off)
  let atp = c.off + 8 else fail "math"
  let raw = ""
  if nraw > 0
    set raw = span(c.data, atp, nraw)
  end
  return cursor(c.data, atp + nraw else fail "math", nraw, raw, c.m, c.xs)
end

fn take_map(c: cursor) -> cursor
  let nmap = load_i64(c.data, c.off)
  let atp = c.off + 8 else fail "math"
  let m: map bytes i64 = map()
  let imap = 0
  while imap < nmap
    let klen = load_i64(c.data, atp)
    set atp = atp + 8 else fail "math"
    let key = span(c.data, atp, klen)
    set atp = atp + klen else fail "math"
    let val = load_i64(c.data, atp)
    set atp = atp + 8 else fail "math"
    set m = put(m, key, val)
    set imap = imap + 1 else fail "math"
  end
  return cursor(c.data, atp, nmap, c.raw, m, c.xs)
end

fn take_blocks(c: cursor) -> cursor
  let nblk = load_i64(c.data, c.off)
  let atp = c.off + 8 else fail "math"
  let xs: list block = list()
  let iblk = 0
  while iblk < nblk
    let kind = load_i64(c.data, atp)
    set atp = atp + 8 else fail "math"
    let alen = load_i64(c.data, atp)
    set atp = atp + 8 else fail "math"
    let alt = ""
    if alen > 0
      set alt = span(c.data, atp, alen)
    end
    set atp = atp + alen else fail "math"
    let dlen = load_i64(c.data, atp)
    set atp = atp + 8 else fail "math"
    let done_b = ""
    if dlen > 0
      set done_b = span(c.data, atp, dlen)
    end
    set atp = atp + dlen else fail "math"
    set xs = push(xs, block(kind, alt, done_b))
    set iblk = iblk + 1 else fail "math"
  end
  return cursor(c.data, atp, nblk, c.raw, c.m, xs)
end

fn save_blocks(out: buf, xs: list block) -> buf
  let cur = out
  set cur = badd(cur, q8(len(xs)))
  let iblk = 0
  let nblk = len(xs)
  while iblk < nblk
    let item = at(xs, iblk) else fail "chapter"
    set cur = badd(cur, q8(item.kind))
    set cur = badd(cur, q8(len(item.alt)))
    set cur = badd(cur, item.alt)
    set cur = badd(cur, q8(len(item.done)))
    set cur = badd(cur, item.done)
    set iblk = iblk + 1 else fail "math"
  end
  return cur
end

fn write_chap(prefix: bytes, p: prog, row: i64) -> i64
  let code = bfinish(as_buf(p))
  if len(code) != p.count
    fail "chapter"
  end
  let jumps = bfinish(p.jumps)
  let marks = bfinish(p.cold.marks)
  let strs = bfinish(p.cold.pack.strs)
  let funcs = bfinish(p.cold.pack.funcs)
  let bmap = bfinish(p.cold.pack.bmap)
  let smap = bfinish(p.cold.pack.smap)
  let fnames = bfinish(p.cold.pack.fnames)
  let arity = bfinish(p.cold.pack.arity)
  let pbuf = bfinish(p.cold.pack.pbuf)
  let rets = bfinish(p.cold.pack.rets)
  let out = bnew()
  set out = badd(out, q8(row))
  set out = badd(out, q8(p.cold.pack.nconst))
  set out = badd(out, q8(p.cold.pack.main_off))
  set out = badd(out, q8(p.cold.pack.main_slots))
  set out = badd(out, q8(p.cold.pack.saw_main))
  set out = badd(out, q8(p.cold.pack.live))
  set out = badd(out, q8(p.cold.pack.start))
  set out = badd(out, q8(p.cold.pack.nparams))
  set out = badd(out, q8(p.cold.pack.is_main))
  set out = badd(out, q8(p.cold.seen))
  set out = badd(out, q8(p.cold.pack.nstruct))
  set out = badd(out, q8(p.cold.pack.nfield))
  set out = badd(out, q8(len(p.cold.pack.unwind)))
  set out = badd(out, p.cold.pack.unwind)
  set out = badd(out, q8(len(p.cold.pack.building)))
  set out = badd(out, p.cold.pack.building)
  set out = badd(out, q8(len(p.cold.failto)))
  set out = badd(out, p.cold.failto)
  set out = badd(out, q8(len(p.cold.pack.code)))
  set out = badd(out, p.cold.pack.code)
  set out = badd(out, q8(len(p.cold.pack.pool)))
  set out = badd(out, p.cold.pack.pool)
  set out = badd(out, q8(len(p.cold.pack.imap)))
  set out = badd(out, p.cold.pack.imap)
  set out = badd(out, q8(len(code)))
  set out = badd(out, q8(len(jumps)))
  set out = badd(out, q8(len(marks)))
  set out = badd(out, q8(len(strs)))
  set out = badd(out, q8(len(funcs)))
  set out = badd(out, q8(len(bmap)))
  set out = badd(out, q8(len(smap)))
  set out = badd(out, q8(len(fnames)))
  set out = badd(out, q8(len(arity)))
  set out = badd(out, q8(len(pbuf)))
  set out = badd(out, q8(len(rets)))
  set out = save_map(out, p.cold.slots)
  set out = save_map(out, p.cold.pack.sname)
  set out = save_map(out, p.cold.pack.sfld)
  set out = save_blocks(out, p.cold.blocks)
  let meta = bfinish(out)
  let meta_n = save_blob(prefix, "meta", meta)
  let code_n = save_blob(prefix, "code", code)
  let jump_n = save_blob(prefix, "jumps", jumps)
  let mark_n = save_blob(prefix, "marks", marks)
  let strs_n = save_blob(prefix, "strs", strs)
  let funcs_n = save_blob(prefix, "funcs", funcs)
  let bmap_n = save_blob(prefix, "bmap", bmap)
  let smap_n = save_blob(prefix, "smap", smap)
  let name_n = save_blob(prefix, "fnames", fnames)
  let arity_n = save_blob(prefix, "arity", arity)
  let pool_n = save_blob(prefix, "pbuf", pbuf)
  let rets_n = save_blob(prefix, "rets", rets)
  return meta_n + code_n else fail "math"
end

fn blank_cursor(data: bytes) -> cursor
  let none: map bytes i64 = map()
  let xs: list block = list()
  return cursor(data, 0, 0, "", none, xs)
end

fn load_chap(prefix: bytes, expect: i64) -> prog
  let opened = open(chap_path(prefix, "meta"), 1048576, "cannot open ", "empty chapter\n", "file too large\n") else fail reason
  let c0 = blank_cursor(opened)
  let rowc = take_num(c0)
  if rowc.n != expect
    fail "chapter"
  end
  let nconst = take_num(rowc)
  let main_off = take_num(nconst)
  let main_slots = take_num(main_off)
  let saw_main = take_num(main_slots)
  let live = take_num(saw_main)
  let fnstart = take_num(live)
  let nparams = take_num(fnstart)
  let is_main = take_num(nparams)
  let labelseen = take_num(is_main)
  let nstruct = take_num(labelseen)
  let nfield = take_num(nstruct)
  let unwind = take_raw(nfield)
  let building = take_raw(unwind)
  let failto = take_raw(building)
  let packcode = take_raw(failto)
  let pool = take_raw(packcode)
  let imap = take_raw(pool)
  let ncode = take_num(imap)
  let njumps = take_num(ncode)
  let nmarks = take_num(njumps)
  let nstrs = take_num(nmarks)
  let nfuncs = take_num(nstrs)
  let nbmap = take_num(nfuncs)
  let nsmap = take_num(nbmap)
  let nfnames = take_num(nsmap)
  let narity = take_num(nfnames)
  let npbuf = take_num(narity)
  let nrets = take_num(npbuf)
  let slots = take_map(nrets)
  let sname = take_map(slots)
  let sfld = take_map(sname)
  let blocks = take_blocks(sfld)
  let code = open_blob(prefix, "code", ncode.n)
  let jumpsb = open_blob(prefix, "jumps", njumps.n)
  let marksb = open_blob(prefix, "marks", nmarks.n)
  let strsb = open_blob(prefix, "strs", nstrs.n)
  let funcsb = open_blob(prefix, "funcs", nfuncs.n)
  let bmapb = open_blob(prefix, "bmap", nbmap.n)
  let smapb = open_blob(prefix, "smap", nsmap.n)
  let fnameb = open_blob(prefix, "fnames", nfnames.n)
  let arityb = open_blob(prefix, "arity", narity.n)
  let pbufb = open_blob(prefix, "pbuf", npbuf.n)
  let retsb = open_blob(prefix, "rets", nrets.n)
  return spawn(packcode.raw, pool.raw, nconst.n, brest(strsb), brest(funcsb), brest(jumpsb), brest(marksb), imap.raw, brest(bmapb), brest(smapb), brest(fnameb), brest(arityb), slots.m, unwind.raw, main_off.n, main_slots.n, saw_main.n, live.n, fnstart.n, nparams.n, is_main.n, labelseen.n, brest(code), blocks.xs, failto.raw, brest(pbufb), sname.m, sfld.m, nstruct.n, building.raw, nfield.n, brest(retsb))
end

fn walk_lines(p0: prog, text: bytes, start: i64, stop: i64) -> prog
  let p = p0
  let row = 0
  for line in lines(text)
    set row = row + 1 else fail "math"
    if row > start
      if stop == 0
        set p = on_line(p, line.text)
      end
      if stop != 0
        if row <= stop
          set p = on_line(p, line.text)
        end
      end
    end
    if stop != 0
      if row == stop
        return p
      end
    end
  end
  if stop != 0
    fail "short source"
  end
  if p.cold.pack.live != 0
    fail "unclosed fn"
  end
  if p.cold.pack.saw_main == 0
    fail "missing main"
  end
  return p
end

fn last_sep(path: bytes) -> i64
  let i = 0
  let n = len(path)
  let cut = -1
  while i < n
    let c = at(path, i) else fail "math"
    if c == 47
      set cut = i
    end
    if c == 92
      set cut = i
    end
    set i = i + 1 else fail "math"
  end
  return cut
end

fn parent_dir(path: bytes) -> bytes
  let cut = last_sep(path)
  if cut < 0
    return ""
  end
  return span(path, 0, cut)
end

fn sep_of(path: bytes) -> i64
  let i = 0
  let n = len(path)
  while i < n
    let c = at(path, i) else fail "math"
    if c == 92
      return 92
    end
    set i = i + 1 else fail "math"
  end
  return 47
end

fn is_use_part(part: bytes) -> i64
  if len(part) == 0
    return 0
  end
  if eqb(part, ".")
    return 0
  end
  if eqb(part, "..")
    return 0
  end
  let i = 0
  let n = len(part)
  let ok = 0
  while i < n
    let c = at(part, i) else fail "math"
    set ok = 0
    if c >= 48
      if c <= 57
        set ok = 1
      end
    end
    if c >= 65
      if c <= 90
        set ok = 1
      end
    end
    if c >= 97
      if c <= 122
        set ok = 1
      end
    end
    if c == 95
      set ok = 1
    end
    if c == 45
      set ok = 1
    end
    if c == 46
      set ok = 1
    end
    if ok == 0
      return 0
    end
    set i = i + 1 else fail "math"
  end
  return 1
end

fn use_path(dir: bytes, rel: bytes) -> bytes
  if len(rel) == 0
    fail "use path must stay beside the source"
  end
  let c0 = at(rel, 0) else fail "math"
  if c0 == 47
    fail "use path must stay beside the source"
  end
  if c0 == 92
    fail "use path must stay beside the source"
  end
  if len(rel) >= 2
    if at(rel, 1) == 58
      fail "use path must stay beside the source"
    end
  end
  let sep = 47
  if len(dir) != 0
    set sep = sep_of(dir)
  end
  let out = dir
  let part = ""
  let i = 0
  let n = len(rel)
  let count = 0
  while i <= n
    let c = 0
    if i < n
      set c = at(rel, i) else fail "math"
    end
    let brk = 0
    if i == n
      set brk = 1
    end
    if c == 47
      set brk = 1
    end
    if c == 92
      set brk = 1
    end
    if brk == 1
      if is_use_part(part) == 0
        fail "use path must stay beside the source"
      end
      if len(out) == 0
        set out = part
      else
        set out = out ++ byte(sep) ++ part
      end
      set part = ""
      set count = count + 1 else fail "math"
    else
      set part = part ++ byte(c)
    end
    set i = i + 1 else fail "math"
  end
  if count == 0
    fail "use path must stay beside the source"
  end
  return out
end

fn bump_depth(text: bytes, depth: i64) -> i64
  let word = leading_word(text)
  if eqb(word, "fn")
    return depth + 1 else fail "math"
  end
  if eqb(word, "struct")
    return depth + 1 else fail "math"
  end
  if eqb(word, "if")
    return depth + 1 else fail "math"
  end
  if eqb(word, "while")
    return depth + 1 else fail "math"
  end
  if eqb(word, "for")
    return depth + 1 else fail "math"
  end
  if eqb(word, "end")
    if depth > 0
      return depth - 1 else fail "math"
    end
  end
  return depth
end

fn starts_console(text: bytes) -> i64
  for line in lines(text)
    let toks = lex(line.text)
    if toks.count != 0
      if toks.count != 2
        return 0
      end
      if eqb(tok_text(toks, 0), "phase") == 0
        return 0
      end
      if eqb(tok_text(toks, 1), "console") == 0
        return 0
      end
      return 1
    end
  end
  return 0
end

fn has_main(text: bytes) -> i64
  let depth = 0
  for line in lines(text)
    if depth == 0
      if leading_is(line.text, "fn")
        let toks = lex(line.text)
        if toks.count >= 2
          if eqb(tok_text(toks, 0), "fn")
            if eqb(tok_text(toks, 1), "main")
              return 1
            end
          end
        end
      end
    end
    set depth = bump_depth(line.text, depth)
  end
  return 0
end

fn seen_has(xs: list bytes, path: bytes) -> i64
  for item in xs
    if eqb(item, path)
      return 1
    end
  end
  return 0
end

fn pull(origin: bytes, text: bytes, seen: list bytes, stack: map bytes i64) -> brought
  if has(stack, origin)
    fail "use cycle"
  end
  let frame = put(stack, origin, 1)
  let out = bnew()
  let know = seen
  let depth = 0
  for line in lines(text)
    let toks = lex(line.text)
    if toks.count == 0
      set out = badd(out, "\n")
    else
      let head = tok_text(toks, 0)
      if depth == 0
        if eqb(head, "use")
          if toks.count != 2
            fail "expected use \"path\""
          end
          if tok_kind(toks, 1) != 3
            fail "expected use \"path\""
          end
          let rel = tok_text(toks, 1)
          let full = use_path(parent_dir(origin), rel)
          if eqb(full, origin)
            fail "use cycle"
          end
          if has(frame, full)
            fail "use cycle"
          end
          if seen_has(know, full) == 0
            let raw = open(full, 1048576, "missing use", "", "file too large\n") else fail "missing use"
            if starts_console(raw) == 0
              fail "expected phase console"
            end
            let child = pull(full, raw, know, frame)
            set out = badd(out, bfinish(child.body))
            set know = child.seen
            set know = push(know, full)
          end
        else
          set out = badd(out, line.text)
          set out = badd(out, "\n")
          set depth = bump_depth(line.text, depth)
        end
      else
        set out = badd(out, line.text)
        set out = badd(out, "\n")
        set depth = bump_depth(line.text, depth)
      end
    end
  end
  return brought(out, know)
end

fn run_full() -> i64
  let path = arg(1)
  let src = open(path, 1048576, "cannot open ", "", "file too large\n") else fail reason
  if has_main(src) == 0
    fail "missing main"
  end
  let none: list bytes = list()
  let pile: map bytes i64 = map()
  let got = pull(path, src, none, pile)
  let joined = bfinish(got.body)
  if len(joined) > 1048576
    fail "file too large"
  end
  let compiled = compile(joined)
  let image = link_exe(compiled)
  let wrote = save(arg(2), image) else fail reason
  return wrote
end

fn begin_chap(src: bytes, prefix: bytes, start: i64) -> prog
  if start == 0
    let none: map bytes i64 = map()
    let seed = fresh(bnew(), bnew(), none, none, 7, bnew())
    let typed = scan_fns(scan_structs(seed, src), src)
    return fresh(typed.cold.pack.fnames, typed.cold.pack.arity, typed.cold.pack.sname, typed.cold.pack.sfld, typed.cold.pack.nstruct, typed.cold.pack.rets)
  end
  return load_chap(prefix, start)
end

fn run_chap() -> i64
  let src = open(arg(1), 1048576, "cannot open ", "", "file too large\n") else fail reason
  let prefix = arg(2)
  let start = i64(arg(4)) else fail "chapter"
  let stop = i64(arg(5)) else fail "chapter"
  let p = begin_chap(src, prefix, start)
  let walked = walk_lines(p, src, start, stop)
  if stop != 0
    let saved = write_chap(prefix, walked, stop)
    return saved
  end
  let finished = patch_code(finish_code(finish_pool(walked)))
  let image = link_exe(finished)
  let wrote = save(arg(3), image) else fail reason
  return wrote
end

fn save_link(prefix: bytes, p: prog) -> i64
  let code = p.cold.pack.code
  let pool = p.cold.pack.pool
  let funcs = bfinish(p.cold.pack.funcs)
  let strs = bfinish(p.cold.pack.strs)
  let meta = q8(p.cold.pack.main_off) ++ q8(p.cold.pack.main_slots) ++ q8(p.cold.pack.nconst)
  let meta2 = meta ++ q8(len(code)) ++ q8(len(pool)) ++ q8(len(funcs)) ++ q8(len(strs))
  let n1 = save_blob(prefix, "pcode", code)
  let n2 = save_blob(prefix, "ppool", pool)
  let n3 = save_blob(prefix, "pfuncs", funcs)
  let n4 = save_blob(prefix, "pstrs", strs)
  let n5 = save_blob(prefix, "pmeta", meta2)
  return n1 + n5 else fail "math"
end

fn paint_only() -> i64
  let src = open(arg(1), 1048576, "cannot open ", "", "file too large\n") else fail reason
  let prefix = arg(2)
  let start = i64(arg(4)) else fail "chapter"
  let loaded = load_chap(prefix, start)
  let walked = walk_lines(loaded, src, start, 0)
  let finished = patch_code(finish_code(finish_pool(walked)))
  let saved = save_link(prefix, finished)
  return saved
end

fn link_only() -> i64
  let prefix = arg(2)
  let meta = open(chap_path(prefix, "pmeta"), 1048576, "cannot open ", "empty chapter\n", "file too large\n") else fail reason
  let c0 = blank_cursor(meta)
  let main_off = take_num(c0)
  let main_slots = take_num(main_off)
  let nconst = take_num(main_slots)
  let ncode = take_num(nconst)
  let npool = take_num(ncode)
  let nfuncs = take_num(npool)
  let nstrs = take_num(nfuncs)
  let code = open_blob(prefix, "pcode", ncode.n)
  let pool = open_blob(prefix, "ppool", npool.n)
  let funcs = open_blob(prefix, "pfuncs", nfuncs.n)
  let strs = open_blob(prefix, "pstrs", nstrs.n)
  let none: map bytes i64 = map()
  let blocks: list block = list()
  let p = spawn(code, pool, nconst.n, brest(strs), brest(funcs), bnew(), bnew(), "", bnew(), bnew(), bnew(), bnew(), none, "", main_off.n, main_slots.n, 1, 0, 0, 0, 0, 0, bnew(), blocks, "", bnew(), none, none, 7, "", 0, bnew())
  let image = link_exe(p)
  let wrote = save(arg(3), image) else fail reason
  return wrote
end

fn main
  if argc() == 3
    let full = run_full()
  end
  if argc() == 6
    let chap = run_chap()
  end
  if argc() == 7
    let mode = i64(arg(6)) else fail "chapter"
    if mode == 1
      let painted = paint_only()
    end
    if mode == 2
      let linked = link_only()
    end
  end
  if argc() != 3
    if argc() != 6
      if argc() != 7
        fail "usage: compiler source out\n"
      end
    end
  end
end
