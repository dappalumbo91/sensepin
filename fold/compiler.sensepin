phase console
gauge args
gauge file
gauge lines
gauge i64
gauge bytes
gauge list
gauge map

struct fixup
  slot: i64
  word: bytes
end

struct buf
  parts: list bytes
  part: bytes
  fills: i64
  count: i64
end

struct unit
  buf: buf
  marks: map bytes i64
  jumps: list fixup
  rips: list fixup
end

struct tok
  kind: i64
  num: i64
  text: bytes
end

struct step
  tok: tok
  pos: i64
end

struct placed
  data: buf
  symbols: map bytes i64
  here: i64
end

struct block
  kind: i64
  alt: bytes
  done: bytes
end

struct prog
  code: bytes
  pool: bytes
  nconst: i64
  strs: bytes
  funcs: bytes
  jumps: list fixup
  marks: map bytes i64
  imap: map i64 i64
  bmap: map bytes i64
  smap: map bytes i64
  fnames: map bytes i64
  arity: map bytes i64
  slots: map bytes i64
  unwind: bytes
  main_off: i64
  main_slots: i64
  saw_main: i64
  live: i64
  start: i64
  nparams: i64
  is_main: i64
  seen: i64
  cbuf: buf
  blocks: list block
  failto: bytes
  pbuf: buf
end

struct parsed
  prog: prog
  pos: i64
  kind: i64
end

fn low8(n: i64) -> i64
  if n == -9223372036854775808
    return 0
  end
  let q = n / 256 else fail "math"
  let r = n - q * 256 else fail "math"
  if r < 0
    return r + 256 else fail "math"
  end
  return r
end

fn asr8(n: i64) -> i64
  if n == -9223372036854775808
    return -36028797018963968
  end
  let q = n / 256 else fail "math"
  let r = n - q * 256 else fail "math"
  if r < 0
    return q - 1 else fail "math"
  end
  return q
end

fn qn(n: i64, width: i64) -> bytes
  let out = ""
  let v = n
  let i = 0
  while i < width
    set out = out ++ byte(low8(v))
    set v = asr8(v)
    set i = i + 1 else fail "math"
  end
  return out
end

fn q4(n: i64) -> bytes
  return qn(n, 4)
end

fn q8(n: i64) -> bytes
  return qn(n, 8)
end

fn q8e(n: i64) -> bytes
  let b0 = u16(n)
  let n1 = asr8(asr8(n))
  let b1 = u16(n1)
  let n2 = asr8(asr8(n1))
  let b2 = u16(n2)
  let n3 = asr8(asr8(n2))
  let b3 = u16(n3)
  let lo = b0 ++ b1
  let hi = b2 ++ b3
  return lo ++ hi
end

fn pool_rec(tag: i64, a: i64, b: i64, c: i64) -> bytes
  let left = q8e(tag) ++ q8e(a)
  let right = q8e(b) ++ q8e(c)
  return left ++ right
end

fn u16(n: i64) -> bytes
  return byte(low8(n)) ++ byte(low8(asr8(n)))
end

fn reg_low(reg: i64) -> i64
  if reg >= 8
    return reg - 8 else fail "math"
  end
  return reg
end

fn rex_byte(w: i64, reg: i64, rm: i64, index: i64) -> i64
  let r = 0
  if reg >= 8
    set r = 1
  end
  let b = 0
  if rm >= 8
    set b = 1
  end
  let x = 0
  if index >= 8
    set x = 1
  end
  let any = w + r + b + x else fail "math"
  if any == 0
    return -1
  end
  return 64 + w * 8 + r * 4 + x * 2 + b else fail "math"
end

fn rex_prefix(w: i64, reg: i64, rm: i64) -> bytes
  let rx = rex_byte(w, reg, rm, 0)
  if rx >= 0
    return byte(rx)
  end
  return ""
end

fn modrm(modv: i64, reg: i64, rm: i64) -> i64
  let r = reg_low(reg)
  let b = reg_low(rm)
  return modv * 64 + r * 8 + b else fail "math"
end

fn mem_mod(disp: i64, base: i64, tight: i64) -> i64
  if tight == 1
    if disp == 0
      if base != 5
        if base != 13
          return 0
        end
      end
    end
  end
  if disp >= -128
    if disp <= 127
      return 1
    end
  end
  return 2
end

fn emit_mem(w: i64, op0: i64, op1: i64, reg: i64, base: i64, disp: i64, tight: i64, tail: i64, tail_n: i64) -> bytes
  let modv = mem_mod(disp, base, tight)
  let out = rex_prefix(w, reg, base) ++ byte(op0)
  if op1 >= 0
    set out = out ++ byte(op1)
  end
  set out = out ++ byte(modrm(modv, reg, base))
  if base == 4
    set out = out ++ byte(36)
  end
  if base == 12
    set out = out ++ byte(36)
  end
  if modv == 1
    set out = out ++ byte(low8(disp))
  end
  if modv == 2
    set out = out ++ q4(disp)
  end
  if tail_n == 1
    set out = out ++ byte(low8(tail))
  end
  if tail_n == 4
    set out = out ++ q4(tail)
  end
  return out
end

fn emit(a: unit, extra: bytes) -> unit
  return unit(badd(a.buf, extra), a.marks, a.jumps, a.rips)
end

fn emit1(a: unit, n: i64) -> unit
  return emit(a, byte(n))
end

fn emit_jump(a: unit, extra: bytes, name: bytes) -> unit
  let slot = a.buf.count + len(extra) else fail "math"
  let jumps = push(a.jumps, fixup(slot, name))
  let marked = unit(a.buf, a.marks, jumps, a.rips)
  return emit(marked, extra ++ byte(0) ++ byte(0) ++ byte(0) ++ byte(0))
end

fn emit_rip(a: unit, extra: bytes, name: bytes) -> unit
  let slot = a.buf.count + len(extra) else fail "math"
  let rips = push(a.rips, fixup(slot, name))
  let marked = unit(a.buf, a.marks, a.jumps, rips)
  return emit(marked, extra ++ byte(0) ++ byte(0) ++ byte(0) ++ byte(0))
end

fn label(a: unit, name: bytes) -> unit
  return unit(a.buf, put(a.marks, name, a.buf.count), a.jumps, a.rips)
end

fn raw_byte(a: unit, n: i64) -> unit
  return emit1(a, n)
end

fn ret(a: unit) -> unit
  return emit1(a, 195)
end

fn int3(a: unit) -> unit
  return emit1(a, 204)
end

fn and_rsp_align(a: unit) -> unit
  return emit(a, byte(72) ++ byte(131) ++ byte(228) ++ byte(240))
end

fn sub_rsp_imm32(a: unit, n: i64) -> unit
  return emit(a, byte(72) ++ byte(129) ++ byte(236) ++ q4(n))
end

fn add_rsp_imm32(a: unit, n: i64) -> unit
  return emit(a, byte(72) ++ byte(129) ++ byte(196) ++ q4(n))
end

fn mov_reg_imm32(a: unit, dest: i64, n: i64) -> unit
  let extra = ""
  if dest >= 8
    set extra = byte(65)
  end
  return emit(a, extra ++ byte(184 + reg_low(dest) else fail "math") ++ q4(n))
end

fn mov_reg_imm64(a: unit, dest: i64, n: i64) -> unit
  let rex = 72
  if dest >= 8
    set rex = 73
  end
  return emit(a, byte(rex) ++ byte(184 + reg_low(dest) else fail "math") ++ q8(n))
end

fn mov_reg_reg(a: unit, dest: i64, src: i64) -> unit
  return emit(a, rex_prefix(1, src, dest) ++ byte(137) ++ byte(modrm(3, src, dest)))
end

fn alu(a: unit, opcode: i64, dest: i64, src: i64) -> unit
  return emit(a, rex_prefix(1, dest, src) ++ byte(opcode) ++ byte(modrm(3, dest, src)))
end

fn add_reg(a: unit, dest: i64, src: i64) -> unit
  return alu(a, 3, dest, src)
end

fn sub_reg(a: unit, dest: i64, src: i64) -> unit
  return alu(a, 43, dest, src)
end

fn cmp_reg(a: unit, dest: i64, src: i64) -> unit
  return alu(a, 59, dest, src)
end

fn or_reg(a: unit, dest: i64, src: i64) -> unit
  return alu(a, 11, dest, src)
end

fn xor_reg(a: unit, dest: i64, src: i64) -> unit
  return alu(a, 51, dest, src)
end

fn test_reg(a: unit, dest: i64, src: i64) -> unit
  return alu(a, 133, dest, src)
end

fn reg_imm(a: unit, opcode: i64, ext: i64, dest: i64, n: i64, width: i64) -> unit
  let tail = q4(n)
  if width == 1
    set tail = byte(low8(n))
  end
  return emit(a, rex_prefix(1, 0, dest) ++ byte(opcode) ++ byte(modrm(3, ext, dest)) ++ tail)
end

fn add_reg_imm8(a: unit, dest: i64, n: i64) -> unit
  return reg_imm(a, 131, 0, dest, n, 1)
end

fn sub_reg_imm8(a: unit, dest: i64, n: i64) -> unit
  return reg_imm(a, 131, 5, dest, n, 1)
end

fn add_reg_imm32(a: unit, dest: i64, n: i64) -> unit
  return reg_imm(a, 129, 0, dest, n, 4)
end

fn cmp_reg_imm8(a: unit, dest: i64, n: i64) -> unit
  return reg_imm(a, 131, 7, dest, n, 1)
end

fn cmp_reg_imm32(a: unit, dest: i64, n: i64) -> unit
  return reg_imm(a, 129, 7, dest, n, 4)
end

fn and_reg_imm8(a: unit, dest: i64, n: i64) -> unit
  return reg_imm(a, 131, 4, dest, n, 1)
end

fn shl_reg_imm8(a: unit, dest: i64, n: i64) -> unit
  return reg_imm(a, 193, 4, dest, n, 1)
end

fn shr_reg_imm8(a: unit, dest: i64, n: i64) -> unit
  return reg_imm(a, 193, 5, dest, n, 1)
end

fn ff(a: unit, opcode: i64, ext: i64, dest: i64) -> unit
  return emit(a, rex_prefix(1, 0, dest) ++ byte(opcode) ++ byte(modrm(3, ext, dest)))
end

fn inc_reg(a: unit, dest: i64) -> unit
  return ff(a, 255, 0, dest)
end

fn dec_reg(a: unit, dest: i64) -> unit
  return ff(a, 255, 1, dest)
end

fn neg_reg(a: unit, dest: i64) -> unit
  return ff(a, 247, 3, dest)
end

fn udiv_reg(a: unit, dest: i64) -> unit
  return ff(a, 247, 6, dest)
end

fn mul_rcx(a: unit) -> unit
  return emit(a, byte(72) ++ byte(247) ++ byte(225))
end

fn cqo(a: unit) -> unit
  return emit(a, byte(72) ++ byte(153))
end

fn idiv_reg(a: unit, dest: i64) -> unit
  return ff(a, 247, 7, dest)
end

fn imul_reg(a: unit, dest: i64, src: i64) -> unit
  return emit(a, rex_prefix(1, dest, src) ++ byte(15) ++ byte(175) ++ byte(modrm(3, dest, src)))
end

fn xpush(a: unit, dest: i64) -> unit
  let extra = ""
  let rx = rex_byte(0, 0, dest, 0)
  if rx >= 0
    set extra = byte(rx)
  end
  return emit(a, extra ++ byte(80 + reg_low(dest) else fail "math"))
end

fn xpop(a: unit, dest: i64) -> unit
  let extra = ""
  let rx = rex_byte(0, 0, dest, 0)
  if rx >= 0
    set extra = byte(rx)
  end
  return emit(a, extra ++ byte(88 + reg_low(dest) else fail "math"))
end

fn mov_reg_mem(a: unit, dest: i64, base: i64, disp: i64) -> unit
  return emit(a, emit_mem(1, 139, -1, dest, base, disp, 0, 0, 0))
end

fn mov_mem_reg(a: unit, base: i64, disp: i64, src: i64) -> unit
  return emit(a, emit_mem(1, 137, -1, src, base, disp, 0, 0, 0))
end

fn mov_mem_imm32(a: unit, base: i64, disp: i64, n: i64) -> unit
  return emit(a, emit_mem(1, 199, -1, 0, base, disp, 0, n, 4))
end

fn inc_mem(a: unit, base: i64, disp: i64) -> unit
  return emit(a, emit_mem(1, 255, -1, 0, base, disp, 0, 0, 0))
end

fn dec_mem(a: unit, base: i64, disp: i64) -> unit
  return emit(a, emit_mem(1, 255, -1, 1, base, disp, 0, 0, 0))
end

fn add_mem_reg(a: unit, base: i64, disp: i64, src: i64) -> unit
  return emit(a, emit_mem(1, 1, -1, src, base, disp, 0, 0, 0))
end

fn add_mem_imm8(a: unit, base: i64, disp: i64, n: i64) -> unit
  return emit(a, emit_mem(1, 131, -1, 0, base, disp, 0, n, 1))
end

fn movzx_reg_byte_mem(a: unit, dest: i64, base: i64, disp: i64) -> unit
  return emit(a, emit_mem(0, 15, 182, dest, base, disp, 1, 0, 0))
end

fn movsxd_reg_mem(a: unit, dest: i64, base: i64, disp: i64) -> unit
  return emit(a, emit_mem(1, 99, -1, dest, base, disp, 1, 0, 0))
end

fn mov_mem8_reg(a: unit, base: i64, disp: i64, src: i64) -> unit
  return emit(a, emit_mem(0, 136, -1, src, base, disp, 1, 0, 0))
end

fn mov_rsp_imm32(a: unit, disp: i64, n: i64) -> unit
  return emit(a, emit_mem(1, 199, -1, 0, 4, disp, 0, n, 4))
end

fn lea_rip(a: unit, dest: i64, name: bytes) -> unit
  return emit_rip(a, rex_prefix(1, dest, 0) ++ byte(141) ++ byte(modrm(0, dest, 5)), name)
end

fn call_rip(a: unit, name: bytes) -> unit
  return emit_rip(a, byte(255) ++ byte(21), name)
end

fn call_label(a: unit, name: bytes) -> unit
  return emit_jump(a, byte(232), name)
end

fn jmp_label(a: unit, name: bytes) -> unit
  return emit_jump(a, byte(233), name)
end

fn jcc(a: unit, cc: i64, name: bytes) -> unit
  return emit_jump(a, byte(15) ++ byte(128 + cc else fail "math"), name)
end

fn jz(a: unit, name: bytes) -> unit
  return jcc(a, 4, name)
end

fn setcc(a: unit, cc: i64, reg: i64) -> unit
  return emit(a, rex_prefix(0, 0, reg) ++ byte(15) ++ byte(cc) ++ byte(modrm(3, 0, reg)))
end

fn je(a: unit, name: bytes) -> unit
  return jcc(a, 4, name)
end

fn jnz(a: unit, name: bytes) -> unit
  return jcc(a, 5, name)
end

fn jb(a: unit, name: bytes) -> unit
  return jcc(a, 2, name)
end

fn ja(a: unit, name: bytes) -> unit
  return jcc(a, 7, name)
end

fn jae(a: unit, name: bytes) -> unit
  return jcc(a, 3, name)
end

fn jo(a: unit, name: bytes) -> unit
  return jcc(a, 0, name)
end

fn jl(a: unit, name: bytes) -> unit
  return jcc(a, 12, name)
end

fn jg(a: unit, name: bytes) -> unit
  return jcc(a, 15, name)
end

fn jbe(a: unit, name: bytes) -> unit
  return jcc(a, 6, name)
end

fn align_size(src: unit, dest: i64) -> unit
  let a = src
  set a = xor_reg(a, 1, 1)
  set a = test_reg(a, dest, dest)
  set a = setcc(a, 148, 1)
  set a = add_reg(a, dest, 1)
  set a = add_reg_imm8(a, dest, 7)
  set a = and_reg_imm8(a, dest, 248)
  return a
end

