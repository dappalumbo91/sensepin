  set a = mov_reg_reg(a, 2, 12)
  set a = mov_reg_imm32(a, 8, 32)
  set a = call_label(a, "memcpy")
  set a = jmp_label(a, "dispatch")
  set a = label(a, "map_key_fail")
  set a = jmp_label(a, "fail_empty")
  return a
end

fn eqb(left: bytes, right: bytes) -> i64
  let n = len(left)
  if n != len(right)
    return 0
  end
  let i = 0
  let same = 1
  while i < n
    if at(left, i) != at(right, i)
      set same = 0
    end
    set i = i + 1 else fail "math"
  end
  return same
end

fn at_or(text: bytes, i: i64) -> i64
  if i < 0
    return -1
  end
  if i >= len(text)
    return -1
  end
  return at(text, i) else fail "byte"
end

fn is_letter(c: i64) -> i64
  if c >= 65
    if c <= 90
      return 1
    end
  end
  if c >= 97
    if c <= 122
      return 1
    end
  end
  return 0
end

fn is_digit(c: i64) -> i64
  if c >= 48
    if c <= 57
      return 1
    end
  end
  return 0
end

fn is_ident(c: i64) -> i64
  if is_letter(c)
    return 1
  end
  if is_digit(c)
    return 1
  end
  if c == 95
    return 1
  end
  return 0
end

fn read_ident(text: bytes, i: i64) -> step
  let j = i
  let n = len(text)
  let raw = ""
  let go = 1
  while go
    if j >= n
      set go = 0
    else
      let c = at_or(text, j)
      if is_ident(c)
        set raw = raw ++ byte(c)
        set j = j + 1 else fail "math"
      else
        set go = 0
      end
    end
  end
  return step(tok(1, 0, raw), j)
end

fn read_number(text: bytes, i: i64) -> step
  let j = i
  let n = len(text)
  let raw = ""
  let go = 1
  while go
    if j >= n
      set go = 0
    else
      let c = at_or(text, j)
      if is_digit(c)
        set raw = raw ++ byte(c)
        set j = j + 1 else fail "math"
      else
        set go = 0
      end
    end
  end
  let num = i64(raw) else fail "bad integer"
  return step(tok(2, num, raw), j)
end

fn read_string(text: bytes, i: i64) -> step
  let j = i + 1 else fail "math"
  let raw = ""
  let n = len(text)
  let closed = 0
  let go = 1
  while go
    if j >= n
      set go = 0
    else
      let c = at_or(text, j)
      if c == 34
        set j = j + 1 else fail "math"
        set closed = 1
        set go = 0
      else
        if c == 92
          let e = at_or(text, j + 1)
          let ch = 0
          if e == 110
            set ch = 10
          end
          if e == 92
            set ch = 92
          end
          if e == 34
            set ch = 34
          end
          if ch == 0
            fail "bad escape"
          end
          set raw = raw ++ byte(ch)
          set j = j + 2 else fail "math"
        else
          set raw = raw ++ byte(c)
          set j = j + 1 else fail "math"
        end
      end
    end
  end
  if closed == 0
    fail "unterminated string"
  end
  return step(tok(3, 0, raw), j)
end

fn pack_tok(kind: i64, start: i64, stop: i64) -> i64
  if start >= 65536
    fail "line"
  end
  if stop >= 65536
    fail "line"
  end
  let mid = stop * 65536 else fail "math"
  let hi = kind * 4294967296 else fail "math"
  let low = start + mid else fail "math"
  return low + hi else fail "math"
end

fn packed_kind(packed: i64) -> i64
  return packed / 4294967296 else fail "math"
end

fn packed_start(packed: i64) -> i64
  let block = packed / 65536 else fail "math"
  return packed - block * 65536 else fail "math"
end

fn packed_end(packed: i64) -> i64
  let block = packed / 65536 else fail "math"
  let kind = block / 65536 else fail "math"
  return block - kind * 65536 else fail "math"
end

fn skip_gap(text: bytes, i: i64) -> i64
  let j = i
  let n = len(text)
  let go = 1
  while go
    if j >= n
      set go = 0
    else
      let c = at_or(text, j)
      if c == 32
        set j = j + 1 else fail "math"
      else
        if c == 9
          set j = j + 1 else fail "math"
        else
          if c == 13
            set j = j + 1 else fail "math"
          else
            if c == 35
              set j = n
              set go = 0
            else
              set go = 0
            end
          end
        end
      end
    end
  end
  return j
end

fn scan_ident(text: bytes, i: i64) -> i64
  let j = i + 1 else fail "math"
  let n = len(text)
  let go = 1
  while go
    if j >= n
      set go = 0
    else
      if is_ident(at_or(text, j))
        set j = j + 1 else fail "math"
      else
        set go = 0
      end
    end
  end
  return j
end

fn scan_digits(text: bytes, i: i64) -> i64
  let j = i + 1 else fail "math"
  let n = len(text)
  let go = 1
  while go
    if j >= n
      set go = 0
    else
      if is_digit(at_or(text, j))
        set j = j + 1 else fail "math"
      else
        set go = 0
      end
    end
  end
  return j
end

fn scan_string(text: bytes, i: i64) -> i64
  let j = i + 1 else fail "math"
  let n = len(text)
  let closed = 0
  while closed == 0
    if j >= n
      fail "unterminated string"
    end
    let c = at_or(text, j)
    if c == 34
      set j = j + 1 else fail "math"
      set closed = 1
    else
      if c == 92
        let e = at_or(text, j + 1)
        let ch = 0
        if e == 110
          set ch = 10
        end
        if e == 92
          set ch = 92
        end
        if e == 34
          set ch = 34
        end
        if ch == 0
          fail "bad escape"
        end
        set j = j + 2 else fail "math"
      else
        set j = j + 1 else fail "math"
      end
    end
  end
  return j
end

fn min_end(text: bytes, i: i64) -> i64
  let minraw = "9223372036854775808"
  let minn = len(minraw)
  let k = 0
  let matched = 1
  while k < minn
    if at_or(text, i + 1 + k else fail "math") != at(minraw, k)
      set matched = 0
    end
    set k = k + 1 else fail "math"
  end
  if matched == 0
    return -1
  end
  if is_digit(at_or(text, i + 1 + minn else fail "math"))
    return -1
  end
  return i + 1 + minn else fail "math"
end

fn classify(text: bytes, i: i64) -> i64
  let c = at_or(text, i)
  if c == 34
    return pack_tok(3, i, scan_string(text, i))
  end
  if is_letter(c)
    return pack_tok(1, i, scan_ident(text, i))
  end
  if c == 95
    return pack_tok(1, i, scan_ident(text, i))
  end
  if is_digit(c)
    return pack_tok(2, i, scan_digits(text, i))
  end
  if c == 43
    if at_or(text, i + 1) == 43
      return pack_tok(5, i, i + 2 else fail "math")
    end
    return pack_tok(4, i, i + 1 else fail "math")
  end
  if c == 45
    if at_or(text, i + 1) == 62
      return pack_tok(10, i, i + 2 else fail "math")
    end
    let mend = min_end(text, i)
    if mend >= 0
      return pack_tok(2, i, mend)
    end
    return pack_tok(11, i, i + 1 else fail "math")
  end
  if c == 40
    return pack_tok(6, i, i + 1 else fail "math")
  end
  if c == 41
    return pack_tok(7, i, i + 1 else fail "math")
  end
  if c == 44
    return pack_tok(8, i, i + 1 else fail "math")
  end
  if c == 58
    return pack_tok(9, i, i + 1 else fail "math")
  end
  if c == 61
    if at_or(text, i + 1) == 61
      return pack_tok(13, i, i + 2 else fail "math")
    end
    return pack_tok(12, i, i + 1 else fail "math")
  end
  if c == 33
    if at_or(text, i + 1) != 61
      fail "bad character"
    end
    return pack_tok(14, i, i + 2 else fail "math")
  end
  if c == 60
    if at_or(text, i + 1) == 61
      return pack_tok(17, i, i + 2 else fail "math")
    end
    return pack_tok(15, i, i + 1 else fail "math")
  end
  if c == 62
    if at_or(text, i + 1) == 61
      return pack_tok(18, i, i + 2 else fail "math")
    end
    return pack_tok(16, i, i + 1 else fail "math")
  end
  if c == 46
    return pack_tok(19, i, i + 1 else fail "math")
  end
  if c == 47
    return pack_tok(20, i, i + 1 else fail "math")
  end
  if c == 42
    return pack_tok(21, i, i + 1 else fail "math")
  end
  fail "bad character"
  return 0
end

fn locate(text: bytes, index: i64) -> i64
  if index < 0
    fail "token"
  end
  let i = 0
  let n = len(text)
  let seen = 0
  while seen <= index
    set i = skip_gap(text, i)
    if i >= n
      fail "token"
    end
    let packed = classify(text, i)
    let stop = packed_end(packed)
    if stop <= i
      fail "token"
    end
    if seen == index
      return packed
    end
    set i = stop
    set seen = seen + 1 else fail "math"
  end
  fail "token"
  return 0
end

fn tok_kind(toks: toks, index: i64) -> i64
  if index < 0
    fail "token"
  end
  if index >= toks.count
    fail "token"
  end
  return packed_kind(locate(toks.raw, index))
end

fn tok_num(toks: toks, index: i64) -> i64
  if index < 0
    fail "token"
  end
  if index >= toks.count
    fail "token"
  end
  let packed = locate(toks.raw, index)
  if packed_kind(packed) != 2
    return 0
  end
  let start = packed_start(packed)
  let stop = packed_end(packed)
  let raw = span(toks.raw, start, stop - start else fail "math")
  return i64(raw) else fail "bad integer"
end

fn decode_string(text: bytes, i: i64) -> bytes
  let j = i + 1 else fail "math"
  let raw = ""
  let n = len(text)
  let closed = 0
  let go = 1
  while go
    if j >= n
      set go = 0
    else
      let c = at_or(text, j)
      if c == 34
        set j = j + 1 else fail "math"
        set closed = 1
        set go = 0
      else
        if c == 92
          let e = at_or(text, j + 1)
          let ch = 0
          if e == 110
            set ch = 10
          end
          if e == 92
            set ch = 92
          end
          if e == 34
            set ch = 34
          end
          if ch == 0
            fail "bad escape"
          end
          set raw = raw ++ byte(ch)
          set j = j + 2 else fail "math"
        else
          set raw = raw ++ byte(c)
          set j = j + 1 else fail "math"
        end
      end
    end
  end
  if closed == 0
    fail "unterminated string"
  end
  return raw
end

fn tok_text(toks: toks, index: i64) -> bytes
  if index < 0
    fail "token"
  end
  if index >= toks.count
    fail "token"
  end
  let packed = locate(toks.raw, index)
  let kind = packed_kind(packed)
  let start = packed_start(packed)
  let stop = packed_end(packed)
  if kind == 1
    return span(toks.raw, start, stop - start else fail "math")
  end
  if kind == 2
    return span(toks.raw, start, stop - start else fail "math")
  end
  if kind == 3
    return decode_string(toks.raw, start)
  end
  return ""
end

fn lex(text: bytes) -> toks
  let i = 0
  let n = len(text)
  let count = 0
  while i < n
    set i = skip_gap(text, i)
    if i < n
      let packed = classify(text, i)
      let stop = packed_end(packed)
      if stop <= i
        fail "token"
      end
      set i = stop
      set count = count + 1 else fail "math"
    end
  end
  return toks(text, count)
end
fn tok_is(toks: toks, pos: i64, kind: i64) -> i64
  if pos < 0
    return 0
  end
  if pos >= toks.count
    return 0
  end
  if tok_kind(toks, pos) == kind
    return 1
  end
  return 0
end

fn spawn(code: bytes, pool: bytes, nconst: i64, strs: buf, funcs: buf, jumps: buf, marks: buf, imap: bytes, bmap: buf, smap: buf, fnames: buf, arity: buf, slots: map bytes i64, unwind: bytes, main_off: i64, main_slots: i64, saw_main: i64, live: i64, start: i64, nparams: i64, is_main: i64, seen: i64, cbuf: buf, blocks: list block, failto: bytes, pbuf: buf, sname: map bytes i64, sfld: map bytes i64, nstruct: i64, building: bytes, nfield: i64, rets: buf) -> prog
  let pk = pack(code, pool, nconst, strs, funcs, imap, bmap, smap, fnames, arity, unwind, main_off, main_slots, saw_main, live, start, nparams, is_main, pbuf, sname, sfld, nstruct, building, nfield, rets)
  let held = cold(pk, marks, slots, seen, cbuf.parts, blocks, failto)
  return prog(cbuf.part, cbuf.fills, cbuf.count, jumps, held, cbuf.mid, cbuf.mfills)
end

fn with_code(p: prog, code: bytes) -> prog
  return spawn(code, p.cold.pack.pool, p.cold.pack.nconst, p.cold.pack.strs, p.cold.pack.funcs, p.jumps, p.cold.marks, p.cold.pack.imap, p.cold.pack.bmap, p.cold.pack.smap, p.cold.pack.fnames, p.cold.pack.arity, p.cold.slots, p.cold.pack.unwind, p.cold.pack.main_off, p.cold.pack.main_slots, p.cold.pack.saw_main, p.cold.pack.live, p.cold.pack.start, p.cold.pack.nparams, p.cold.pack.is_main, p.cold.seen, as_buf(p), p.cold.blocks, p.cold.failto, p.cold.pack.pbuf, p.cold.pack.sname, p.cold.pack.sfld, p.cold.pack.nstruct, p.cold.pack.building, p.cold.pack.nfield, p.cold.pack.rets)
end

