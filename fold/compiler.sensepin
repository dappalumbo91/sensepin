fn with_pool_b(p: prog, pbuf: buf, nconst: i64, strs: buf, bmap: bytes, smap: bytes) -> prog
  return spawn(p.cold.code, p.cold.pool, nconst, strs, p.cold.funcs, p.jumps, p.cold.marks, p.cold.imap, bmap, smap, p.cold.fnames, p.cold.arity, p.cold.slots, p.cold.unwind, p.cold.main_off, p.cold.main_slots, p.cold.saw_main, p.cold.live, p.cold.start, p.cold.nparams, p.cold.is_main, p.cold.seen, as_buf(p), p.cold.blocks, p.cold.failto, pbuf, p.cold.sname, p.cold.sfld, p.cold.nstruct, p.cold.building, p.cold.nfield, p.cold.rets)
