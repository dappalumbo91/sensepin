struct fixup
  slot: i64
  word: bytes
end

struct buf
  parts: list bytes
  part: bytes
  fills: i64
  count: i64
  mid: bytes
  mfills: i64
end

struct unit
  buf: buf
  marks: buf
  jumps: buf
  rips: buf
end

struct tok
  kind: i64
  num: i64
  text: bytes
end

struct step
  tok: tok
  pos: i64
end

struct toks
  raw: bytes
  count: i64
end

struct placed
  data: buf
  symbols: map bytes i64
  here: i64
end

struct block
  kind: i64
  alt: bytes
  done: bytes
end

struct pack
